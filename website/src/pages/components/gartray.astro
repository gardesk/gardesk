            <!-- doc-11: DND -->
            <div slot="doc-11">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Do Not Disturb</h3>
              <p class="text-gar-text-secondary mb-4">
                Toggles notification pause via dunst notification daemon.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">State</h4>
              <ul class="list-disc list-inside text-gar-text-secondary mb-4 space-y-1">
                <li><code class="text-gar-accent-green">enabled</code> - Whether DND is active</li>
                <li><code class="text-gar-accent-green">dunst_available</code> - Whether dunst is running</li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Commands</h4>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: 'dunstctl is-paused', comment: 'Query DND state (returns "true" or "false")' },
                  { command: 'dunstctl set-paused true', comment: 'Enable DND' },
                  { command: 'dunstctl set-paused false', comment: 'Disable DND' },
                ]}
                class="mb-4"
              />

              <div class="bg-gar-bg-secondary/50 border border-gar-accent-cyan/30 rounded-lg p-4 mb-4">
                <p class="text-gar-text-secondary text-sm">
                  <strong class="text-gar-accent-cyan">Note:</strong> If dunst is not available, gartray tracks DND state locally but cannot affect notifications.
                </p>
              </div>
            </div>

            <!-- doc-12: Configuration -->
            <div slot="doc-12">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Configuration</h3>
              <p class="text-gar-text-secondary mb-4">
                gartray is configured via TOML at <code class="text-gar-accent-green">~/.config/gartray/config.toml</code>.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">File Locations</h4>
              <ul class="list-disc list-inside text-gar-text-secondary mb-4 space-y-1">
                <li><code class="text-gar-accent-cyan">~/.config/gartray/config.toml</code> - Configuration file</li>
                <li><code class="text-gar-accent-cyan">$XDG_RUNTIME_DIR/gartray.pid</code> - PID file</li>
                <li><code class="text-gar-accent-cyan">$XDG_RUNTIME_DIR/gartray.sock</code> - IPC socket</li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Loading Behavior</h4>
              <p class="text-gar-text-secondary mb-4">
                Configuration is loaded at startup. If the file is missing, built-in defaults are used.
                Use <code class="text-gar-accent-green">gartrayctl reload</code> to reload configuration without restarting.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Custom Config Path</h4>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: 'gartray daemon --config /path/to/config.toml', comment: 'Use custom config' },
                ]}
                class="mb-4"
              />
            </div>

            <!-- doc-13: Integration (parent) -->
            <div slot="doc-13">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Integration</h3>
              <p class="text-gar-text-secondary mb-4">
                gartray can run standalone or integrate with other gardesk components.
                Select an integration mode from the sidebar to learn more.
              </p>
            </div>

            <!-- doc-14: Standalone -->
            <div slot="doc-14">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Standalone Mode</h3>
              <p class="text-gar-text-secondary mb-4">
                In standalone mode, gartray runs its own tray window and panel independently.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Starting the Daemon</h4>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: 'gartray daemon', comment: 'Start in foreground' },
                  { command: 'gartray daemon &', comment: 'Start in background' },
                ]}
                class="mb-4"
              />

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Autostart</h4>
              <p class="text-gar-text-secondary mb-4">
                Add gartray to your X11 startup script:
              </p>
              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-4">
                <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
                  <span class="text-sm text-gar-text-secondary font-mono">~/.xinitrc</span>
                </div>
                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`# Start gartray before window manager
gartray daemon &

# Start window manager
exec gar`}</code></pre>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Systemd User Service</h4>
              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-4">
                <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
                  <span class="text-sm text-gar-text-secondary font-mono">~/.config/systemd/user/gartray.service</span>
                </div>
                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`[Unit]
Description=gartray system tray
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/gartray daemon
Restart=on-failure

[Install]
WantedBy=graphical-session.target`}</code></pre>
              </div>
            </div>

            <!-- doc-15: garbar Integration -->
            <div slot="doc-15">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Integration with garbar</h3>
              <p class="text-gar-text-secondary mb-4">
                gartray works seamlessly with garbar in two ways:
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">1. garbar as Tray Manager</h4>
              <p class="text-gar-text-secondary mb-4">
                garbar has its own built-in tray module that implements the XEMBED protocol.
                In this mode, gartray's icons dock directly into garbar.
              </p>
              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
                <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
                  <span class="text-sm text-gar-text-secondary font-mono">garbar config (TOML)</span>
                </div>
                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`# Enable the tray module in garbar
modules_right = ["tray", "datetime"]

[modules.tray]
icon_size = 18
spacing = 8.0`}</code></pre>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">2. Quick Settings Panel Trigger</h4>
              <p class="text-gar-text-secondary mb-4">
                garbar can trigger gartray's quick settings panel via IPC:
              </p>
              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
                <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
                  <span class="text-sm text-gar-text-secondary font-mono">quick_settings module</span>
                </div>
                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`# garbar sends to gartray via Unix socket:
# /run/user/1000/gartray.sock (or /tmp/gartray.sock)
# {"command":"toggle","x":100,"y":200}`}</code></pre>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Typical Setup</h4>
              <ol class="list-decimal list-inside text-gar-text-secondary mb-4 space-y-2">
                <li>Start gartray daemon (handles panel and SNI icons)</li>
                <li>Start garbar with tray module (handles XEMBED icons)</li>
                <li>Configure garbar quick_settings to trigger gartray panel on click</li>
              </ol>

              <div class="bg-gar-bg-secondary/50 border border-gar-accent-cyan/30 rounded-lg p-4 mb-4">
                <p class="text-gar-text-secondary text-sm">
                  <strong class="text-gar-accent-cyan">Tip:</strong> garbar's tray module and gartray are complementary.
                  garbar handles the XEMBED icons in the bar, while gartray provides the quick settings panel.
                </p>
              </div>
            </div>

            <!-- doc-16: Rendering -->
            <div slot="doc-16">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Rendering</h3>
              <p class="text-gar-text-secondary mb-4">
                gartray uses Cairo for 2D graphics rendering with ARGB32 transparency support.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Icon Sources</h4>
              <p class="text-gar-text-secondary mb-2">Icons are loaded in priority order:</p>
              <ol class="list-decimal list-inside text-gar-text-secondary mb-4 space-y-1">
                <li><strong>Theme icons</strong> - Searched in icon theme directories</li>
                <li><strong>Pixmaps</strong> - ARGB32 data from SNI D-Bus properties</li>
                <li><strong>Placeholder</strong> - Fallback if no icon available</li>
              </ol>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Icon Theme Search Paths</h4>
              <ul class="list-disc list-inside text-gar-text-secondary mb-4 space-y-1">
                <li><code class="text-gar-accent-cyan">~/.local/share/icons</code></li>
                <li><code class="text-gar-accent-cyan">/usr/share/icons</code></li>
                <li><code class="text-gar-accent-cyan">/usr/share/pixmaps</code></li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Themes Searched</h4>
              <ul class="list-disc list-inside text-gar-text-secondary mb-4 space-y-1">
                <li>hicolor</li>
                <li>Adwaita</li>
                <li>breeze</li>
                <li>Papirus</li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Color Format Conversion</h4>
              <p class="text-gar-text-secondary mb-4">
                SNI icons use network byte order (big-endian ARGB), while Cairo uses native byte order (BGRA on little-endian systems):
              </p>
              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-4">
                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`D-Bus ARGB (big-endian):  A R G B
Cairo BGRA (native):      B G R A`}</code></pre>
              </div>
            </div>

          </DocsSidebar>
        </div>

        <!-- Workflows Tab -->
        <div slot="tab-3">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Common Workflows</h3>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Basic Usage</h4>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'gartray daemon &', comment: 'Start daemon in background' },
              { command: 'gartrayctl toggle', comment: 'Show/hide quick settings' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Position Panel at Cursor</h4>
          <p class="text-gar-text-secondary mb-4">
            Show the panel at a specific position (useful for keybinds):
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'gartrayctl show $(xdotool getmouselocation --shell | grep -E "^[XY]=" | cut -d= -f2 | tr "\\n" " ")', comment: 'Show at cursor position' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Keybind in gar</h4>
          <p class="text-gar-text-secondary mb-4">
            Add a keybind in your gar config to toggle the panel:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/gar/init.lua</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`-- Toggle gartray quick settings panel
gar.bind("Super+Shift+s", function()
    os.execute("gartrayctl toggle")
end)`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Volume Control Keybinds</h4>
          <p class="text-gar-text-secondary mb-4">
            Direct volume control without opening the panel:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+', comment: 'Volume up' },
              { command: 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-', comment: 'Volume down' },
              { command: 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle', comment: 'Toggle mute' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Brightness Control Keybinds</h4>
          <p class="text-gar-text-secondary mb-4">
            Direct brightness control:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'brightnessctl set +5%', comment: 'Brightness up' },
              { command: 'brightnessctl set 5%-', comment: 'Brightness down' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Reload Configuration</h4>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'gartrayctl reload', comment: 'Reload config without restart' },
              { command: 'pkill -HUP gartray', comment: 'Alternative: send SIGHUP' },
            ]}
            class="mb-6"
          />
        </div>

        <!-- IPC/API Tab -->
        <div slot="tab-4">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">IPC Protocol</h3>

          <p class="text-gar-text-secondary mb-6">
            gartray uses a Unix domain socket for IPC communication with gartrayctl.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Socket Location</h4>
          <p class="text-gar-text-secondary mb-4">
            The socket is created at <code class="text-gar-accent-green">$XDG_RUNTIME_DIR/gartray.sock</code> or <code class="text-gar-accent-green">/tmp/gartray.sock</code>.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Protocol Format</h4>
          <p class="text-gar-text-secondary mb-4">
            Messages are JSON objects, one per line (JSON Lines format).
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Commands</h4>
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary">Command</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary">JSON</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3 font-mono">show</td>
                  <td class="py-2 px-3 font-mono text-xs">{`{"command":"show","x":100,"y":200}`}</td>
                  <td class="py-2 px-3">Show panel at position</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3 font-mono">hide</td>
                  <td class="py-2 px-3 font-mono text-xs">{`{"command":"hide"}`}</td>
                  <td class="py-2 px-3">Hide panel</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3 font-mono">toggle</td>
                  <td class="py-2 px-3 font-mono text-xs">{`{"command":"toggle","x":100,"y":200}`}</td>
                  <td class="py-2 px-3">Toggle panel visibility</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3 font-mono">reload</td>
                  <td class="py-2 px-3 font-mono text-xs">{`{"command":"reload"}`}</td>
                  <td class="py-2 px-3">Reload configuration</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3 font-mono">status</td>
                  <td class="py-2 px-3 font-mono text-xs">{`{"command":"status"}`}</td>
                  <td class="py-2 px-3">Get daemon status</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3 font-mono">quit</td>
                  <td class="py-2 px-3 font-mono text-xs">{`{"command":"quit"}`}</td>
                  <td class="py-2 px-3">Stop daemon</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Response Format</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`// Success
{"success": true, "message": null, "data": null}

// Error
{"success": false, "message": "error description", "data": null}`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">gartrayctl Commands</h4>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'gartrayctl show [x] [y]', comment: 'Show panel at position' },
              { command: 'gartrayctl hide', comment: 'Hide panel' },
              { command: 'gartrayctl toggle [x] [y]', comment: 'Toggle panel' },
              { command: 'gartrayctl reload', comment: 'Reload config' },
              { command: 'gartrayctl status', comment: 'Get daemon status' },
              { command: 'gartrayctl quit', comment: 'Stop daemon' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Direct Socket Communication</h4>
          <p class="text-gar-text-secondary mb-4">
            You can communicate directly with the socket using standard tools:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'echo \'{"command":"toggle"}\' | socat - UNIX-CONNECT:$XDG_RUNTIME_DIR/gartray.sock', comment: 'Using socat' },
              { command: 'echo \'{"command":"status"}\' | nc -U $XDG_RUNTIME_DIR/gartray.sock', comment: 'Using netcat' },
            ]}
            class="mb-6"
          />
        </div>

        <!-- Troubleshooting Tab -->
        <div slot="tab-5">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Troubleshooting</h3>

          <div class="space-y-6">
            <div class="rounded-lg border border-gar-text-muted/20 p-4">
              <h4 class="text-lg font-semibold text-gar-text-primary mb-2">Tray icons not appearing</h4>
              <p class="text-gar-text-secondary mb-3">
                Check if gartray has acquired the system tray selection:
              </p>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: 'xprop -root | grep _NET_SYSTEM_TRAY', comment: 'Check tray selection' },
                  { command: 'gartrayctl status', comment: 'Check daemon status' },
                ]}
                class="mb-2"
              />
              <p class="text-gar-text-secondary text-sm">
                If another tray manager (like trayer or stalonetray) is running, stop it first.
              </p>
            </div>

            <div class="rounded-lg border border-gar-text-muted/20 p-4">
              <h4 class="text-lg font-semibold text-gar-text-primary mb-2">Volume control not working</h4>
              <p class="text-gar-text-secondary mb-3">
                Verify WirePlumber/PipeWire is running:
              </p>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: 'wpctl status', comment: 'Check WirePlumber status' },
                  { command: 'systemctl --user status pipewire wireplumber', comment: 'Check services' },
                ]}
                class="mb-2"
              />
            </div>

            <div class="rounded-lg border border-gar-text-muted/20 p-4">
              <h4 class="text-lg font-semibold text-gar-text-primary mb-2">Brightness control not working</h4>
              <p class="text-gar-text-secondary mb-3">
                Check backlight device and permissions:
              </p>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: 'ls /sys/class/backlight/', comment: 'List backlight devices' },
                  { command: 'cat /sys/class/backlight/*/brightness', comment: 'Check current brightness' },
                ]}
                class="mb-2"
              />
              <p class="text-gar-text-secondary text-sm">
                You may need to add your user to the <code class="text-gar-accent-green">video</code> group or create udev rules for write access.
              </p>
            </div>

            <div class="rounded-lg border border-gar-text-muted/20 p-4">
              <h4 class="text-lg font-semibold text-gar-text-primary mb-2">Network/Bluetooth not showing</h4>
              <p class="text-gar-text-secondary mb-3">
                Verify D-Bus services are running:
              </p>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: 'systemctl status NetworkManager', comment: 'Check NetworkManager' },
                  { command: 'systemctl status bluetooth', comment: 'Check BlueZ' },
                ]}
                class="mb-2"
              />
            </div>

            <div class="rounded-lg border border-gar-text-muted/20 p-4">
              <h4 class="text-lg font-semibold text-gar-text-primary mb-2">Power actions require password</h4>
              <p class="text-gar-text-secondary mb-3">
                Ensure polkit is configured for passwordless power actions:
              </p>
              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-2">
                <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
                  <span class="text-sm text-gar-text-secondary font-mono">/etc/polkit-1/rules.d/85-power.rules</span>
                </div>
                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.login1.power-off" ||
         action.id == "org.freedesktop.login1.reboot" ||
         action.id == "org.freedesktop.login1.suspend" ||
         action.id == "org.freedesktop.login1.hibernate") &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});`}</code></pre>
              </div>
            </div>

            <div class="rounded-lg border border-gar-text-muted/20 p-4">
              <h4 class="text-lg font-semibold text-gar-text-primary mb-2">Daemon already running</h4>
              <p class="text-gar-text-secondary mb-3">
                Check for existing daemon and stop it:
              </p>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: 'cat $XDG_RUNTIME_DIR/gartray.pid', comment: 'Check PID file' },
                  { command: 'gartrayctl quit', comment: 'Stop existing daemon' },
                  { command: 'pkill gartray', comment: 'Force stop if needed' },
                ]}
                class="mb-2"
              />
            </div>

            <div class="rounded-lg border border-gar-text-muted/20 p-4">
              <h4 class="text-lg font-semibold text-gar-text-primary mb-2">Debug logging</h4>
              <p class="text-gar-text-secondary mb-3">
                Enable debug output to diagnose issues:
              </p>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: 'RUST_LOG=debug gartray daemon', comment: 'Run with debug logging' },
                  { command: 'RUST_LOG=gartray=trace gartray daemon', comment: 'Trace-level logging' },
                ]}
                class="mb-2"
              />
            </div>
          </div>
        </div>

      </TabbedCard>

      <!-- Back Link -->
      <div class="mt-12 pt-8 border-t border-gar-text-muted/10">
        <Button href="/" variant="ghost">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to home
        </Button>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
