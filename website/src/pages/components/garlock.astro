---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ImageCarousel from '../../components/ui/ImageCarousel.astro';
import TabbedCard from '../../components/ui/TabbedCard.astro';
import MultiTerminal from '../../components/ui/MultiTerminal.astro';
import DocsSidebar from '../../components/ui/DocsSidebar.astro';

const garlockImages = [
  { src: '/images/garlock1.png', alt: 'garlock screen locker - locked state' },
];

const tabs = [
  { id: 'getting-started', label: 'Getting Started' },
  { id: 'config', label: 'Config' },
  { id: 'docs', label: 'Docs' },
  { id: 'workflows', label: 'Workflows' },
  { id: 'ipc', label: 'IPC/API' },
  { id: 'troubleshooting', label: 'Troubleshooting' },
];

const docsItems = [
  {
    id: 'overview',
    label: 'Overview',
  },
  {
    id: 'authentication',
    label: 'Authentication',
    children: [
      { id: 'auth-pam', label: 'PAM Integration' },
      { id: 'auth-security', label: 'Security' },
      { id: 'auth-cooldown', label: 'Cooldown System' },
    ]
  },
  {
    id: 'ring-indicator',
    label: 'Ring Indicator',
    children: [
      { id: 'ring-states', label: 'Visual States' },
      { id: 'ring-customization', label: 'Customization' },
    ]
  },
  {
    id: 'background',
    label: 'Background',
    children: [
      { id: 'background-blur', label: 'Blur Effect' },
      { id: 'background-brightness', label: 'Brightness' },
    ]
  },
  {
    id: 'overlays',
    label: 'Text Overlays',
  },
  {
    id: 'keyboard',
    label: 'Keyboard Input',
  },
  {
    id: 'monitors',
    label: 'Multi-Monitor',
  },
  {
    id: 'daemon-mode',
    label: 'Daemon Mode',
  },
];
---

<BaseLayout title="garlock - gardesk" description="Screen Locker. A secure PAM-authenticated screen locker with Cairo/Pango rendering and visual feedback.">
  <Header />

  <main class="pt-24 pb-20 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Hero -->
      <div class="mb-12">
        <Badge status="stable" class="mb-4" />
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <span class="text-gar-accent-green">garlock</span>
        </h1>
        <p class="text-xl text-gar-text-secondary mb-6">Screen Locker</p>
        <p class="text-gar-text-secondary leading-relaxed mb-8">
          A secure PAM-authenticated screen locker with blurred screenshot backgrounds and visual ring feedback. garlock provides comprehensive input protection with keyboard/pointer grabs and secure password handling using memory zeroing.
        </p>

        <div class="flex flex-wrap gap-4">
          <Button href="https://github.com/gardesk/garlock" variant="primary">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </Button>
          <Button href="/#install" variant="secondary">
            Install
          </Button>
        </div>
      </div>

      <!-- Screenshots -->
      <div class="mb-12">
        <ImageCarousel images={garlockImages} />
      </div>

      <!-- Features Grid -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            'PAM authentication with configurable service',
            'Secure password handling with zeroize memory clearing',
            'Blurred screenshot background for privacy',
            'Animated ring indicator with 5 visual states',
            'Multi-monitor support via RandR',
            'Caps Lock and failed attempt warnings',
            'Configurable cooldown after failed attempts',
            'Daemon mode with IPC socket control',
            'Time display with strftime formatting',
            'Full Unicode password input support',
            'Keyboard and pointer grab for security',
            'TOML configuration at ~/.config/garlock/config.toml',
          ].map(function(feature) {
            return (
              <li class="flex items-start gap-3 p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/10">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-gar-accent-green" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gar-text-primary">{feature}</span>
              </li>
            )
          })}
        </ul>
      </section>

      <!-- Security Features -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Security Model</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-accent-green/20">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-gar-accent-green" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <h3 class="font-semibold text-gar-text-primary">Memory Security</h3>
            </div>
            <p class="text-sm text-gar-text-secondary">Passwords zeroed from memory using zeroize crate. No password remnants after authentication.</p>
          </div>
          <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-accent-green/20">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-gar-accent-green" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <h3 class="font-semibold text-gar-text-primary">Input Grabbing</h3>
            </div>
            <p class="text-sm text-gar-text-secondary">X11 keyboard and mouse grabbed. No input reaches other applications during lock.</p>
          </div>
          <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-accent-green/20">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-gar-accent-green" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
              </svg>
              <h3 class="font-semibold text-gar-text-primary">PAM Integration</h3>
            </div>
            <p class="text-sm text-gar-text-secondary">Uses system PAM stack. Same authentication as system login, supports 2FA and custom modules.</p>
          </div>
        </div>
      </section>

      <!-- Tabbed Documentation Card -->
      <TabbedCard tabs={tabs} defaultTab="getting-started" class="mb-12">

        <!-- Getting Started Tab -->
        <div slot="tab-0">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Quick Start Guide</h3>

          <p class="text-gar-text-secondary mb-6">
            Get garlock installed and configured for secure screen locking.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">1. Installation</h4>
          <p class="text-gar-text-secondary mb-4">
            Install garlock using the unified installer or build from source:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'curl -fsSL https://gar.dev/install.sh | bash -s -- --component=garlock', comment: 'Install via script' },
              { command: 'cd ~/.local/src/gardesk/garlock && cargo build --release', comment: 'Or build from source' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">2. PAM Configuration</h4>
          <p class="text-gar-text-secondary mb-4">
            Create a PAM service file for garlock (requires root):
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">/etc/pam.d/garlock</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`#%PAM-1.0
# PAM configuration for garlock screen locker

auth required pam_unix.so`}</code></pre>
          </div>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'sudo tee /etc/pam.d/garlock << "EOF"\n#%PAM-1.0\nauth required pam_unix.so\nEOF', comment: 'Create PAM service file' },
              { command: 'sudo chmod 644 /etc/pam.d/garlock', comment: 'Set permissions' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">3. Running garlock</h4>
          <p class="text-gar-text-secondary mb-4">
            Lock your screen directly or run in daemon mode:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'garlock', comment: 'Lock screen directly' },
              { command: 'garlock lock', comment: 'Explicit lock command' },
              { command: 'garlock daemon &', comment: 'Start daemon mode' },
              { command: 'garlock lock', comment: 'Lock via daemon' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">4. Integration with gar</h4>
          <p class="text-gar-text-secondary mb-4">
            Bind a key in gar to lock the screen:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/gar/init.lua</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`-- Lock screen with Super+L
gar.bind("mod+l", "exec garlock")

-- Or lock via shell command
gar.bind("mod+l", function()
    gar.exec("garlock lock")
end)`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">5. Configuration</h4>
          <p class="text-gar-text-secondary mb-4">
            Create a configuration file at <code class="text-gar-accent-green">~/.config/garlock/config.toml</code>:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'mkdir -p ~/.config/garlock', comment: 'Create config directory' },
              { command: '$EDITOR ~/.config/garlock/config.toml', comment: 'Edit configuration' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">6. Testing</h4>
          <p class="text-gar-text-secondary mb-4">
            Test garlock safely with Xephyr:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'Xephyr :1 -screen 1920x1080 &', comment: 'Start nested X server' },
              { command: 'DISPLAY=:1 garlock', comment: 'Test garlock in Xephyr' },
            ]}
          />
          <div class="p-3 rounded-lg bg-gar-accent-orange/10 border border-gar-accent-orange/20 mt-4">
            <p class="text-gar-text-secondary text-sm">
              <strong>Warning:</strong> When testing on your main display, ensure you have TTY access (Ctrl+Alt+F2) as a backup in case of issues.
            </p>
          </div>
        </div>

        <!-- Config Tab -->
        <div slot="tab-1">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Configuration Reference</h3>

          <p class="text-gar-text-secondary mb-6">
            garlock uses TOML configuration at <code class="text-gar-accent-green">~/.config/garlock/config.toml</code>.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Minimal Configuration</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/garlock/config.toml</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`[background]
blur_radius = 25.0
brightness = 0.6

[indicator]
show_time = true
time_format = "%H:%M"`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Full Configuration Example</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/garlock/config.toml</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto max-h-[36rem]"><code class="text-sm text-gar-text-primary font-mono">{`# ═══════════════════════════════════════════
# General Settings
# ═══════════════════════════════════════════

[general]
grace_period = 0              # Seconds before password required (0 = disabled)
pam_service = "garlock"       # PAM service name (must match /etc/pam.d/garlock)
max_attempts = 3              # Failed attempts before cooldown starts
cooldown_seconds = 5          # Base cooldown duration (multiplied by excess attempts)

# ═══════════════════════════════════════════
# Background Settings
# ═══════════════════════════════════════════

[background]
blur_radius = 25.0            # Gaussian blur radius (0 = disabled, higher = more blur)
brightness = 0.6              # Brightness factor (0.0 = black, 1.0 = original)
fallback_color = "#1a1a2e"    # Solid color if screenshot capture fails

# ═══════════════════════════════════════════
# Ring Indicator
# ═══════════════════════════════════════════

[ring]
# Ring geometry
radius_outer = 90.0           # Outer ring radius in pixels
radius_inner = 75.0           # Inner circle radius
line_width = 6.0              # Ring stroke width

# State colors (hex with optional alpha: #RRGGBB or #RRGGBBAA)
color_idle = "#1e90ffcc"      # Blue: waiting for input
color_typing = "#00ff00cc"    # Green: receiving password
color_verifying = "#ffa500cc" # Orange: checking with PAM
color_wrong = "#ff0000cc"     # Red: authentication failed
color_clear = "#ffff00cc"     # Yellow: backspace/clear

# Background colors
color_inside = "#00000088"    # Inner circle fill (dark transparent)
color_ring_bg = "#00000055"   # Ring background track

# ═══════════════════════════════════════════
# Text Overlays
# ═══════════════════════════════════════════

[indicator]
# Caps Lock warning
show_caps_lock = true         # Display "Caps Lock" when active
caps_lock_text = "Caps Lock"  # Custom warning text

# Failed attempts
show_failed_attempts = true   # Display failed attempt count

# Time display
show_time = true              # Display current time above ring
time_format = "%H:%M"         # strftime format (24-hour default)

# ═══════════════════════════════════════════
# Font Settings
# ═══════════════════════════════════════════

[font]
family = "Sans"               # Font family (Pango format)
size = 14                     # Font size in points`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Configuration Options Reference</h4>

          <h5 class="text-md font-medium text-gar-text-primary mb-2 mt-6">General Options</h5>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Option</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Type</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Default</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">grace_period</td><td class="py-2 px-3">u32</td><td class="py-2 px-3">0</td><td class="py-2 px-3">Seconds before password required</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">pam_service</td><td class="py-2 px-3">string</td><td class="py-2 px-3">"garlock"</td><td class="py-2 px-3">PAM service name</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">max_attempts</td><td class="py-2 px-3">u32</td><td class="py-2 px-3">3</td><td class="py-2 px-3">Failed attempts before cooldown</td></tr>
                <tr><td class="py-2 px-3 font-mono text-xs">cooldown_seconds</td><td class="py-2 px-3">u32</td><td class="py-2 px-3">5</td><td class="py-2 px-3">Base cooldown duration (multiplied)</td></tr>
              </tbody>
            </table>
          </div>

          <h5 class="text-md font-medium text-gar-text-primary mb-2 mt-6">Background Options</h5>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Option</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Type</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Default</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">blur_radius</td><td class="py-2 px-3">f32</td><td class="py-2 px-3">25.0</td><td class="py-2 px-3">Gaussian blur amount (0 = disabled)</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">brightness</td><td class="py-2 px-3">f32</td><td class="py-2 px-3">0.6</td><td class="py-2 px-3">Brightness multiplier (0.0-1.0)</td></tr>
                <tr><td class="py-2 px-3 font-mono text-xs">fallback_color</td><td class="py-2 px-3">hex</td><td class="py-2 px-3">#1a1a2e</td><td class="py-2 px-3">Solid color if screenshot fails</td></tr>
              </tbody>
            </table>
          </div>

          <h5 class="text-md font-medium text-gar-text-primary mb-2 mt-6">Ring Options</h5>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Option</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Type</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Default</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">radius_outer</td><td class="py-2 px-3">f64</td><td class="py-2 px-3">90.0</td><td class="py-2 px-3">Outer ring radius (pixels)</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">radius_inner</td><td class="py-2 px-3">f64</td><td class="py-2 px-3">75.0</td><td class="py-2 px-3">Inner circle radius</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">line_width</td><td class="py-2 px-3">f64</td><td class="py-2 px-3">6.0</td><td class="py-2 px-3">Ring stroke width</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">color_idle</td><td class="py-2 px-3">hex</td><td class="py-2 px-3">#1e90ffcc</td><td class="py-2 px-3">Waiting for input (blue)</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">color_typing</td><td class="py-2 px-3">hex</td><td class="py-2 px-3">#00ff00cc</td><td class="py-2 px-3">Receiving password (green)</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">color_verifying</td><td class="py-2 px-3">hex</td><td class="py-2 px-3">#ffa500cc</td><td class="py-2 px-3">PAM check in progress (orange)</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">color_wrong</td><td class="py-2 px-3">hex</td><td class="py-2 px-3">#ff0000cc</td><td class="py-2 px-3">Authentication failed (red)</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">color_clear</td><td class="py-2 px-3">hex</td><td class="py-2 px-3">#ffff00cc</td><td class="py-2 px-3">Backspace/clear (yellow)</td></tr>
