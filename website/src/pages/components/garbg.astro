              <span class="text-sm text-gar-text-secondary font-mono">~/.config/garbg/config.toml</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`# Primary monitor - landscape photos
[[monitors]]
name = "DP-1"
source = "~/Pictures/landscapes"
mode = "fill"

[monitors.slideshow]
enabled = true
interval = "10m"
shuffle = true

# Secondary monitor - static wallpaper
[[monitors]]
name = "HDMI-1"
source = "~/Pictures/secondary-static.png"
mode = "fit"`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Time-Based Wallpapers</h4>
          <p class="text-gar-text-secondary mb-4">
            Use cron to change wallpapers based on time of day:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">crontab -e</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`# Morning wallpaper (6 AM)
0 6 * * * DISPLAY=:0 garbg set ~/Pictures/morning.png

# Afternoon wallpaper (12 PM)
0 12 * * * DISPLAY=:0 garbg set ~/Pictures/afternoon.png

# Evening wallpaper (6 PM)
0 18 * * * DISPLAY=:0 garbg set ~/Pictures/evening.png

# Night wallpaper (10 PM)
0 22 * * * DISPLAY=:0 garbg set ~/Pictures/night.png`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Animated Desktop</h4>
          <p class="text-gar-text-secondary mb-4">
            Set an animated GIF or WebP as your wallpaper:
          </p>
          <MultiTerminal
            commands={[
              { command: 'garbg set ~/animated/chill.gif --animate --max-fps 30', comment: 'Play at 30 FPS' },
              { command: 'garbg pause', comment: 'Pause to save resources' },
              { command: 'garbg resume', comment: 'Resume playback' },
            ]}
          />
        </div>

        <!-- IPC Tab -->
        <div slot="tab-4">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">IPC Protocol</h3>

          <p class="text-gar-text-secondary mb-6">
            garbg exposes a Unix domain socket for inter-process communication. Use CLI commands or send JSON directly.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Socket Location</h4>
          <MultiTerminal
            commands={[
              { command: 'echo $XDG_RUNTIME_DIR/garbg.sock', comment: 'Primary socket path' },
              { command: 'ls -la ${XDG_RUNTIME_DIR:-/tmp}/garbg.sock', comment: 'Check socket exists' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Command Reference</h4>
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Command</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Set</td><td class="py-2 px-3">Set wallpaper from source</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">SetWorkspace</td><td class="py-2 px-3">Set wallpaper for specific workspace</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">SetMonitor</td><td class="py-2 px-3">Set wallpaper for specific monitor</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Next</td><td class="py-2 px-3">Advance to next wallpaper</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Prev</td><td class="py-2 px-3">Go to previous wallpaper</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Random</td><td class="py-2 px-3">Jump to random wallpaper</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Reload</td><td class="py-2 px-3">Reload configuration</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Pause</td><td class="py-2 px-3">Pause animations/slideshow</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Resume</td><td class="py-2 px-3">Resume playback</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Toggle</td><td class="py-2 px-3">Toggle pause state</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Status</td><td class="py-2 px-3">Get current status</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">List</td><td class="py-2 px-3">List images from source</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">ClearCache</td><td class="py-2 px-3">Clear disk cache</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-magenta">QueryMonitors</td><td class="py-2 px-3">Query connected monitors</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-magenta">QueryCurrent</td><td class="py-2 px-3">Query current wallpaper info</td></tr>
                <tr><td class="py-2 px-3 font-mono text-gar-accent-magenta">Subscribe</td><td class="py-2 px-3">Subscribe to events</td></tr>
              </tbody>
            </table>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">JSON Protocol</h4>
          <p class="text-gar-text-secondary mb-4">
            Send JSON objects over the socket for scripting:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">Request examples</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`// Set wallpaper
{"Set": {"source": "~/Pictures/bg.png", "mode": "Fill", "shuffle": false, "animate": false, "max_fps": 60}}

// Navigate playlist
{"Next": {"monitor": null}}
{"Prev": {"monitor": null}}

// Control playback
{"Pause": null}
{"Resume": null}
{"Toggle": null}

// Query state
{"Status": null}
{"QueryMonitors": null}
{"QueryCurrent": null}

// List source
{"List": {"source": "~/Pictures"}}`}</code></pre>
          </div>

          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">Response format</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`// Success
{"success": true, "data": null}

// Success with data
{"success": true, "data": {
  "source": "~/Pictures",
  "current_index": 5,
  "total": 42,
  "paused": false
}}

// Error
{"success": false, "error": "Daemon not running"}`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Event Types</h4>
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Event</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">WallpaperChanged</td><td class="py-2 px-3">Wallpaper changed on a monitor</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">SourceUpdated</td><td class="py-2 px-3">Source playlist updated</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">AnimationState</td><td class="py-2 px-3">Animation paused/resumed</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-xs">SlideshowAdvanced</td><td class="py-2 px-3">Slideshow moved to next image</td></tr>
                <tr><td class="py-2 px-3 font-mono text-xs">Error</td><td class="py-2 px-3">Error occurred</td></tr>
              </tbody>
            </table>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Scripting Example</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">current-wallpaper.sh</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`#!/bin/bash
# Get current wallpaper info
SOCK="\${XDG_RUNTIME_DIR:-/tmp}/garbg.sock"

echo '{"QueryCurrent": null}' | nc -U "$SOCK" | jq -r '.data.source'`}</code></pre>
          </div>
        </div>

        <!-- Troubleshooting Tab -->
        <div slot="tab-5">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Troubleshooting</h3>

          <div class="space-y-6">
            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Wallpaper not appearing</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify DISPLAY is set and X11 is running:</p>
              <MultiTerminal
                commands={[
                  { command: 'echo $DISPLAY', comment: 'Should show :0 or similar' },
                  { command: 'xdpyinfo | head -5', comment: 'Test X11 connection' },
                  { command: 'DISPLAY=:0 garbg set ~/bg.png', comment: 'Explicitly set DISPLAY' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Daemon not running</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check if daemon is running and socket exists:</p>
              <MultiTerminal
                commands={[
                  { command: 'pgrep -x garbg', comment: 'Check if process is running' },
                  { command: 'ls -la ${XDG_RUNTIME_DIR:-/tmp}/garbg.*', comment: 'Check socket and PID files' },
                  { command: 'garbg daemon -d', comment: 'Start daemon in background' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Images not loading from remote source</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check network and cache:</p>
              <MultiTerminal
                commands={[
                  { command: 'curl -I https://example.com/image.png', comment: 'Test network access' },
                  { command: 'garbg -v set https://example.com/image.png', comment: 'Run with verbose logging' },
                  { command: 'rm -rf ~/.cache/garbg/*', comment: 'Clear cache if corrupted' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">GitHub rate limited</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Set a personal access token for higher limits:</p>
              <MultiTerminal
                commands={[
                  { command: 'export GITHUB_TOKEN="ghp_xxxxxxxxxxxx"', comment: 'Set token' },
                  { command: 'garbg set github://owner/repo/path', comment: 'Try again' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Create a token at <code class="text-gar-accent-magenta">github.com/settings/tokens</code> (no scopes needed for public repos).
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Animation stuttering</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Reduce FPS or check system resources:</p>
              <MultiTerminal
                commands={[
                  { command: 'garbg set ~/animated.gif -a --max-fps 30', comment: 'Lower FPS cap' },
                  { command: 'top -p $(pgrep garbg)', comment: 'Check CPU usage' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Try smaller GIFs or reduce screen resolution for better performance.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Video wallpapers not working</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Ensure garbg was built with video support:</p>
              <MultiTerminal
                commands={[
                  { command: 'cargo build --release --features video', comment: 'Build with video support' },
                  { command: 'ffmpeg -version', comment: 'Check ffmpeg is installed' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Configuration not loading</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Validate TOML syntax:</p>
              <MultiTerminal
                commands={[
                  { command: 'cat ~/.config/garbg/config.toml | tomlv', comment: 'Validate with tomlv' },
                  { command: 'garbg -v daemon', comment: 'Check for parse errors in verbose mode' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Multi-monitor not working</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check monitor names match exactly:</p>
              <MultiTerminal
                commands={[
                  { command: 'xrandr --query | grep " connected"', comment: 'Get exact monitor names' },
                  { command: 'garbg query monitors', comment: 'Query garbg monitor detection' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Monitor names in config must match xrandr output exactly (e.g., "DP-1", "HDMI-1").
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Enable debug logging</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Get detailed output for debugging:</p>
              <MultiTerminal
                commands={[
                  { command: 'garbg -v set ~/bg.png', comment: 'Verbose flag' },
                  { command: 'RUST_LOG=garbg=debug garbg daemon', comment: 'Full debug logging' },
                ]}
              />
            </div>
          </div>
        </div>
      </TabbedCard>

      <!-- Back link -->
      <div class="mt-12 pt-8 border-t border-gar-text-muted/10">
        <Button href="/" variant="ghost">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to home
        </Button>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
