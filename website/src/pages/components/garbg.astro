name = "DP-1"
source = "~/Pictures/primary"
mode = "fill"

[monitors.slideshow]
enabled = true
interval = "15m"

[[monitors]]
name = "HDMI-1"
source = "~/Pictures/secondary"
mode = "fit"`}</code></pre>
