enabled = true
interval = "10m"
shuffle = true`}</code></pre>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Slideshow Controls</h4>
              <MultiTerminal
                commands={[
                  { command: 'garbg next', comment: 'Skip to next wallpaper' },
                  { command: 'garbg prev', comment: 'Go to previous' },
                  { command: 'garbg pause', comment: 'Pause slideshow' },
                  { command: 'garbg resume', comment: 'Resume slideshow' },
                  { command: 'garbg toggle', comment: 'Toggle pause state' },
                ]}
              />

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3 mt-6">Shuffle Behavior</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1">
                <li>Images shuffled when playlist created with <code class="text-gar-accent-magenta">-r</code> flag</li>
                <li>Re-shuffle applied on wrap-around (after last image)</li>
                <li>Playlist state persists across daemon restarts</li>
              </ul>
