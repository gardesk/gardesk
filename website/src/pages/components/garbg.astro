            <!-- Caching -->
            <div slot="doc-13">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Caching System</h3>
              <p class="text-gar-text-secondary mb-4">
                garbg uses an intelligent LRU disk cache for remote images with blake3 hashing.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Cache Features</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-4">
                <li>LRU eviction when size limit exceeded</li>
                <li>blake3 hashing of URIs for cache keys</li>
                <li>Subdirectory sharding for performance</li>
                <li>ETag support for conditional HTTP requests</li>
                <li>Automatic expiry based on max_age_days</li>
              </ul>

              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`# Cache configuration
[cache]
directory = "~/.cache/garbg"  # Default location
max_size_mb = 1024            # 1 GB max
max_age_days = 30             # Expire after 30 days`}</code></pre>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Cache Management</h4>
              <MultiTerminal
                commands={[
                  { command: 'ls -la ~/.cache/garbg/', comment: 'View cache directory' },
                  { command: 'du -sh ~/.cache/garbg/', comment: 'Check cache size' },
                  { command: 'rm -rf ~/.cache/garbg/*', comment: 'Clear cache manually' },
                ]}
              />
            </div>

