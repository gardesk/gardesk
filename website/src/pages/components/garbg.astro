                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3">GitHub</td><td class="py-2 px-3 font-mono text-xs">github://owner/repo/path</td></tr>
                    <tr><td class="py-2 px-3">S3</td><td class="py-2 px-3 font-mono text-xs">s3://bucket/prefix</td></tr>
