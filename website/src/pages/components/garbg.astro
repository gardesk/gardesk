            <!-- Slideshow -->
            <div slot="doc-11">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Slideshow Mode</h3>
              <p class="text-gar-text-secondary mb-4">
                Automatically rotate through wallpapers at configurable intervals.
              </p>

              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`# Command line slideshow
garbg set ~/Pictures -r --interval 5m
garbg set ~/Pictures --interval 30s --random

# Duration format (humantime)
# "30s" - 30 seconds
# "5m"  - 5 minutes
# "1h"  - 1 hour
# "1h30m" - 1 hour 30 minutes

# Config file
