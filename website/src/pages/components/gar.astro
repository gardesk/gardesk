-- Float specific windows
gar.rule({ class = "Pavucontrol" }, { floating = true })
gar.rule({ title = "File Upload" }, { floating = true })

-- Assign to workspaces
gar.rule({ class = "Firefox" }, { workspace = 2 })
gar.rule({ class = "Spotify" }, { workspace = 9, floating = true })

-- Match by instance
gar.rule({ instance = "dialog" }, { floating = true })`}</code></pre>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Match Criteria</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-4">
