                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`gar.picom_rule({
    match = "class_g = 'Firefox'",
    corner_radius = 0,
    opacity = 1.0,
    shadow = false,
    blur_background = true,
    shader = "~/.config/gar/shaders/focused-glow.glsl"
})`}</code></pre>
              </div>
