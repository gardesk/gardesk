        <div slot="tab-4">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">IPC Protocol</h3>

          <p class="text-gar-text-secondary mb-6">
            gar exposes two IPC sockets: a native JSON socket and an i3-compatible binary socket.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Socket Locations</h4>
          <MultiTerminal
            commands={[
              { command: 'echo $XDG_RUNTIME_DIR/gar.sock', comment: 'Native JSON socket' },
              { command: 'echo $I3SOCK', comment: 'i3-compatible socket' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">garctl Commands</h4>
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Command</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Arguments</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">focus</td><td class="py-2 px-3">left|right|up|down</td><td class="py-2 px-3">Focus window in direction</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">swap</td><td class="py-2 px-3">left|right|up|down</td><td class="py-2 px-3">Swap windows</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">resize</td><td class="py-2 px-3">direction [amount]</td><td class="py-2 px-3">Resize split</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">workspace</td><td class="py-2 px-3">1-10</td><td class="py-2 px-3">Switch workspace</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">move_to_workspace</td><td class="py-2 px-3">1-10</td><td class="py-2 px-3">Move window</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">close</td><td class="py-2 px-3">-</td><td class="py-2 px-3">Close focused window</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">toggle_floating</td><td class="py-2 px-3">-</td><td class="py-2 px-3">Toggle floating state</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">equalize</td><td class="py-2 px-3">-</td><td class="py-2 px-3">Equalize splits</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">reload</td><td class="py-2 px-3">-</td><td class="py-2 px-3">Reload config</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">exit</td><td class="py-2 px-3">-</td><td class="py-2 px-3">Exit gar</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-blue">get_workspaces</td><td class="py-2 px-3">-</td><td class="py-2 px-3">Query workspaces</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-blue">get_focused</td><td class="py-2 px-3">-</td><td class="py-2 px-3">Query focused window</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-blue">get_tree</td><td class="py-2 px-3">-</td><td class="py-2 px-3">Query window tree</td></tr>
                <tr><td class="py-2 px-3 font-mono text-gar-accent-blue">get_monitors</td><td class="py-2 px-3">-</td><td class="py-2 px-3">Query monitors</td></tr>
              </tbody>
            </table>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">JSON Protocol</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">Request format</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`{"command": "focus", "args": {"direction": "left"}}
{"command": "workspace", "args": {"number": 3}}
{"command": "resize", "args": {"direction": "right", "amount": 0.05}}
{"command": "get_workspaces"}`}</code></pre>
          </div>

          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">Response format</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`// Success
{"success": true, "data": null}

// Success with data
{"success": true, "data": [
  {"id": 1, "name": "1", "focused": true, "tiled_count": 2}
]}

// Error
{"success": false, "error": "No focused window"}`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">i3-Compatible IPC</h4>
          <p class="text-gar-text-secondary mb-4">
            The i3 socket supports polybar and other i3 ecosystem tools:
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Type</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono">GET_WORKSPACES</td><td class="py-2 px-3">Returns workspace array</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono">GET_OUTPUTS</td><td class="py-2 px-3">Returns monitor info</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono">SUBSCRIBE</td><td class="py-2 px-3">Subscribe to events</td></tr>
                <tr><td class="py-2 px-3 font-mono">GET_VERSION</td><td class="py-2 px-3">Returns WM version</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Troubleshooting Tab -->
        <div slot="tab-5">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Troubleshooting</h3>

          <div class="space-y-6">
            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">gar won't start</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check the log file for errors:</p>
              <MultiTerminal
                commands={[
                  { command: 'cat /tmp/gar.log', comment: 'View gar log' },
                  { command: 'GAR_LOG=debug gar', comment: 'Run with debug logging' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Keybindings not working</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify your config loads without errors:</p>
              <MultiTerminal
                commands={[
                  { command: 'lua ~/.config/gar/init.lua', comment: 'Check Lua syntax' },
                  { command: 'xev | grep -A2 KeyPress', comment: 'Verify key names' },
                  { command: 'garctl reload', comment: 'Reload after fixing' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Windows not tiling correctly</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Some apps set incorrect window types:</p>
              <MultiTerminal
                commands={[
                  { command: 'xprop | grep WM_CLASS', comment: 'Get window class (click window)' },
                  { command: 'xprop | grep _NET_WM_WINDOW_TYPE', comment: 'Check window type' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Add a window rule to force tiling or floating.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">garctl: connection refused</h4>
              <p class="text-gar-text-secondary text-sm mb-3">The IPC socket may not exist:</p>
              <MultiTerminal
                commands={[
                  { command: 'ls -la ${XDG_RUNTIME_DIR:-/tmp}/gar.sock', comment: 'Check socket exists' },
                  { command: 'pgrep -x gar', comment: 'Verify gar is running' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Picom effects not working</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check picom is running with the right config:</p>
              <MultiTerminal
                commands={[
                  { command: 'pgrep -x picom', comment: 'Check if picom is running' },
                  { command: 'picom --config ~/.config/gar/picom.conf --diagnostics', comment: 'Test picom config' },
                  { command: 'glxinfo | grep "direct rendering"', comment: 'Check GPU support' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Testing in Xephyr</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Test safely without replacing your current WM:</p>
              <MultiTerminal
                commands={[
                  { command: 'Xephyr :1 -screen 1920x1080 &', comment: 'Start nested X server' },
                  { command: 'DISPLAY=:1 gar', comment: 'Run gar in Xephyr' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Use <code class="text-gar-accent-blue">alt</code> as modifier in Xephyr to avoid conflicts.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Multi-monitor issues</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify monitor configuration:</p>
              <MultiTerminal
                commands={[
                  { command: 'xrandr --query', comment: 'List monitors' },
                  { command: 'garctl get_monitors', comment: 'Query gar monitor state' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Configure monitors with <code class="text-gar-accent-blue">xrandr</code> or <code class="text-gar-accent-blue">arandr</code> before starting gar.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">garbar not appearing</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check if gar.bar is configured:</p>
              <MultiTerminal
                commands={[
                  { command: 'grep "gar.bar" ~/.config/gar/init.lua', comment: 'Check for gar.bar table' },
                  { command: 'pgrep -x garbar', comment: 'Check if garbar is running' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Add <code class="text-gar-accent-blue">gar.bar = {"{}"}</code> to your config or run <code class="text-gar-accent-blue">gar.exec_once("garbar")</code>.
              </p>
            </div>
          </div>
        </div>
      </TabbedCard>

