                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">gar.force_close_window</td><td class="py-2 px-3">Force kill window</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">gar.toggle_floating</td><td class="py-2 px-3">Toggle floating state</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">gar.toggle_fullscreen</td><td class="py-2 px-3">Toggle fullscreen</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">gar.equalize</td><td class="py-2 px-3">Reset all splits to 50/50</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">gar.cycle_floating</td><td class="py-2 px-3">Cycle through floating windows</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">gar.reload</td><td class="py-2 px-3">Reload configuration</td></tr>
                    <tr><td class="py-2 px-3 font-mono text-gar-accent-green">gar.exit</td><td class="py-2 px-3">Exit gar</td></tr>
