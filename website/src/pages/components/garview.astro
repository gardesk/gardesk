---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import TabbedCard from '../../components/ui/TabbedCard.astro';
import MultiTerminal from '../../components/ui/MultiTerminal.astro';
import DocsSidebar from '../../components/ui/DocsSidebar.astro';
import ImageCarousel from '../../components/ui/ImageCarousel.astro';

const garviewImages = [
  { src: '/images/garview1.png', alt: 'garview PDF annotation mode with drawing tools on a W-9 form' },
  { src: '/images/garview2.png', alt: 'garview PDF viewer with sidebar showing table of contents' },
  { src: '/images/garview3.png', alt: 'garview PDF document with sidebar navigation and table of contents' },
  { src: '/images/garview4.png', alt: 'garview gallery mode with thumbnail grid of images' },
];

const tabs = [
  { id: 'getting-started', label: 'Getting Started' },
  { id: 'config', label: 'Config' },
  { id: 'docs', label: 'Docs' },
  { id: 'ipc', label: 'IPC/API' },
  { id: 'troubleshooting', label: 'Troubleshooting' },
];

const docsItems = [
  {
    id: 'overview',
    label: 'Overview',
  },
  {
    id: 'navigation',
    label: 'Navigation',
    children: [
      { id: 'zoom', label: 'Zoom Controls' },
      { id: 'pan', label: 'Pan & Scroll' },
      { id: 'pages', label: 'Page Navigation' },
    ]
  },
  {
    id: 'formats',
    label: 'Format Support',
    children: [
      { id: 'raster', label: 'Raster Images' },
      { id: 'svg', label: 'SVG/SVGZ' },
      { id: 'pdf', label: 'PDF Documents' },
      { id: 'comics', label: 'Comics (CBZ/CB7)' },
      { id: 'ebooks', label: 'eBooks (EPUB/MOBI)' },
    ]
  },
  {
    id: 'annotations',
    label: 'Annotations',
    children: [
      { id: 'annotation-tools', label: 'Drawing Tools' },
      { id: 'annotation-colors', label: 'Colors & Styles' },
      { id: 'annotation-persistence', label: 'Saving & Loading' },
    ]
  },
  {
    id: 'print-export',
    label: 'Print & Export',
  },
  {
    id: 'gallery',
    label: 'Gallery Mode',
  },
  {
    id: 'slideshow',
    label: 'Slideshow',
  },
  {
    id: 'pdf-features',
    label: 'PDF Features',
    children: [
      { id: 'search', label: 'Text Search' },
      { id: 'selection', label: 'Text Selection' },
      { id: 'forms', label: 'Form Fields' },
      { id: 'toc', label: 'Table of Contents' },
    ]
  },
  {
    id: 'sidebar-ui',
    label: 'Sidebar & UI',
  },
  {
    id: 'keyboard-shortcuts',
    label: 'Keyboard Shortcuts',
  },
];
---

<BaseLayout title="garview - gardesk" description="Multi-format image and document viewer with annotations for the gar desktop environment.">
  <Header />

  <main class="pt-24 pb-20 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Hero -->
      <div class="mb-12">
        <Badge status="beta" class="mb-4" />
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <span class="text-gar-accent-cyan">garview</span>
        </h1>
        <p class="text-xl text-gar-text-secondary mb-6">Image & Document Viewer</p>
        <p class="text-gar-text-secondary leading-relaxed mb-8">
          A multi-format image and document viewer with annotation tools, PDF text search, form fields, and print/export support. View images, PDFs, comics, and eBooks with session persistence and IPC control.
        </p>

        <div class="flex flex-wrap gap-4">
          <Button href="https://github.com/gardesk/garview" variant="primary">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </Button>
          <Button href="/#install" variant="secondary">
            Install
          </Button>
        </div>
      </div>

      <!-- Screenshots -->
      <div class="mb-12">
        <ImageCarousel images={garviewImages} />
      </div>

      <!-- Features Grid -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            '8 annotation tools with undo/redo history',
            'PDF with text search, selection, and form fields',
            'Print via CUPS and export to PNG/JPEG',
            'Comics (CBZ, CB7, CBT) and eBooks (EPUB, MOBI)',
            'Raster images: PNG, JPEG, GIF, WebP, AVIF, TIFF',
            'SVG/SVGZ vector graphics with resvg',
            'Animated GIF and APNG playback',
            'Zoom: fit, fill, 100%, custom (5-2000%)',
            'Gallery mode with thumbnail grid',
            'Slideshow with configurable interval',
            'Session persistence (zoom, page, position)',
            'IPC control via garviewctl'
          ].map(function(feature) {
            return (
              <li class="flex items-start gap-3 p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/10">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-gar-accent-cyan" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gar-text-primary">{feature}</span>
              </li>
            )
          })}
        </ul>
      </section>

      <!-- Tabbed Documentation Card -->
      <TabbedCard tabs={tabs} defaultTab="getting-started" class="mb-12">

        <!-- Tab 0: Getting Started -->
        <div slot="tab-0">
          <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Quick Start</h2>

          <div class="bg-gar-bg-secondary/50 rounded-lg p-6 mb-8 border border-gar-accent-cyan/20">
            <h3 class="text-lg font-semibold text-gar-accent-cyan mb-4">What is garview?</h3>
            <p class="text-gar-text-secondary mb-4">
              garview is a feature-rich image and document viewer for the gardesk desktop environment. It handles raster images, SVG, PDF, comics, and eBooks with annotation tools, print support, and session persistence.
            </p>
            <p class="text-gar-text-secondary">
              Control garview remotely via <code class="bg-gar-bg-secondary px-1 rounded">garviewctl</code> for scripting and automation.
            </p>
          </div>

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Installation</h3>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: "curl -fsSL https://gar.musicsian.com/install.sh | bash -s -- --component=garview", comment: "Install via script" },
              { command: "cd ~/.local/src/gardesk/garview && cargo build --release", comment: "Or build from source" },
            ]}
            class="mb-6"
          />

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Basic Usage</h3>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: "garview", comment: "Open with recent files panel" },
              { command: "garview /path/to/image.png", comment: "Open specific image" },
              { command: "garview /path/to/document.pdf", comment: "Open PDF document" },
              { command: "garview /path/to/comic.cbz", comment: "Open comic archive" },
              { command: "garview /path/to/directory/", comment: "Open directory in gallery mode" },
            ]}
            class="mb-6"
          />

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Command-Line Options</h3>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: "garview --fullscreen /path/to/image", comment: "Start in fullscreen" },
              { command: "garview --slideshow /path/to/directory", comment: "Start slideshow of directory" },
              { command: "garview --help", comment: "Show all options" },
            ]}
            class="mb-6"
          />

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Quick Reference</h3>
          <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
            <table class="w-full text-sm">
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 w-32"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Ctrl+A</code></td>
                  <td class="py-2">Enter annotation mode</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Ctrl+P</code></td>
                  <td class="py-2">Print current document</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Ctrl+E</code></td>
                  <td class="py-2">Export as PNG/JPEG</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">F7</code></td>
                  <td class="py-2">Toggle sidebar</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Tab</code></td>
                  <td class="py-2">Toggle gallery mode</td>
                </tr>
                <tr>
                  <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">q</code></td>
                  <td class="py-2">Quit</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab 1: Config -->
        <div slot="tab-1">
          <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Configuration</h2>

          <p class="text-gar-text-secondary mb-6">
            garview is configured via TOML at <code class="bg-gar-bg-secondary px-1 rounded">~/.config/garview/config.toml</code>.
          </p>

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Full Configuration Example</h3>
          <MultiTerminal
            title="~/.config/garview/config.toml"
            commands={[
              { command: "[general]", comment: "General settings" },
              { command: 'default_zoom = "fit"', comment: "fit, fill, 1:1, or 100%" },
              { command: "remember_position = false", comment: "Restore scroll position" },
              { command: "remember_zoom = false", comment: "Restore zoom level" },
              { command: 'background_color = "#1a1b26"', comment: "Window background" },
              { command: "", comment: "" },
              { command: "[images]", comment: "Image settings" },
              { command: "auto_rotate_exif = true", comment: "Auto-rotate by EXIF" },
              { command: 'interpolation = "lanczos"', comment: "lanczos, nearest, linear" },
            ]}
            class="mb-6"
          />

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">General Settings</h3>
          <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10 mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 text-gar-text-primary">Option</th>
                  <th class="text-left py-2 text-gar-text-primary">Default</th>
                  <th class="text-left py-2 text-gar-text-primary">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2"><code>default_zoom</code></td>
                  <td class="py-2">"fit"</td>
                  <td class="py-2">Initial zoom mode: fit, fill, 1:1, or 100%</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2"><code>remember_position</code></td>
                  <td class="py-2">false</td>
                  <td class="py-2">Restore scroll position when reopening files</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2"><code>remember_zoom</code></td>
                  <td class="py-2">false</td>
                  <td class="py-2">Restore zoom level when reopening files</td>
                </tr>
                <tr>
                  <td class="py-2"><code>background_color</code></td>
                  <td class="py-2">"#1a1b26"</td>
                  <td class="py-2">Background color (hex or CSS color)</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Image Settings</h3>
          <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10 mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 text-gar-text-primary">Option</th>
                  <th class="text-left py-2 text-gar-text-primary">Default</th>
                  <th class="text-left py-2 text-gar-text-primary">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2"><code>auto_rotate_exif</code></td>
                  <td class="py-2">true</td>
                  <td class="py-2">Auto-rotate based on EXIF orientation tag</td>
                </tr>
                <tr>
                  <td class="py-2"><code>interpolation</code></td>
                  <td class="py-2">"lanczos"</td>
                  <td class="py-2">Scaling filter: lanczos, nearest, linear</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Data Locations</h3>
          <MultiTerminal
            title="paths"
            commands={[
              { command: "~/.config/garview/config.toml", comment: "Configuration file" },
              { command: "~/.local/share/garview/recent.json", comment: "Recent files & session state" },
              { command: "~/.cache/garview/thumbnails/", comment: "Thumbnail cache" },
              { command: "$XDG_RUNTIME_DIR/garview.sock", comment: "IPC socket" },
            ]}
          />
        </div>

        <!-- Tab 2: Docs -->
        <div slot="tab-2">
          <DocsSidebar items={docsItems} defaultItem="overview">

            <!-- doc-0: Overview -->
            <div slot="doc-0">
              <h2 class="text-2xl font-bold text-gar-text-primary mb-4">Overview</h2>
              <p class="text-gar-text-secondary mb-4">
                garview is a unified viewer for images, documents, comics, and eBooks:
              </p>
              <ul class="space-y-3 text-gar-text-secondary mb-6">
                <li><strong class="text-gar-accent-cyan">Image viewing</strong> - Raster images (25+ formats), SVG, and animated GIF/APNG</li>
                <li><strong class="text-gar-accent-cyan">Document viewing</strong> - PDF with text search, selection, form fields, and TOC</li>
                <li><strong class="text-gar-accent-cyan">Comics</strong> - CBZ, CB7, CBT archive formats</li>
                <li><strong class="text-gar-accent-cyan">eBooks</strong> - EPUB and MOBI format support</li>
                <li><strong class="text-gar-accent-cyan">Annotations</strong> - 8 drawing tools with sidecar persistence</li>
                <li><strong class="text-gar-accent-cyan">Print & Export</strong> - Print via CUPS, export to PNG/JPEG</li>
              </ul>

              <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Binaries</h3>
              <ul class="space-y-1 text-gar-text-secondary text-sm">
                <li>• <code class="bg-gar-bg-secondary px-1 rounded">garview</code> - Main viewer application</li>
                <li>• <code class="bg-gar-bg-secondary px-1 rounded">garviewctl</code> - IPC control client</li>
              </ul>
            </div>

            <!-- doc-1: Navigation (parent) -->
            <div slot="doc-1">
              <h2 class="text-2xl font-bold text-gar-text-primary mb-4">Navigation</h2>
              <p class="text-gar-text-secondary mb-4">
                garview provides comprehensive navigation controls. Select a topic from the sidebar.
              </p>
              <div class="grid grid-cols-3 gap-4">
                <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
                  <h4 class="font-semibold text-gar-accent-cyan mb-2">Zoom</h4>
                  <p class="text-gar-text-secondary text-sm">5% to 2000% with multiple modes</p>
                </div>
                <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
                  <h4 class="font-semibold text-gar-accent-cyan mb-2">Pan</h4>
                  <p class="text-gar-text-secondary text-sm">Click-drag or keyboard panning</p>
                </div>
                <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
                  <h4 class="font-semibold text-gar-accent-cyan mb-2">Pages</h4>
                  <p class="text-gar-text-secondary text-sm">Multi-page navigation</p>
                </div>
              </div>
            </div>

            <!-- doc-2: Zoom Controls -->
            <div slot="doc-2">
              <h2 class="text-2xl font-bold text-gar-text-primary mb-4">Zoom Controls</h2>
              <p class="text-gar-text-secondary mb-4">
                garview supports zoom levels from 5% to 2000%:
              </p>

              <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Zoom Modes</h3>
              <ul class="space-y-2 text-gar-text-secondary mb-6">
                <li>• <strong>Fit</strong> (<code class="bg-gar-bg-secondary px-1 rounded">f</code>) - Entire image fits in viewport</li>
                <li>• <strong>Fill</strong> (<code class="bg-gar-bg-secondary px-1 rounded">Shift+F</code>) - Image fills viewport (may crop)</li>
                <li>• <strong>100%</strong> (<code class="bg-gar-bg-secondary px-1 rounded">0</code> or <code class="bg-gar-bg-secondary px-1 rounded">Ctrl+Z</code>) - Native pixel resolution</li>
              </ul>

              <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Keyboard Controls</h3>
              <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
                <table class="w-full text-sm">
                  <tbody class="text-gar-text-secondary">
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2 w-24"><code class="bg-gar-bg-secondary px-2 py-1 rounded">+</code> / <code class="bg-gar-bg-secondary px-2 py-1 rounded">=</code></td>
                      <td class="py-2">Zoom in</td>
                    </tr>
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">-</code></td>
                      <td class="py-2">Zoom out</td>
                    </tr>
                    <tr>
                      <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Ctrl+Scroll</code></td>
                      <td class="py-2">Zoom at mouse position</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- doc-3: Pan & Scroll -->
            <div slot="doc-3">
              <h2 class="text-2xl font-bold text-gar-text-primary mb-4">Pan & Scroll</h2>
              <ul class="space-y-2 text-gar-text-secondary mb-6">
                <li>• <strong>Click and drag</strong> - Pan with mouse</li>
                <li>• <strong>Arrow keys</strong> - Pan when zoomed in</li>
                <li>• <strong>Scroll wheel</strong> - Vertical scroll (horizontal with Shift)</li>
                <li>• <strong>Vim keys</strong> - <code class="bg-gar-bg-secondary px-1 rounded">h/j/k/l</code> for navigation</li>
              </ul>
              <p class="text-gar-text-secondary">
                Scrolling past an edge transitions to the previous/next image or page.
              </p>
            </div>

            <!-- doc-4: Page Navigation -->
            <div slot="doc-4">
              <h2 class="text-2xl font-bold text-gar-text-primary mb-4">Page Navigation</h2>
              <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
                <table class="w-full text-sm">
                  <tbody class="text-gar-text-secondary">
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2 w-32"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Right</code> / <code class="bg-gar-bg-secondary px-2 py-1 rounded">n</code></td>
                      <td class="py-2">Next page</td>
                    </tr>
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Left</code> / <code class="bg-gar-bg-secondary px-2 py-1 rounded">p</code></td>
                      <td class="py-2">Previous page</td>
                    </tr>
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Home</code> / <code class="bg-gar-bg-secondary px-2 py-1 rounded">End</code></td>
                      <td class="py-2">First / last page</td>
                    </tr>
                    <tr>
                      <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Ctrl+G</code></td>
                      <td class="py-2">Go to page dialog</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- doc-5: Format Support (parent) -->
            <div slot="doc-5">
              <h2 class="text-2xl font-bold text-gar-text-primary mb-4">Format Support</h2>
              <p class="text-gar-text-secondary mb-4">
                garview supports a wide range of formats through specialized backends:
              </p>
              <div class="grid grid-cols-2 gap-4">
                <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
                  <h4 class="font-semibold text-gar-accent-cyan mb-2">Raster Images</h4>
                  <p class="text-gar-text-secondary text-sm">PNG, JPEG, GIF, WebP, TIFF, BMP, AVIF, QOI, TGA, DDS, EXR</p>
                </div>
                <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
                  <h4 class="font-semibold text-gar-accent-cyan mb-2">Vector & Docs</h4>
                  <p class="text-gar-text-secondary text-sm">SVG, SVGZ, PDF</p>
                </div>
                <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
                  <h4 class="font-semibold text-gar-accent-cyan mb-2">Comics</h4>
                  <p class="text-gar-text-secondary text-sm">CBZ (zip), CB7 (7z), CBT (tar)</p>
                </div>
                <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
                  <h4 class="font-semibold text-gar-accent-cyan mb-2">eBooks</h4>
