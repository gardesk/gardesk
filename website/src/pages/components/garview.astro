                      <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Ctrl+Z/Y</code></td>
                      <td class="py-2">Undo/redo</td>
                    </tr>
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Ctrl+S</code></td>
                      <td class="py-2">Save annotations</td>
                    </tr>
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Ctrl+E</code></td>
                      <td class="py-2">Export annotated</td>
                    </tr>
                    <tr>
                      <td class="py-2"><code class="bg-gar-bg-secondary px-2 py-1 rounded">Escape</code></td>
                      <td class="py-2">Exit annotation mode</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

          </DocsSidebar>
        </div>

        <!-- Tab 3: IPC/API -->
        <div slot="tab-3">
          <h2 class="text-2xl font-bold text-gar-text-primary mb-6">IPC Protocol</h2>

          <p class="text-gar-text-secondary mb-6">
            garview exposes an IPC interface via Unix socket. Use <code class="bg-gar-bg-secondary px-1 rounded">garviewctl</code> for command-line control.
          </p>

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Socket Location</h3>
          <MultiTerminal
            title="socket"
            commands={[
              { command: "$XDG_RUNTIME_DIR/garview.sock", comment: "Default location" },
            ]}
            class="mb-6"
          />

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">garviewctl Commands</h3>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: "garviewctl open /path/to/file", comment: "Open file in running instance" },
              { command: "garviewctl next", comment: "Next page/image" },
              { command: "garviewctl prev", comment: "Previous page/image" },
              { command: "garviewctl first", comment: "First page" },
              { command: "garviewctl last", comment: "Last page" },
              { command: "garviewctl goto 5", comment: "Go to page 5" },
              { command: "garviewctl zoom-in", comment: "Zoom in" },
              { command: "garviewctl zoom-out", comment: "Zoom out" },
              { command: "garviewctl zoom-fit", comment: "Fit to window" },
              { command: "garviewctl zoom-set 150", comment: "Set zoom to 150%" },
              { command: "garviewctl rotate-cw", comment: "Rotate clockwise" },
              { command: "garviewctl rotate-ccw", comment: "Rotate counter-clockwise" },
              { command: "garviewctl flip-h", comment: "Flip horizontal" },
              { command: "garviewctl flip-v", comment: "Flip vertical" },
              { command: "garviewctl fullscreen", comment: "Toggle fullscreen" },
              { command: "garviewctl sidebar", comment: "Toggle sidebar" },
              { command: "garviewctl slideshow-start", comment: "Start slideshow" },
              { command: "garviewctl slideshow-stop", comment: "Stop slideshow" },
              { command: "garviewctl slideshow-interval 5", comment: "Set interval to 5 seconds" },
              { command: "garviewctl info", comment: "Get viewer state" },
              { command: "garviewctl ping", comment: "Check if running" },
              { command: "garviewctl quit", comment: "Quit viewer" },
            ]}
            class="mb-6"
          />

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Info Response</h3>
          <p class="text-gar-text-secondary mb-4">
            The <code class="bg-gar-bg-secondary px-1 rounded">info</code> command returns:
          </p>
          <MultiTerminal
            title="json"
            commands={[
              { command: "{", comment: "" },
              { command: '  "pid": 12345,', comment: "Process ID" },
              { command: '  "file": "/path/to/current.pdf",', comment: "Current file" },
              { command: '  "page": 5,', comment: "Current page (1-indexed)" },
              { command: '  "page_count": 24,', comment: "Total pages" },
              { command: '  "zoom": 150.0,', comment: "Zoom percentage" },
              { command: '  "dimensions": [1920, 1080],', comment: "Image dimensions" },
              { command: '  "fullscreen": false,', comment: "Fullscreen state" },
              { command: '  "slideshow": false', comment: "Slideshow state" },
              { command: "}", comment: "" },
            ]}
          />
        </div>

        <!-- Tab 4: Troubleshooting -->
        <div slot="tab-4">
          <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Troubleshooting</h2>

          <div class="space-y-6">
            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-cyan mb-2">PDF rendering errors</h3>
              <p class="text-gar-text-secondary mb-3">
                PDF support requires poppler library.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Install: <code class="bg-gar-bg-secondary px-1 rounded">dnf install poppler-devel</code> or <code class="bg-gar-bg-secondary px-1 rounded">apt install libpoppler-dev</code></li>
                <li>• Some corrupted PDFs may cause issues</li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-cyan mb-2">Annotations not saving</h3>
              <p class="text-gar-text-secondary mb-3">
                Check file permissions for sidecar files.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Sidecar files are saved alongside the original</li>
                <li>• Ensure write permission to the directory</li>
                <li>• Use <code class="bg-gar-bg-secondary px-1 rounded">Ctrl+S</code> to manually save</li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-cyan mb-2">Print not working</h3>
              <p class="text-gar-text-secondary mb-3">
                Printing requires CUPS and the <code class="bg-gar-bg-secondary px-1 rounded">lpr</code> command.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Install CUPS: <code class="bg-gar-bg-secondary px-1 rounded">dnf install cups</code></li>
                <li>• Ensure a printer is configured</li>
                <li>• Test with: <code class="bg-gar-bg-secondary px-1 rounded">lpstat -p</code></li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-cyan mb-2">garviewctl: connection refused</h3>
              <p class="text-gar-text-secondary mb-3">
                garview must be running for IPC to work.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Start garview first: <code class="bg-gar-bg-secondary px-1 rounded">garview &</code></li>
                <li>• Check socket: <code class="bg-gar-bg-secondary px-1 rounded">ls $XDG_RUNTIME_DIR/garview.sock</code></li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-cyan mb-2">Debug logging</h3>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: "RUST_LOG=debug garview /path/to/file", comment: "Full debug" },
                  { command: "RUST_LOG=garview=debug garview /path/to/file", comment: "garview only" },
                ]}
              />
            </div>
          </div>
        </div>

      </TabbedCard>
    </div>
  </main>

  <Footer />
</BaseLayout>
