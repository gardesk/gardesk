---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ImageCarousel from '../../components/ui/ImageCarousel.astro';
import TabbedCard from '../../components/ui/TabbedCard.astro';
import MultiTerminal from '../../components/ui/MultiTerminal.astro';
import DocsSidebar from '../../components/ui/DocsSidebar.astro';

const garfieldImages = [
  { src: '/images/garfield1.png', alt: 'garfield file manager - list view' },
  { src: '/images/garfield2.png', alt: 'garfield file manager - grid view' },
  { src: '/images/garfield3.png', alt: 'garfield file manager - column view' },
  { src: '/images/garfield4.png', alt: 'garfield file manager - split panes' },
  { src: '/images/garfield5.png', alt: 'garfield file manager - conflict dialog' },
  { src: '/images/garfield6.png', alt: 'garfield file manager - bookmarks sidebar' },
  { src: '/images/garfield7.png', alt: 'garfield file manager - help modal' },
];

const tabs = [
  { id: 'getting-started', label: 'Getting Started' },
  { id: 'config', label: 'Config' },
  { id: 'docs', label: 'Docs' },
  { id: 'workflows', label: 'Workflows' },
  { id: 'ipc', label: 'IPC/API' },
  { id: 'troubleshooting', label: 'Troubleshooting' },
];

const docsItems = [
  {
    id: 'overview',
    label: 'Overview',
  },
  {
    id: 'view-modes',
    label: 'View Modes',
    children: [
      { id: 'list-view', label: 'List View' },
      { id: 'grid-view', label: 'Grid View' },
      { id: 'column-view', label: 'Column View' },
    ]
  },
  {
    id: 'navigation',
    label: 'Navigation',
    children: [
      { id: 'keyboard-nav', label: 'Keyboard' },
      { id: 'history', label: 'History' },
    ]
  },
  {
    id: 'tabs-panes',
    label: 'Tabs & Panes',
    children: [
      { id: 'tabs', label: 'Tabs' },
      { id: 'panes', label: 'Split Panes' },
    ]
  },
  {
    id: 'file-ops',
    label: 'File Operations',
    children: [
      { id: 'copy-cut-paste', label: 'Copy/Cut/Paste' },
      { id: 'trash-delete', label: 'Trash & Delete' },
      { id: 'rename', label: 'Rename' },
      { id: 'new-folder', label: 'New Folder' },
    ]
  },
  {
    id: 'selection',
    label: 'Selection',
  },
  {
    id: 'undo-redo',
    label: 'Undo/Redo',
  },
  {
    id: 'bookmarks',
    label: 'Bookmarks',
  },
  {
    id: 'sidebar',
    label: 'Sidebar',
  },
  {
    id: 'conflicts',
    label: 'Conflict Resolution',
  },
];
---

<BaseLayout title="garfield - gardesk" description="File Manager. A multi-paned graphical file manager with tabbed navigation, multiple view modes, and full file operations.">
  <Header />

  <main class="pt-24 pb-20 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Hero -->
      <div class="mb-12">
        <Badge status="beta" class="mb-4" />
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <span class="text-gar-accent-orange">garfield</span>
        </h1>
        <p class="text-xl text-gar-text-secondary mb-6">File Manager</p>
        <p class="text-gar-text-secondary leading-relaxed mb-8">
          A multi-paned graphical file manager with tabbed navigation, multiple view modes, and full file operations. garfield features list, grid, and column views, split-pane layouts, undo/redo history, Freedesktop trash support, and IPC control via garfieldctl.
        </p>

        <div class="flex flex-wrap gap-4">
          <Button href="https://github.com/gardesk/garfield" variant="primary">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </Button>
          <Button href="/#install" variant="secondary">
            Install
          </Button>
        </div>
      </div>

      <!-- Screenshots -->
      <div class="mb-12">
        <ImageCarousel images={garfieldImages} />
      </div>

      <!-- Features Grid -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            'List, grid, and column view modes',
            'Multi-tab navigation with keyboard shortcuts',
            'Horizontal and vertical split panes',
            'Copy, cut, paste with conflict resolution',
            'Freedesktop trash support with metadata',
            'Undo/redo for all file operations (100 levels)',
            'Inline rename with cursor editing',
            'Bookmarks sidebar with drag-and-drop',
            'XDG places (Home, Desktop, Documents, Downloads)',
            'Built-in help modal (F1)',
            'IPC control via garfieldctl',
            'Address bar for direct path editing'
          ].map(function(feature) {
            return (
              <li class="flex items-start gap-3 p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/10">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-gar-accent-orange" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gar-text-primary">{feature}</span>
              </li>
            )
          })}
        </ul>
      </section>

      <!-- Tabbed Documentation Card -->
      <TabbedCard tabs={tabs} defaultTab="getting-started" class="mb-12">

        <!-- Getting Started Tab -->
        <div slot="tab-0">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Quick Start Guide</h3>

          <p class="text-gar-text-secondary mb-6">
            Get up and running with garfield in a few steps. This guide covers installation, launching, and essential keybindings.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">1. Installation</h4>
          <p class="text-gar-text-secondary mb-4">
            Install garfield using the unified installer or build from source:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'curl -fsSL https://gar.musicsian.com/install.sh | bash -s -- --component=garfield', comment: 'Install via script' },
              { command: 'cd ~/.local/src/gardesk/garfield && cargo build --release', comment: 'Or build from source' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">2. Launch</h4>
          <p class="text-gar-text-secondary mb-4">
            Run garfield from a terminal or application launcher:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'garfield', comment: 'Open home directory' },
              { command: 'garfield /path/to/directory', comment: 'Open specific directory' },
              { command: 'garfield ~/Documents', comment: 'Example: open Documents' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">3. Essential Keybindings</h4>
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Key</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Action</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Up/Down or k/j</td><td class="py-2 px-3">Navigate files</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Enter</td><td class="py-2 px-3">Open file/directory</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Backspace</td><td class="py-2 px-3">Go to parent directory</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Ctrl+C / Ctrl+X</td><td class="py-2 px-3">Copy / Cut</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Ctrl+V</td><td class="py-2 px-3">Paste</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Delete</td><td class="py-2 px-3">Move to trash</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">F2</td><td class="py-2 px-3">Rename</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Ctrl+T</td><td class="py-2 px-3">New tab</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Ctrl+1/2/3</td><td class="py-2 px-3">List/Grid/Column view</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Ctrl+Z / Ctrl+Y</td><td class="py-2 px-3">Undo / Redo</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">F1</td><td class="py-2 px-3">Show help</td></tr>
                <tr><td class="py-2 px-3 font-mono text-gar-accent-green">q or Escape</td><td class="py-2 px-3">Quit</td></tr>
              </tbody>
            </table>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">4. View Modes</h4>
          <p class="text-gar-text-secondary mb-4">
            Switch between view modes with keyboard shortcuts or toolbar buttons:
          </p>
          <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-6">
            <li><strong>Ctrl+1</strong> - List view with columns (name, size, date)</li>
            <li><strong>Ctrl+2</strong> - Grid view with icons/thumbnails</li>
            <li><strong>Ctrl+3</strong> - Column view (macOS Finder-style)</li>
            <li><strong>Ctrl+H</strong> - Toggle hidden files</li>
          </ul>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">5. Split Panes</h4>
          <p class="text-gar-text-secondary mb-4">
            Create split layouts for side-by-side file management:
          </p>
          <ul class="list-disc list-inside text-gar-text-secondary space-y-1">
            <li><strong>Ctrl+Shift+H</strong> - Split horizontally</li>
            <li><strong>Ctrl+Shift+V</strong> - Split vertically</li>
            <li><strong>Ctrl+Shift+Arrow</strong> - Focus adjacent pane</li>
            <li><strong>Ctrl+Shift+W</strong> - Close focused pane</li>
          </ul>
        </div>

        <!-- Config Tab -->
        <div slot="tab-1">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Configuration</h3>

          <p class="text-gar-text-secondary mb-6">
            garfield works out of the box with sensible defaults. User configuration is primarily through bookmarks.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Bookmarks</h4>
          <p class="text-gar-text-secondary mb-4">
            Bookmarks are stored as a plain text file with one path per line:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/garfield/bookmarks</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`/home/user/Projects
/home/user/Music
/mnt/external
/var/log`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Managing Bookmarks</h4>
          <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-6">
            <li><strong>Ctrl+D</strong> - Add current directory as bookmark</li>
            <li><strong>Drag folder to sidebar</strong> - Add bookmark via drag-and-drop</li>
            <li><strong>Drag bookmark on sidebar</strong> - Reorder bookmarks</li>
          </ul>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">XDG Places</h4>
          <p class="text-gar-text-secondary mb-4">
            The sidebar automatically includes standard XDG directories:
          </p>
          <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-6">
            <li>Home (~)</li>
            <li>Desktop</li>
            <li>Documents</li>
            <li>Downloads</li>
            <li>Trash</li>
          </ul>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Trash Location</h4>
          <p class="text-gar-text-secondary mb-4">
            garfield uses the Freedesktop trash specification:
          </p>
          <ul class="list-disc list-inside text-gar-text-secondary space-y-1">
            <li><code class="text-gar-accent-orange">~/.local/share/Trash/files/</code> - Trashed files</li>
            <li><code class="text-gar-accent-orange">~/.local/share/Trash/info/</code> - Metadata (.trashinfo files)</li>
          </ul>
        </div>

        <!-- Docs Tab -->
        <div slot="tab-2">
          <DocsSidebar items={docsItems} defaultItem="overview">

            <!-- Overview -->
            <div slot="doc-0">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Overview</h3>
              <p class="text-gar-text-secondary mb-4">
                garfield is a graphical file manager for the gardesk desktop suite. It provides a modern, multi-paned interface with tabbed navigation, multiple view modes, and comprehensive file operations.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Architecture</h4>
              <p class="text-gar-text-secondary mb-4">
                The garfield workspace consists of three crates:
              </p>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-4">
                <li><strong>garfield</strong> - Main file manager application</li>
                <li><strong>garfieldctl</strong> - Command-line control client</li>
                <li><strong>garfield-ipc</strong> - Shared IPC protocol library</li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Key Modules</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1">
                <li><code class="text-gar-accent-orange">app.rs</code> - Event loop and state management</li>
                <li><code class="text-gar-accent-orange">core/</code> - File system operations</li>
                <li><code class="text-gar-accent-orange">ui/</code> - GUI components (sidebar, toolbar, views)</li>
              </ul>
            </div>

            <!-- View Modes -->
            <div slot="doc-1">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">View Modes</h3>
              <p class="text-gar-text-secondary mb-4">
                garfield supports three distinct view modes, each optimized for different use cases.
              </p>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-gar-text-muted/20">
                      <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Mode</th>
                      <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Key</th>
                      <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Best For</th>
                    </tr>
                  </thead>
                  <tbody class="text-gar-text-secondary">
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3">List</td><td class="py-2 px-3 font-mono text-gar-accent-green">Ctrl+1</td><td class="py-2 px-3">Detailed file info (size, date)</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3">Grid</td><td class="py-2 px-3 font-mono text-gar-accent-green">Ctrl+2</td><td class="py-2 px-3">Visual browsing with icons</td></tr>
                    <tr><td class="py-2 px-3">Column</td><td class="py-2 px-3 font-mono text-gar-accent-green">Ctrl+3</td><td class="py-2 px-3">Hierarchical navigation</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- List View -->
            <div slot="doc-2">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">List View</h3>
              <p class="text-gar-text-secondary mb-4">
                The default view mode showing files in a detailed list with sortable columns.
              </p>
              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Columns</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-4">
                <li><strong>Name</strong> - File/folder name with icon</li>
                <li><strong>Size</strong> - Human-readable file size</li>
                <li><strong>Modified</strong> - Last modification date</li>
              </ul>
              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Navigation</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1">
                <li><strong>Up/Down or k/j</strong> - Move selection</li>
                <li><strong>Enter</strong> - Open selected item</li>
                <li><strong>Left/h</strong> - Go to parent directory</li>
                <li><strong>Right/l</strong> - Enter directory</li>
              </ul>
            </div>

            <!-- Grid View -->
            <div slot="doc-3">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Grid View</h3>
              <p class="text-gar-text-secondary mb-4">
                Icon-based grid layout for visual file browsing with adjustable icon sizes.
              </p>
              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Navigation</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-4">
                <li><strong>Arrow keys or hjkl</strong> - Navigate grid</li>
                <li><strong>Enter</strong> - Open selected item</li>
                <li><strong>Backspace</strong> - Go to parent</li>
              </ul>
              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Icon Size</h4>
              <p class="text-gar-text-secondary">
                Use <strong>Ctrl+=</strong> or <strong>Ctrl++</strong> to cycle through icon sizes.
              </p>
            </div>

            <!-- Column View -->
            <div slot="doc-4">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Column View</h3>
              <p class="text-gar-text-secondary mb-4">
                macOS Finder-style column browsing for hierarchical navigation.
              </p>
              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">How It Works</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1">
                <li>Each directory opens in a new column to the right</li>
                <li>Navigate left/right to move between columns</li>
                <li>Navigate up/down within each column</li>
                <li>Full path visible across columns</li>
              </ul>
            </div>

            <!-- Navigation -->
            <div slot="doc-5">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Navigation</h3>
              <p class="text-gar-text-secondary mb-4">
                garfield provides keyboard-driven navigation with vim-style bindings.
              </p>
            </div>

            <!-- Keyboard Nav -->
            <div slot="doc-6">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Keyboard Navigation</h3>
              <div class="overflow-x-auto mb-4">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-gar-text-muted/20">
                      <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Key</th>
                      <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Action</th>
                    </tr>
                  </thead>
                  <tbody class="text-gar-text-secondary">
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Up/Down or k/j</td><td class="py-2 px-3">Move selection up/down</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Left/Right or h/l</td><td class="py-2 px-3">Grid nav or parent/enter</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Enter</td><td class="py-2 px-3">Open file/directory</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Backspace</td><td class="py-2 px-3">Go to parent directory</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Home or g</td><td class="py-2 px-3">Go to first entry</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">End or G</td><td class="py-2 px-3">Go to last entry</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">Page Up/Down</td><td class="py-2 px-3">Page-based navigation</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">~</td><td class="py-2 px-3">Go to home directory</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">/</td><td class="py-2 px-3">Go to root directory</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">r</td><td class="py-2 px-3">Refresh current directory</td></tr>
                    <tr><td class="py-2 px-3 font-mono text-gar-accent-green">Ctrl+L</td><td class="py-2 px-3">Focus address bar</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- History -->
            <div slot="doc-7">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">History Navigation</h3>
              <p class="text-gar-text-secondary mb-4">
