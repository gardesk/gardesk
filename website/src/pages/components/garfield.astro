                <tr><td class="py-2 px-3 font-mono text-gar-accent-green">quit</td><td class="py-2 px-3">-</td><td class="py-2 px-3">Close garfield</td></tr>
              </tbody>
            </table>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Examples</h4>
          <MultiTerminal
            commands={[
              { command: 'garfieldctl open /home/user/Documents', comment: 'Navigate to Documents' },
              { command: 'garfieldctl open /tmp --new-tab', comment: 'Open in new tab' },
              { command: 'garfieldctl current-dir', comment: 'Query current directory' },
              { command: 'garfieldctl status', comment: 'Get app status' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">JSON Protocol</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">Request format</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`{"command": "open", "path": "/home/user", "new_tab": false}
{"command": "current_dir"}
{"command": "status"}
{"command": "quit"}`}</code></pre>
          </div>

          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">Response format</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`// Success
{"success": true, "data": {"current_dir": "/home/user"}}

// Status response
{"success": true, "data": {
  "current_dir": "/home/user/Documents",
  "tab_count": 3,
  "selection_count": 2
}}

// Error
{"success": false, "error": "Directory not found"}`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">File/Folder Picker</h4>
          <p class="text-gar-text-secondary mb-4">
            The IPC protocol also supports file picker dialogs for other applications:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20">
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`// File picker
{
  "command": "file_picker",
  "title": "Select Files",
  "start_dir": "/home/user",
  "filters": ["*.rs", "*.txt"],
  "multiple": true
}

// Folder picker
{
  "command": "folder_picker",
  "title": "Select Directory",
  "start_dir": "/home/user"
}`}</code></pre>
          </div>
        </div>

        <!-- Troubleshooting Tab -->
        <div slot="tab-5">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Troubleshooting</h3>

          <div class="grid gap-4">
            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">garfield won't start</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify X11 is running and DISPLAY is set:</p>
              <MultiTerminal
                commands={[
                  { command: 'echo $DISPLAY', comment: 'Should show :0 or similar' },
                  { command: 'xdpyinfo | head -5', comment: 'Test X connection' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">garfieldctl: connection refused</h4>
              <p class="text-gar-text-secondary text-sm mb-3">The IPC socket may not exist:</p>
              <MultiTerminal
                commands={[
                  { command: 'ls -la ${XDG_RUNTIME_DIR:-/tmp}/garfield.sock', comment: 'Check socket exists' },
                  { command: 'pgrep -x garfield', comment: 'Verify garfield is running' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Bookmarks not saving</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check config directory permissions:</p>
              <MultiTerminal
                commands={[
                  { command: 'ls -la ~/.config/garfield/', comment: 'Check directory exists' },
                  { command: 'mkdir -p ~/.config/garfield', comment: 'Create if missing' },
                  { command: 'touch ~/.config/garfield/bookmarks', comment: 'Create bookmarks file' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Trash not working</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify Freedesktop trash directory:</p>
              <MultiTerminal
                commands={[
                  { command: 'ls -la ~/.local/share/Trash/', comment: 'Check Trash exists' },
                  { command: 'mkdir -p ~/.local/share/Trash/{files,info}', comment: 'Create if missing' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Move operation fails across filesystems</h4>
              <p class="text-gar-text-secondary text-sm">
                garfield automatically falls back to copy+delete when moving across filesystems. If it still fails, check disk space and permissions on both source and destination.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Rendering issues</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check X11 and Cairo dependencies:</p>
              <MultiTerminal
                commands={[
                  { command: 'pkg-config --modversion cairo', comment: 'Check Cairo version' },
                  { command: 'pkg-config --modversion x11', comment: 'Check X11' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Debug logging</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Enable verbose logging:</p>
              <MultiTerminal
                commands={[
                  { command: 'RUST_LOG=debug garfield', comment: 'Run with debug logging' },
                  { command: 'RUST_LOG=garfield=trace garfield', comment: 'Trace-level for garfield only' },
                ]}
              />
            </div>
          </div>
        </div>
      </TabbedCard>

      <!-- Releases -->
      <section class="mt-8">
        <details class="group rounded-lg border border-gar-text-muted/20 bg-gar-bg-secondary/30">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-lg font-semibold text-gar-text-primary hover:bg-gar-bg-secondary/50 rounded-lg transition-colors">
            <span>Releases</span>
            <svg class="w-5 h-5 text-gar-text-muted transition-transform group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-6">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-gar-text-primary font-medium">v0.1.0</span>
              <span class="text-xs px-2 py-0.5 rounded-full bg-gar-accent-green/20 text-gar-accent-green">Latest</span>
            </div>
            <div class="flex flex-wrap gap-3">
              <a href="https://github.com/gardesk/garfield/archive/refs/tags/v0.1.0.tar.gz" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gar-bg-primary border border-gar-text-muted/20 text-gar-text-primary hover:border-gar-accent-orange/50 transition-colors">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
                Source (.tar.gz)
              </a>
            </div>
          </div>
        </details>
      </section>

      <!-- Back link -->
      <div class="mt-12 pt-8 border-t border-gar-text-muted/10">
        <Button href="/" variant="ghost">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to home
        </Button>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
