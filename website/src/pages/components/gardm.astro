---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ImageCarousel from '../../components/ui/ImageCarousel.astro';
import TabbedCard from '../../components/ui/TabbedCard.astro';
import MultiTerminal from '../../components/ui/MultiTerminal.astro';
import DocsSidebar from '../../components/ui/DocsSidebar.astro';

const gardmImages = [
  { src: '/images/gardm1.png', alt: 'gardm display manager greeter' },
];

const tabs = [
  { id: 'getting-started', label: 'Getting Started' },
  { id: 'config', label: 'Config' },
  { id: 'docs', label: 'Docs' },
  { id: 'workflows', label: 'Workflows' },
  { id: 'ipc', label: 'IPC/API' },
  { id: 'troubleshooting', label: 'Troubleshooting' },
];

const docsItems = [
  {
    id: 'overview',
    label: 'Overview',
  },
  {
    id: 'architecture',
    label: 'Architecture',
    children: [
      { id: 'arch-daemon', label: 'gardmd Daemon' },
      { id: 'arch-greeter', label: 'gardm-greeter UI' },
      { id: 'arch-ipc', label: 'IPC Protocol' },
    ]
  },
  {
    id: 'session-management',
    label: 'Session Management',
    children: [
      { id: 'session-x11', label: 'X11 Sessions' },
      { id: 'session-wayland', label: 'Wayland Sessions' },
      { id: 'session-lifecycle', label: 'Session Lifecycle' },
      { id: 'session-discovery', label: 'Session Discovery' },
    ]
  },
  {
    id: 'authentication',
    label: 'Authentication',
    children: [
      { id: 'auth-pam', label: 'PAM Integration' },
      { id: 'auth-flow', label: 'Auth Flow' },
      { id: 'auth-security', label: 'Security Features' },
    ]
  },
  {
    id: 'x-server',
    label: 'X Server Management',
  },
  {
    id: 'vt-management',
    label: 'VT Management',
  },
  {
    id: 'power-management',
    label: 'Power Management',
  },
  {
    id: 'greeter-ui',
    label: 'Greeter UI',
    children: [
      { id: 'greeter-rendering', label: 'Rendering' },
      { id: 'greeter-widgets', label: 'Widgets' },
      { id: 'greeter-accessibility', label: 'Accessibility' },
    ]
  },
];
---

<BaseLayout title="gardm - gardesk" description="Display Manager. A system-level display manager for the gar desktop environment with modern greeter, PAM authentication, and X11/Wayland session support.">
  <Header />

  <main class="pt-24 pb-20 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Hero -->
      <div class="mb-12">
        <Badge status="beta" class="mb-4" />
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <span class="text-gar-accent-cyan">gardm</span>
        </h1>
        <p class="text-xl text-gar-text-secondary mb-6">Display Manager</p>
        <p class="text-gar-text-secondary leading-relaxed mb-8">
          A system-level display manager with graphical greeter for the gar desktop environment. gardm manages X server lifecycle, user authentication via PAM, session launching, and VT allocation. Features a modern Cairo/Pango-rendered login UI with user list, session selection, power management, and garbg wallpaper integration.
        </p>

        <div class="flex flex-wrap gap-4">
          <Button href="https://github.com/gardesk/gardm" variant="primary">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </Button>
          <Button href="/#install" variant="secondary">
            Install
          </Button>
        </div>
      </div>

      <!-- Screenshots -->
      <div class="mb-12">
        <ImageCarousel images={gardmImages} />
      </div>

      <!-- Warning Box -->
      <div class="mb-12 p-4 rounded-lg bg-gar-accent-yellow/10 border border-gar-accent-yellow/30">
        <p class="text-gar-text-primary text-sm font-semibold mb-2">System-Level Component</p>
        <p class="text-gar-text-secondary text-sm">
          gardm is a system-level display manager that runs as root and replaces your existing display manager (GDM, SDDM, LightDM). Test in a VM or ensure you have TTY access (Ctrl+Alt+F2) before deployment.
        </p>
      </div>

      <!-- Features Grid -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            'Two-process architecture (daemon + greeter)',
            'PAM authentication with state machine',
            'X11 session support (keeps X server running)',
            'Wayland session support (direct VT access)',
            'X server lifecycle management (Xorg spawning)',
            'VT allocation and switching (ioctl-based)',
            'User session forking with privilege dropping',
            'systemd-logind session registration',
            'Unix socket IPC (JSON protocol)',
            'Power management (shutdown, reboot, suspend)',
            'Session discovery from .desktop files',
            'User enumeration with avatar support',
            'garbg wallpaper integration with blur',
            'Accessibility options (high contrast, large text)',
            'Fade-out transition on login',
            'systemd service integration (Type=notify)'
          ].map(function(feature) {
            return (
              <li class="flex items-start gap-3 p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/10">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-gar-accent-cyan" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gar-text-primary">{feature}</span>
              </li>
            )
          })}
        </ul>
      </section>

      <!-- Architecture Diagram -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Architecture</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-accent-cyan/20">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-gar-accent-cyan" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
              </svg>
              <h3 class="font-semibold text-gar-text-primary">gardmd (Daemon)</h3>
            </div>
            <p class="text-sm text-gar-text-secondary">Runs as root, manages X server, spawns greeter, handles PAM auth, forks user sessions. IPC server at /run/gardm.sock.</p>
          </div>
          <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-accent-cyan/20">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-gar-accent-cyan" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <h3 class="font-semibold text-gar-text-primary">gardm-greeter (UI)</h3>
            </div>
            <p class="text-sm text-gar-text-secondary">Graphical login interface with Cairo/Pango rendering. User list, session selector, power buttons. Connects to daemon via IPC.</p>
          </div>
        </div>
        <div class="p-4 rounded-lg bg-gar-bg-primary border border-gar-text-muted/20">
          <h4 class="text-sm font-semibold text-gar-text-primary mb-3">Process Flow</h4>
          <div class="space-y-2 text-sm text-gar-text-secondary font-mono">
            <div>systemd → gardmd (starts X server on VT) → spawns gardm-greeter</div>
            <div>greeter → IPC → gardmd (CreateSession, Authenticate, StartSession)</div>
            <div>gardmd → fork/exec → user session (PAM open_session, drop privileges)</div>
            <div>session ends → gardmd kills greeter → restart loop</div>
          </div>
        </div>
      </section>

      <!-- Tabbed Documentation Card -->
      <TabbedCard tabs={tabs} defaultTab="getting-started" class="mb-12">

        <!-- Getting Started Tab -->
        <div slot="tab-0">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Installation & Setup</h3>

          <div class="p-4 rounded-lg bg-gar-accent-yellow/10 border border-gar-accent-yellow/30 mb-6">
            <p class="text-gar-text-primary text-sm font-semibold mb-2">Critical Warning</p>
            <p class="text-gar-text-secondary text-sm">
              gardm replaces your system display manager. Test in a VM first or ensure you have TTY backup access. If installation fails, you can recover from TTY (Ctrl+Alt+F2).
            </p>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">1. Install gardm</h4>
          <p class="text-gar-text-secondary mb-4">
            Use the unified installer which handles dependencies, builds, and system integration:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'curl -fsSL https://gar.dev/install.sh | bash -s -- --component=gardm', comment: 'Install via script (recommended)' },
              { command: 'cd ~/.local/src/gardesk/gardm && cargo build --release -p gardmd -p gardm-greeter', comment: 'Or build from source' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">2. Disable Current Display Manager</h4>
          <p class="text-gar-text-secondary mb-4">
            Disable any existing display manager before enabling gardm:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'sudo systemctl disable gdm', comment: 'GNOME Display Manager' },
              { command: 'sudo systemctl disable sddm', comment: 'Simple Desktop Display Manager' },
              { command: 'sudo systemctl disable lightdm', comment: 'LightDM' },
              { command: 'sudo systemctl status display-manager.service', comment: 'Check current DM' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">3. Enable gardm Service</h4>
          <p class="text-gar-text-secondary mb-4">
            Enable gardm as the system display manager:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'sudo systemctl enable gardm', comment: 'Enable gardm service' },
              { command: 'sudo systemctl start gardm', comment: 'Start now (will replace current X session)' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">4. Configure (Optional)</h4>
          <p class="text-gar-text-secondary mb-4">
            Create system configuration:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'sudo mkdir -p /etc/gardm', comment: 'Create config directory' },
              { command: 'sudo $EDITOR /etc/gardm/config.toml', comment: 'Edit daemon config' },
              { command: 'sudo $EDITOR /etc/gardm/greeter.toml', comment: 'Edit greeter config' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">5. Reboot</h4>
          <p class="text-gar-text-secondary mb-4">
            Reboot to start gardm at boot:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'sudo reboot', comment: 'Reboot system' },
            ]}
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3 mt-6">Recovery Procedure</h4>
          <p class="text-gar-text-secondary mb-4">
            If gardm fails to start, recover from TTY:
          </p>
          <div class="space-y-2 text-sm text-gar-text-secondary">
            <div class="flex items-center gap-2">
              <span class="text-gar-accent-cyan">1.</span>
              <span>Press Ctrl+Alt+F2 to switch to TTY2</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-gar-accent-cyan">2.</span>
              <span>Login with your username and password</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-gar-accent-cyan">3.</span>
              <span>Run: <code class="text-gar-accent-orange">sudo systemctl disable gardm</code></span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-gar-accent-cyan">4.</span>
              <span>Run: <code class="text-gar-accent-orange">sudo systemctl enable gdm</code> (or your previous DM)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-gar-accent-cyan">5.</span>
              <span>Run: <code class="text-gar-accent-orange">sudo reboot</code></span>
            </div>
          </div>
        </div>

        <!-- Config Tab -->
        <div slot="tab-1">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Configuration Reference</h3>

          <p class="text-gar-text-secondary mb-6">
            gardm uses two TOML configuration files: daemon config at <code class="text-gar-accent-cyan">/etc/gardm/config.toml</code> and greeter config at <code class="text-gar-accent-cyan">/etc/gardm/greeter.toml</code>.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Daemon Configuration</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">/etc/gardm/config.toml</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto max-h-96"><code class="text-sm text-gar-text-primary font-mono">{`# ═══════════════════════════════════════════
# gardm daemon configuration
# Display manager daemon settings
# ═══════════════════════════════════════════

[general]
# Default session to launch (without .desktop extension)
# This is used if no session is explicitly selected
default_session = "gar"

# Path to greeter executable
greeter = "/usr/bin/gardm-greeter"

# VT to use (0 = auto-select using VT_OPENQRY ioctl)
vt = 0

# X11 display number
display = ":0"

[greeter]
# Blur radius for background screenshot
blur_radius = 20

# Background brightness (0.0 = black, 1.0 = original)
blur_brightness = 0.7

# Show power buttons (shutdown, reboot, suspend)
show_power_buttons = true

# Show session selector dropdown
show_session_selector = true

# Use garbg's current wallpaper as background
use_garbg_wallpaper = true

# Fallback wallpaper path if garbg not available
fallback_wallpaper = "/usr/share/gardm/backgrounds/default.jpg"

[security]
# Allow empty passwords (NOT recommended)
allow_empty_password = false

# Lock greeter after N failed attempts (0 = disabled)
lockout_attempts = 5

# Lockout duration in seconds
lockout_duration = 300`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Greeter Configuration</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">/etc/gardm/greeter.toml</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto max-h-96"><code class="text-sm text-gar-text-primary font-mono">{`# ═══════════════════════════════════════════
# gardm greeter configuration
# Graphical login UI settings
# ═══════════════════════════════════════════

[visual]
# Blur radius for background (0 = no blur)
blur_radius = 25.0

# Background brightness (0.0-1.0, lower = darker)
brightness = 0.6

# Corner radius for UI elements
corner_radius = 16.0

# Fade-out duration in milliseconds when starting session
fade_duration_ms = 200

[garbg]
# Whether to use garbg wallpaper as background
enabled = true

# Fallback wallpaper if garbg not available
fallback = "/usr/share/gardm/backgrounds/default.jpg"

[theme]
# Font family
font_family = "Sans"

# Normal text size
font_size_normal = 14

# Large text size
font_size_large = 16

# Primary color (hex format)
color_primary = "#61afef"

# Background color
color_background = "#1e2127"

# Text color
color_text = "#abb2bf"

# Error color
color_error = "#e06c75"

[accessibility]
# High contrast mode (increases contrast for visibility)
high_contrast = false

# Large text mode (increases font sizes)
large_text = false

# Reduce motion (disables fade transitions)
reduce_motion = false`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">PAM Configuration</h4>
          <p class="text-gar-text-secondary mb-4">
            The installer creates <code class="text-gar-accent-cyan">/etc/pam.d/gardm</code> automatically:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">/etc/pam.d/gardm</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`#%PAM-1.0
# gardm display manager PAM configuration

# Authentication
auth        required      pam_unix.so

# Account management
account     required      pam_unix.so

# Password management
password    required      pam_unix.so

# Session management - pam_systemd registers with logind
-session    optional      pam_systemd.so
session     required      pam_unix.so`}</code></pre>
          </div>
        </div>

        <!-- Docs Tab -->
        <div slot="tab-2">
          <DocsSidebar items={docsItems} defaultItem="overview">

            <!-- Overview -->
            <div slot="doc-0">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Overview</h3>
              <p class="text-gar-text-secondary mb-4">
                gardm is a system-level display manager for X11 and Wayland sessions. It consists of two processes: gardmd (daemon running as root) and gardm-greeter (graphical UI). Communication happens via JSON over Unix socket.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Key Components</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-2 mb-4">
                <li><strong>gardmd:</strong> Daemon managing X server, VTs, authentication, and sessions</li>
                <li><strong>gardm-greeter:</strong> Graphical login UI with Cairo/Pango rendering</li>
                <li><strong>gardm-ipc:</strong> Shared IPC protocol library</li>
                <li><strong>PAM:</strong> Authentication via pam crate</li>
                <li><strong>systemd-logind:</strong> Session registration and power management</li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">File Locations</h4>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <tbody class="text-gar-text-secondary">
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-cyan">/usr/bin/gardmd</td><td class="py-2 px-3">Display manager daemon</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-cyan">/usr/bin/gardm-greeter</td><td class="py-2 px-3">Graphical greeter</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-cyan">/etc/gardm/config.toml</td><td class="py-2 px-3">Daemon configuration</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-cyan">/etc/gardm/greeter.toml</td><td class="py-2 px-3">Greeter configuration</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-cyan">/etc/pam.d/gardm</td><td class="py-2 px-3">PAM service configuration</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-cyan">/run/gardm.sock</td><td class="py-2 px-3">IPC Unix socket</td></tr>
                    <tr><td class="py-2 px-3 font-mono text-gar-accent-cyan">/usr/lib/systemd/system/gardm.service</td><td class="py-2 px-3">systemd service file</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Architecture -->
            <div slot="doc-1">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Architecture</h3>
              <p class="text-gar-text-secondary mb-4">
                gardm uses a two-process architecture for security and stability.
              </p>
            </div>

            <!-- gardmd Daemon -->
            <div slot="doc-2">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">gardmd Daemon</h3>
              <p class="text-gar-text-secondary mb-4">
                The daemon runs as root and manages system-level operations.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Responsibilities</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-2 mb-4">
                <li>Start and manage X server (Xorg) on allocated VT</li>
                <li>Spawn greeter process on X display</li>
                <li>Handle IPC server at /run/gardm.sock</li>
                <li>Process PAM authentication requests</li>
                <li>Fork user sessions with privilege dropping</li>
                <li>Manage X11 vs Wayland session differences</li>
                <li>Coordinate VT switching</li>
                <li>Handle power actions via systemd-logind</li>
                <li>Enumerate sessions and users</li>
                <li>Send sd-notify signals to systemd</li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Main Loop</h4>
              <div class="space-y-2 text-sm text-gar-text-secondary">
                <div>1. Start X server on VT</div>
                <div>2. Start IPC server</div>
                <div>3. Notify systemd ready</div>
                <div>4. Spawn greeter process</div>
                <div>5. Wait for IPC connection from greeter</div>
                <div>6. Handle auth requests (CreateSession → Authenticate → StartSession)</div>
                <div>7. On successful auth: kill greeter, fork user session</div>
                <div>8. Wait for session to end</div>
                <div>9. Return to step 4 (restart greeter)</div>
              </div>
            </div>

            <!-- gardm-greeter UI -->
            <div slot="doc-3">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">gardm-greeter UI</h3>
              <p class="text-gar-text-secondary mb-4">
                The greeter is a graphical application running on the X display managed by gardmd.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Responsibilities</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-2 mb-4">
                <li>Create fullscreen X11 window</li>
                <li>Render login UI using Cairo/Pango</li>
                <li>Handle keyboard and mouse input</li>
                <li>Connect to daemon via /run/gardm.sock</li>
                <li>Send IPC requests (CreateSession, Authenticate, StartSession)</li>
                <li>Display user list with avatars</li>
                <li>Show session selector dropdown</li>
                <li>Render power buttons</li>
                <li>Load and blur background wallpaper</li>
                <li>Animate fade-out transition on success</li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Rendering Pipeline</h4>
              <div class="space-y-2 text-sm text-gar-text-secondary">
                <div>1. Create Cairo ImageSurface (fullscreen)</div>
                <div>2. Draw blurred background</div>
                <div>3. Render widgets (user list, login form, session selector, power buttons)</div>
                <div>4. Apply fade opacity if transitioning</div>
                <div>5. Copy surface to X11 window via put_image</div>
                <div>6. Repeat at ~60fps</div>
              </div>
