            <!-- Greeter UI -->
            <div slot="doc-17">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Greeter UI</h3>
              <p class="text-gar-text-secondary mb-4">
                The greeter UI is built with Cairo for rendering and Pango for text layout.
