            <!-- Rendering -->
            <div slot="doc-18">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Rendering</h3>
              <p class="text-gar-text-secondary mb-4">
                Rendering uses Cairo ImageSurface with manual frame copying to X11.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Rendering Stack</h4>
              <div class="space-y-2 text-sm text-gar-text-secondary">
                <div>1. <strong>Cairo Context:</strong> 2D graphics rendering</div>
                <div>2. <strong>Pango Layout:</strong> Text rendering and layout</div>
                <div>3. <strong>Image Surface:</strong> ARGB32 framebuffer (full screen size)</div>
                <div>4. <strong>X11 PutImage:</strong> Copy framebuffer to window</div>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3 mt-6">Frame Loop</h4>
              <div class="space-y-2 text-sm text-gar-text-secondary font-mono mb-4">
                <div>loop {</div>
                <div class="ml-4">// Clear and render background</div>
                <div class="ml-4">render_background(&ctx, &blurred_image)</div>
                <div class="ml-4"></div>
                <div class="ml-4">// Render UI widgets</div>
                <div class="ml-4">user_list.render(&ctx, &pango_ctx, &theme)</div>
                <div class="ml-4">login_form.render(&ctx, &pango_ctx, &theme)</div>
                <div class="ml-4">session_selector.render(&ctx, &pango_ctx, &theme)</div>
                <div class="ml-4">power_buttons.render(&ctx)</div>
                <div class="ml-4"></div>
                <div class="ml-4">// Copy to X11 window</div>
                <div class="ml-4">window.put_image(surface.data())</div>
                <div class="ml-4"></div>
                <div class="ml-4">// Handle events</div>
                <div class="ml-4">process_x11_events()</div>
                <div class="ml-4"></div>
                <div class="ml-4">sleep(16ms) // ~60fps</div>
                <div>}</div>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Background Blur</h4>
              <p class="text-gar-text-secondary mb-4">
                Greeter attempts to use garbg wallpaper, falls back to configured path. Image is loaded, blurred via Gaussian blur (downsample-blur-upsample), and brightness-adjusted.
              </p>
            </div>

