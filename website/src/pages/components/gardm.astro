        <!-- Troubleshooting Tab -->
        <div slot="tab-5">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Troubleshooting</h3>

          <div class="space-y-6">
            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">gardm service won't start</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check service status and logs:</p>
              <MultiTerminal
                commands={[
                  { command: 'sudo systemctl status gardm', comment: 'Check service status' },
                  { command: 'sudo journalctl -xeu gardm', comment: 'View detailed logs' },
                  { command: 'ls -l /usr/bin/gardmd /usr/bin/gardm-greeter', comment: 'Verify binaries exist' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Ensure PAM config exists: <code class="text-gar-accent-cyan">ls -l /etc/pam.d/gardm</code>
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Black screen / X server fails to start</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check X server logs:</p>
              <MultiTerminal
                commands={[
                  { command: 'cat /var/log/Xorg.0.log | grep EE', comment: 'Check for X errors' },
                  { command: 'sudo journalctl -u gardm | grep "X server"', comment: 'gardm X server logs' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Verify Xorg is installed: <code class="text-gar-accent-cyan">which Xorg</code>
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Greeter not appearing</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check if greeter process started:</p>
              <MultiTerminal
                commands={[
                  { command: 'ps aux | grep gardm-greeter', comment: 'Check if greeter running' },
                  { command: 'echo $DISPLAY', comment: 'Verify display is set' },
                  { command: 'DISPLAY=:0 xdpyinfo', comment: 'Test X connection' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Cannot authenticate / PAM errors</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify PAM configuration:</p>
              <MultiTerminal
                commands={[
                  { command: 'cat /etc/pam.d/gardm', comment: 'Check PAM config' },
                  { command: 'sudo journalctl -u gardm | grep -i pam', comment: 'PAM-related logs' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Ensure PAM config includes pam_unix.so or pam_systemd.so.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Session starts but immediately ends</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check session command and logs:</p>
              <MultiTerminal
                commands={[
                  { command: 'cat /usr/share/xsessions/gar.desktop', comment: 'Verify session Exec command' },
                  { command: 'which gar-session.sh', comment: 'Check if session script exists' },
                  { command: 'sudo journalctl -u gardm | grep "session"', comment: 'Session start/end logs' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Verify session command is executable and has correct shebang.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Wayland session fails to start</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check TTY ownership and session logs:</p>
              <MultiTerminal
                commands={[
                  { command: 'ls -l /dev/tty1', comment: 'Check TTY ownership' },
                  { command: 'loginctl show-session', comment: 'Verify logind session' },
                  { command: 'sudo journalctl -u gardm | grep -i wayland', comment: 'Wayland session logs' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Ensure compositor has permissions and pam_systemd is configured.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Power buttons don't work</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check systemd-logind permissions:</p>
              <MultiTerminal
                commands={[
                  { command: 'systemctl status systemd-logind', comment: 'Verify logind running' },
                  { command: 'loginctl show-seat seat0 | grep CanPowerOff', comment: 'Check permissions' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                May require polkit policy for passwordless power actions. Check <code class="text-gar-accent-cyan">/etc/polkit-1/rules.d/</code>
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">IPC connection refused</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check socket exists and permissions:</p>
              <MultiTerminal
                commands={[
                  { command: 'ls -l /run/gardm.sock', comment: 'Verify socket exists' },
                  { command: 'sudo systemctl restart gardm', comment: 'Restart to recreate socket' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Stuck at greeter / can't login to TTY</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Emergency recovery:</p>
              <ol class="list-decimal list-inside text-gar-text-secondary space-y-2 text-sm mt-3">
                <li>Reboot system</li>
                <li>At GRUB, select "Advanced options"</li>
                <li>Boot to single-user mode or recovery mode</li>
                <li>Run: <code class="text-gar-accent-orange">systemctl disable gardm</code></li>
                <li>Run: <code class="text-gar-accent-orange">systemctl enable gdm</code> (or previous DM)</li>
                <li>Reboot</li>
              </ol>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Enable verbose logging</h4>
              <p class="text-gar-text-secondary text-sm mb-3">For maximum debug output:</p>
              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mt-3">
                <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
                  <span class="text-sm text-gar-text-secondary font-mono">/etc/systemd/system/gardm.service.d/override.conf</span>
                </div>
                <pre class="bg-gar-bg-primary p-3 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`[Service]
Environment="RUST_LOG=gardmd=trace,gardm_greeter=trace"`}</code></pre>
              </div>
              <MultiTerminal
                commands={[
                  { command: 'sudo systemctl daemon-reload', comment: 'Reload systemd' },
                  { command: 'sudo systemctl restart gardm', comment: 'Restart with debug logging' },
                  { command: 'sudo journalctl -u gardm -f', comment: 'Follow logs' },
                ]}
                class="mt-3"
              />
            </div>
          </div>
        </div>
      </TabbedCard>

      <!-- Releases -->
