            <!-- Selection UI -->
            <div slot="doc-17">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Selection UI</h3>
              <p class="text-gar-text-secondary mb-4">
                The region selection overlay uses a blurred background to help you focus on the selection area.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">How It Works</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-4">
                <li>Full-screen capture is taken and blurred</li>
                <li>Selected region shows the original (unblurred) image</li>
                <li>Orange border shows selection bounds</li>
                <li>Dimensions displayed in top-left corner</li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Technical Details</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1">
                <li>Box blur approximation (3 passes ≈ Gaussian)</li>
                <li>Server-side pixmaps for fast rendering</li>
                <li>CopyArea for instant region updates</li>
                <li>Crosshair cursor during selection</li>
              </ul>
            </div>

            <!-- Multi-Monitor -->
            <div slot="doc-18">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Multi-Monitor Support</h3>
              <p class="text-gar-text-secondary mb-4">
                garshot uses XRandR to detect and capture from multiple monitors.
              </p>
              <MultiTerminal
                commands={[
                  { command: 'garshot monitors', comment: 'List all monitors' },
                  { command: 'garshot screen -m HDMI-1', comment: 'Capture specific monitor' },
                  { command: 'garshot screen', comment: 'Capture entire virtual screen' },
                ]}
                class="mb-4"
              />

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Monitor Info</h4>
              <p class="text-gar-text-secondary mb-4">
                The <code class="text-gar-accent-yellow">monitors</code> command shows:
              </p>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1">
                <li>Monitor name (e.g., HDMI-1, eDP-1)</li>
                <li>Resolution and position</li>
                <li>Primary monitor flag</li>
              </ul>
            </div>

          </DocsSidebar>
        </div>

        <!-- Workflows Tab -->
        <div slot="tab-3">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Common Workflows</h3>

          <p class="text-gar-text-secondary mb-6">
            Practical examples of using garshot for everyday screenshot tasks.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Keybinding with gar</h4>
          <p class="text-gar-text-secondary mb-4">
            Add screenshot keybindings to your gar configuration:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/gar/init.lua</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`-- Screenshot keybindings
gar.bind("Print", function() gar.exec("garshot screen") end)
gar.bind("shift+Print", function() gar.exec("garshot region") end)
gar.bind("ctrl+Print", function() gar.exec("garshot window") end)
gar.bind("mod+Print", function() gar.exec("garshot screen -c") end)

-- Or using garshotctl with daemon
gar.bind("Print", function() gar.exec("garshotctl screen") end)
gar.bind("shift+Print", function() gar.exec("garshotctl region") end)`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Quick Share to Clipboard</h4>
          <p class="text-gar-text-secondary mb-4">
            Take a screenshot and immediately paste into chat/email:
          </p>
          <MultiTerminal
            commands={[
              { command: 'garshot region', comment: 'Select area (auto-copied to clipboard)' },
              { command: 'Ctrl+V', comment: 'Paste in application' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Timed Screenshots</h4>
          <p class="text-gar-text-secondary mb-4">
            Use sleep for delayed captures:
          </p>
          <MultiTerminal
            commands={[
              { command: 'sleep 5 && garshot screen', comment: '5 second delay' },
              { command: 'sleep 3 && garshot region', comment: '3 seconds then select' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Batch Screenshots</h4>
          <p class="text-gar-text-secondary mb-4">
            Capture multiple monitors or windows in sequence:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">batch-screenshots.sh</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`#!/bin/bash
# Capture all monitors
for monitor in $(garshot monitors | grep -oP '^\S+'); do
    garshot screen -m "$monitor" -o "~/Screenshots/$monitor.png"
done`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Auto-Upload Script</h4>
          <p class="text-gar-text-secondary mb-4">
            Upload screenshots automatically:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">screenshot-upload.sh</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`#!/bin/bash
FILE=$(garshot region -o /tmp/screenshot.png 2>&1 | grep -oP 'Saved to: \K.*')
if [ -f "$FILE" ]; then
    URL=$(curl -s -F "file=@$FILE" https://your-image-host.com/upload)
    echo "$URL" | xclip -selection clipboard
    notify-send "Screenshot uploaded" "$URL"
fi`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Systemd User Service</h4>
          <p class="text-gar-text-secondary mb-4">
            Run garshot daemon automatically on login:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/systemd/user/garshot.service</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`[Unit]
Description=garshot screenshot daemon
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/garshot daemon
Restart=on-failure

[Install]
WantedBy=default.target`}</code></pre>
          </div>
          <MultiTerminal
            commands={[
              { command: 'systemctl --user enable garshot', comment: 'Enable on login' },
              { command: 'systemctl --user start garshot', comment: 'Start now' },
            ]}
          />
        </div>

        <!-- Troubleshooting Tab -->
        <div slot="tab-4">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Troubleshooting</h3>

          <div class="space-y-6">
            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Clipboard not working</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Ensure xclip is installed:</p>
              <MultiTerminal
                commands={[
                  { command: 'which xclip', comment: 'Check if xclip is installed' },
                  { command: 'sudo pacman -S xclip', comment: 'Install on Arch' },
                  { command: 'sudo apt install xclip', comment: 'Install on Debian/Ubuntu' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">MIT-SHM error</h4>
              <p class="text-gar-text-secondary text-sm mb-3">SHM extension may not be available:</p>
              <MultiTerminal
                commands={[
                  { command: 'xdpyinfo | grep MIT-SHM', comment: 'Check SHM support' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                If running over SSH, use <code class="text-gar-accent-yellow">-X</code> (not <code class="text-gar-accent-yellow">-Y</code>) or consider running garshot locally.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">garshotctl: connection refused</h4>
              <p class="text-gar-text-secondary text-sm mb-3">The daemon may not be running:</p>
              <MultiTerminal
                commands={[
                  { command: 'pgrep -x garshot', comment: 'Check if daemon is running' },
                  { command: 'ls -la ${XDG_RUNTIME_DIR:-/tmp}/garshot.sock', comment: 'Check socket exists' },
                  { command: 'garshot daemon &', comment: 'Start daemon' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Selection overlay not appearing</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check DISPLAY environment:</p>
              <MultiTerminal
                commands={[
                  { command: 'echo $DISPLAY', comment: 'Should show :0 or similar' },
                  { command: 'DISPLAY=:0 garshot region', comment: 'Explicitly set display' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Monitor not found</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify monitor name with xrandr:</p>
              <MultiTerminal
                commands={[
                  { command: 'xrandr --query | grep " connected"', comment: 'List connected monitors' },
                  { command: 'garshot monitors', comment: 'List monitors known to garshot' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Use the exact name shown (e.g., <code class="text-gar-accent-yellow">HDMI-1</code> not <code class="text-gar-accent-yellow">hdmi-1</code>).
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Cursor not appearing in screenshot</h4>
              <p class="text-gar-text-secondary text-sm mb-3">XFixes extension may not be available:</p>
              <MultiTerminal
                commands={[
                  { command: 'xdpyinfo | grep XFIXES', comment: 'Check XFixes support' },
                  { command: 'garshot -c screen', comment: 'Explicitly request cursor' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Screenshots save with wrong permissions</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check umask settings:</p>
              <MultiTerminal
                commands={[
                  { command: 'umask', comment: 'Check current umask' },
                  { command: 'chmod 644 ~/Pictures/Screenshots/*.png', comment: 'Fix permissions' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Debug logging</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Enable verbose output:</p>
              <MultiTerminal
                commands={[
                  { command: 'RUST_LOG=debug garshot screen', comment: 'Debug mode' },
                  { command: 'RUST_LOG=trace garshot region', comment: 'Trace mode (very verbose)' },
                ]}
              />
            </div>
          </div>
        </div>

      </TabbedCard>

      <!-- Back link -->
      <div class="mt-12 pt-8 border-t border-gar-text-muted/10">
        <Button href="/" variant="ghost">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to home
        </Button>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
