---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ImageCarousel from '../../components/ui/ImageCarousel.astro';
import TabbedCard from '../../components/ui/TabbedCard.astro';
import MultiTerminal from '../../components/ui/MultiTerminal.astro';
import DocsSidebar from '../../components/ui/DocsSidebar.astro';

const garshotImages = [
  { src: '/images/garshot1.png', alt: 'garshot screenshot with annotation editor' },
  { src: '/images/garshot2.png', alt: 'garshot region selection with blur' },
  { src: '/images/garshot3.png', alt: 'garshot annotation tools' },
  { src: '/images/garshot4.png', alt: 'garshot color picker' },
];

const tabs = [
  { id: 'getting-started', label: 'Getting Started' },
  { id: 'config', label: 'Config' },
  { id: 'docs', label: 'Docs' },
  { id: 'workflows', label: 'Workflows' },
  { id: 'troubleshooting', label: 'Troubleshooting' },
];

const docsItems = [
  {
    id: 'overview',
    label: 'Overview',
  },
  {
    id: 'capture-modes',
    label: 'Capture Modes',
    children: [
      { id: 'screen-capture', label: 'Screen' },
      { id: 'region-capture', label: 'Region' },
      { id: 'window-capture', label: 'Window' },
      { id: 'active-window', label: 'Active Window' },
    ]
  },
  {
    id: 'annotations',
    label: 'Annotations',
    children: [
      { id: 'annotation-tools', label: 'Tools' },
      { id: 'annotation-colors', label: 'Colors' },
      { id: 'annotation-keyboard', label: 'Keyboard Shortcuts' },
    ]
  },
  {
    id: 'output',
    label: 'Output',
    children: [
      { id: 'formats', label: 'Formats' },
      { id: 'clipboard', label: 'Clipboard' },
      { id: 'naming', label: 'Naming Patterns' },
    ]
  },
  {
    id: 'daemon',
    label: 'Daemon Mode',
    children: [
      { id: 'ipc', label: 'IPC Protocol' },
      { id: 'garshotctl', label: 'garshotctl' },
    ]
  },
  {
    id: 'selection-ui',
    label: 'Selection UI',
  },
  {
    id: 'monitors',
    label: 'Multi-Monitor',
  },
];
---

<BaseLayout title="garshot - gardesk" description="Screenshot Utility. A fast X11 screenshot tool with built-in annotation editor, interactive selection, and multiple output formats.">
  <Header />

  <main class="pt-24 pb-20 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Hero -->
      <div class="mb-12">
        <Badge status="stable" class="mb-4" />
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <span class="text-gar-accent-yellow">garshot</span>
        </h1>
        <p class="text-xl text-gar-text-secondary mb-6">Screenshot Utility</p>
        <p class="text-gar-text-secondary leading-relaxed mb-8">
          A fast X11 screenshot tool with built-in annotation editor, interactive region selection, and multiple output formats. garshot uses MIT-SHM for performance (~50ms full-screen captures) and includes 8 annotation tools with a color picker featuring HSV, RGB, and eyedropper modes.
        </p>

        <div class="flex flex-wrap gap-4">
          <Button href="https://github.com/gardesk/garshot" variant="primary">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </Button>
          <Button href="/#install" variant="secondary">
            Install
          </Button>
        </div>
      </div>

      <!-- Screenshots -->
      <div class="mb-12">
        <ImageCarousel images={garshotImages} />
      </div>

      <!-- Features Grid -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            'MIT-SHM for fast captures (~50ms full-screen)',
            'Built-in annotation editor with 8 tools',
            'Color picker with HSV, RGB, palette & eyedropper',
            'Interactive region selection with blur overlay',
            'Window capture with optional decorations',
            'Multiple formats: PNG, JPEG, WebP',
            'Automatic clipboard copy via xclip/xsel',
            'Daemon mode for instant subsequent captures',
            'Undo/redo with 50 history levels',
            'Multi-monitor support via XRandR'
          ].map(function(feature) {
            return (
              <li class="flex items-start gap-3 p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/10">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-gar-accent-yellow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gar-text-primary">{feature}</span>
              </li>
            )
          })}
        </ul>
      </section>

      <!-- Tabbed Documentation Card -->
      <TabbedCard tabs={tabs} defaultTab="getting-started" class="mb-12">

        <!-- Getting Started Tab -->
        <div slot="tab-0">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Quick Start Guide</h3>

          <p class="text-gar-text-secondary mb-6">
            Get up and running with garshot in just a few steps. This guide covers installation, basic usage, and essential commands.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">1. Installation</h4>
          <p class="text-gar-text-secondary mb-4">
            Install garshot using the unified installer or build from source:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'curl -fsSL https://gar.musicsian.com/install.sh | bash -s -- --component=garshot', comment: 'Install via script' },
              { command: 'cd ~/.local/src/gardesk/garshot && cargo build --release', comment: 'Or build from source' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">2. System Dependencies</h4>
          <p class="text-gar-text-secondary mb-4">
            garshot requires X11 and optionally xclip for clipboard support:
          </p>
          <MultiTerminal
            title="Install dependencies"
            commands={[
              { command: 'sudo pacman -S libx11 xclip', comment: 'Arch' },
              { command: 'sudo apt install libx11-dev xclip', comment: 'Debian/Ubuntu' },
              { command: 'sudo dnf install libX11-devel xclip', comment: 'Fedora' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">3. Basic Usage</h4>
          <p class="text-gar-text-secondary mb-4">
            Take your first screenshots with these commands:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'garshot', comment: 'Capture full screen (default)' },
              { command: 'garshot region', comment: 'Interactive region selection' },
              { command: 'garshot window', comment: 'Capture active window' },
              { command: 'garshot screen -m HDMI-1', comment: 'Capture specific monitor' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">4. Output Options</h4>
          <p class="text-gar-text-secondary mb-4">
            Control where screenshots go:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'garshot -o ~/screenshot.png', comment: 'Save to specific path' },
              { command: 'garshot -f jpeg', comment: 'Use JPEG format' },
              { command: 'garshot --no-clipboard', comment: 'Skip clipboard copy' },
              { command: 'garshot -c', comment: 'Include cursor in screenshot' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">5. Annotation Mode</h4>
          <p class="text-gar-text-secondary mb-4">
            Edit screenshots with the built-in annotation editor:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'garshot screen --annotate', comment: 'Capture + annotate' },
              { command: 'garshot region --annotate', comment: 'Select region + annotate' },
              { command: 'garshot annotate screenshot.png', comment: 'Annotate existing file' },
            ]}
            class="mb-6"
          />
          <p class="text-gar-text-secondary mb-4">
            In the editor, use <code class="text-gar-accent-yellow">Ctrl+Enter</code> to save or <code class="text-gar-accent-yellow">Escape</code> to cancel.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">6. Daemon Mode</h4>
          <p class="text-gar-text-secondary mb-4">
            Run garshot as a daemon for faster subsequent captures:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'garshot daemon &', comment: 'Start daemon in background' },
              { command: 'garshotctl screen', comment: 'Capture via daemon' },
              { command: 'garshotctl region', comment: 'Region select via daemon' },
              { command: 'garshotctl status', comment: 'Check daemon status' },
            ]}
          />
        </div>

        <!-- Config Tab -->
        <div slot="tab-1">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Configuration Reference</h3>

          <p class="text-gar-text-secondary mb-6">
            garshot uses TOML for configuration. The config file is located at <code class="text-gar-accent-yellow">~/.config/garshot/config.toml</code>.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Full Configuration Example</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/garshot/config.toml</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`[general]
# Default save directory (supports ~ expansion)
save_dir = "~/Pictures/Screenshots"

# Default output format: png, jpeg, webp, ppm
format = "png"

# Quality for JPEG/WebP (1-100)
quality = 90

# Include cursor in screenshots by default
include_cursor = false

[selection]
# Blur radius for background during selection (pixels)
blur_radius = 15

# Selection border color (hex)
line_color = "#ff6600"

# Selection border width (pixels)
line_width = 2

[naming]
# Filename pattern with tokens:
#   %Y %m %d %H %M %S - strftime tokens
#   %N - global counter (persistent)
#   %n - daily counter (resets each day)
#   %w - window name (for window captures)
pattern = "screenshot-%Y%m%d-%H%M%S"`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">General Settings</h4>
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Option</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Default</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-yellow">save_dir</td><td class="py-2 px-3">~/Pictures/Screenshots</td><td class="py-2 px-3">Default save directory</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-yellow">format</td><td class="py-2 px-3">png</td><td class="py-2 px-3">Output format</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-yellow">quality</td><td class="py-2 px-3">90</td><td class="py-2 px-3">JPEG/WebP quality (1-100)</td></tr>
                <tr><td class="py-2 px-3 font-mono text-gar-accent-yellow">include_cursor</td><td class="py-2 px-3">false</td><td class="py-2 px-3">Include cursor by default</td></tr>
              </tbody>
            </table>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Selection Settings</h4>
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Option</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Default</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-yellow">blur_radius</td><td class="py-2 px-3">15</td><td class="py-2 px-3">Background blur amount</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-yellow">line_color</td><td class="py-2 px-3">#ff6600</td><td class="py-2 px-3">Selection border color</td></tr>
                <tr><td class="py-2 px-3 font-mono text-gar-accent-yellow">line_width</td><td class="py-2 px-3">2</td><td class="py-2 px-3">Selection border width</td></tr>
              </tbody>
            </table>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Naming Pattern Tokens</h4>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Token</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Example</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">%Y</td><td class="py-2 px-3">Year (4 digits)</td><td class="py-2 px-3">2026</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">%m</td><td class="py-2 px-3">Month (01-12)</td><td class="py-2 px-3">01</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">%d</td><td class="py-2 px-3">Day (01-31)</td><td class="py-2 px-3">17</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">%H</td><td class="py-2 px-3">Hour (00-23)</td><td class="py-2 px-3">14</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">%M</td><td class="py-2 px-3">Minute (00-59)</td><td class="py-2 px-3">30</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">%S</td><td class="py-2 px-3">Second (00-59)</td><td class="py-2 px-3">45</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">%N</td><td class="py-2 px-3">Global counter</td><td class="py-2 px-3">42</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">%n</td><td class="py-2 px-3">Daily counter</td><td class="py-2 px-3">5</td></tr>
                <tr><td class="py-2 px-3 font-mono text-gar-accent-green">%w</td><td class="py-2 px-3">Window name</td><td class="py-2 px-3">firefox</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Docs Tab -->
        <div slot="tab-2">
          <DocsSidebar items={docsItems} defaultItem="overview">

            <!-- Overview -->
            <div slot="doc-0">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Overview</h3>
              <p class="text-gar-text-secondary mb-4">
                garshot is a screenshot utility designed for the gardesk desktop environment. It provides fast screen capture using MIT-SHM (shared memory), interactive region selection with a blur overlay, and flexible output options.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Architecture</h4>
              <p class="text-gar-text-secondary mb-4">
                garshot consists of three crates:
              </p>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-4">
                <li><code class="text-gar-accent-yellow">garshot</code> - Main binary for captures and daemon</li>
                <li><code class="text-gar-accent-yellow">garshotctl</code> - Control client for daemon communication</li>
                <li><code class="text-gar-accent-yellow">garshot-ipc</code> - Shared IPC protocol types</li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Performance</h4>
              <p class="text-gar-text-secondary mb-4">
                garshot uses the MIT-SHM X11 extension for zero-copy screen capture:
              </p>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1">
                <li>~50ms for full-screen 1920x1080 capture</li>
                <li>Instant subsequent captures in daemon mode</li>
                <li>Fast PNG compression with Sub filter</li>
              </ul>
            </div>

            <!-- Capture Modes -->
            <div slot="doc-1">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Capture Modes</h3>
              <p class="text-gar-text-secondary mb-4">
                garshot supports multiple capture modes for different use cases. Use the appropriate command for your needs.
              </p>
            </div>

            <!-- Screen Capture -->
            <div slot="doc-2">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Screen Capture</h3>
              <p class="text-gar-text-secondary mb-4">
                Capture the entire screen or a specific monitor.
              </p>
              <MultiTerminal
                commands={[
                  { command: 'garshot screen', comment: 'Capture entire screen' },
                  { command: 'garshot screen -m HDMI-1', comment: 'Capture specific monitor' },
                  { command: 'garshot screen -c', comment: 'Include cursor' },
                ]}
                class="mb-4"
              />

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Options</h4>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <tbody class="text-gar-text-secondary">
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">-m, --monitor</td><td class="py-2 px-3">Monitor name (e.g., HDMI-1, eDP-1)</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">-c, --cursor</td><td class="py-2 px-3">Include cursor in capture</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">-o, --output</td><td class="py-2 px-3">Output file path</td></tr>
                    <tr><td class="py-2 px-3 font-mono text-gar-accent-green">-f, --format</td><td class="py-2 px-3">Output format (png, jpeg, webp)</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Region Capture -->
            <div slot="doc-3">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Region Capture</h3>
              <p class="text-gar-text-secondary mb-4">
                Interactive region selection with a blur overlay. Click and drag to select an area.
              </p>
              <MultiTerminal
                commands={[
                  { command: 'garshot region', comment: 'Start region selection' },
                  { command: 'garshot region -b 20', comment: 'Custom blur radius' },
                  { command: 'garshot region -c', comment: 'Include cursor' },
                ]}
                class="mb-4"
              />

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Controls</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1 mb-4">
                <li><strong>Left Click + Drag</strong> - Select region</li>
                <li><strong>Escape</strong> - Cancel selection</li>
                <li><strong>Release</strong> - Confirm and capture</li>
              </ul>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Options</h4>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <tbody class="text-gar-text-secondary">
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">-b, --blur</td><td class="py-2 px-3">Blur radius (default: 15)</td></tr>
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">-c, --cursor</td><td class="py-2 px-3">Include cursor in capture</td></tr>
                    <tr><td class="py-2 px-3 font-mono text-gar-accent-green">--no-clipboard</td><td class="py-2 px-3">Skip clipboard copy</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Window Capture -->
            <div slot="doc-4">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Window Capture</h3>
              <p class="text-gar-text-secondary mb-4">
                Capture a specific window by ID or the currently focused window.
              </p>
              <MultiTerminal
                commands={[
                  { command: 'garshot window', comment: 'Capture active window' },
                  { command: 'garshot window -i 0x1c00004', comment: 'Capture by window ID (hex)' },
                  { command: 'garshot window -d', comment: 'Include window decorations' },
                ]}
                class="mb-4"
              />

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Options</h4>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <tbody class="text-gar-text-secondary">
