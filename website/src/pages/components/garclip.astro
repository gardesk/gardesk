        <!-- Troubleshooting Tab -->
        <div slot="tab-5">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Troubleshooting</h3>

          <div class="space-y-6">
            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Daemon not starting</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check if already running:</p>
              <MultiTerminal
                commands={[
                  { command: 'pgrep -x garclip', comment: 'Check for existing process' },
                  { command: 'cat $XDG_RUNTIME_DIR/garclip.pid', comment: 'Check PID file' },
                  { command: 'rm $XDG_RUNTIME_DIR/garclip.pid', comment: 'Remove stale PID file' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">garclipctl connection refused</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify daemon is running and socket exists:</p>
              <MultiTerminal
                commands={[
                  { command: 'ls -l $XDG_RUNTIME_DIR/garclip.sock', comment: 'Check socket exists' },
                  { command: 'garclip daemon &', comment: 'Start daemon if not running' },
                  { command: 'garclipctl status', comment: 'Test connection' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Clipboard not being captured</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check X11 connection and XFixes:</p>
              <MultiTerminal
                commands={[
                  { command: 'echo $DISPLAY', comment: 'Verify DISPLAY is set' },
                  { command: 'xdpyinfo | grep XFIXES', comment: 'Check XFixes extension' },
                  { command: 'RUST_LOG=debug garclip daemon', comment: 'Run with debug logging' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Content being filtered unexpectedly</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check filter configuration:</p>
              <MultiTerminal
                commands={[
                  { command: 'cat ~/.config/garclip/config.toml | grep -A5 filters', comment: 'Check filters' },
                  { command: 'RUST_LOG=garclip=trace garclip daemon', comment: 'Trace filtering decisions' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">garclip-picker won't open</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check X11 and daemon connection:</p>
              <MultiTerminal
                commands={[
                  { command: 'DISPLAY=:0 garclip-picker', comment: 'Ensure DISPLAY is set' },
                  { command: 'garclipctl status', comment: 'Verify daemon is running' },
                  { command: 'RUST_LOG=debug garclip-picker', comment: 'Run with debug output' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">History not persisting</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check persistence settings and file:</p>
              <MultiTerminal
                commands={[
                  { command: 'cat ~/.config/garclip/config.toml | grep persist', comment: 'Check persist setting' },
                  { command: 'ls -l ~/.local/share/garclip/', comment: 'Check history file' },
                  { command: 'cat ~/.local/share/garclip/history.json | head', comment: 'Inspect history' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Enable verbose logging</h4>
              <MultiTerminal
                commands={[
                  { command: 'RUST_LOG=garclip=trace garclip daemon', comment: 'Maximum verbosity' },
                  { command: 'RUST_LOG=debug garclipctl history', comment: 'Debug CLI operations' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Reload configuration</h4>
              <MultiTerminal
                commands={[
                  { command: 'garclipctl reload', comment: 'Reload via IPC' },
