            <!-- gar Integration -->
            <div slot="doc-17">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">gar Integration</h3>
              <p class="text-gar-text-secondary mb-4">
                garlaunch integrates with gar window manager for window switching mode.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">GarClient</h4>
              <p class="text-gar-text-secondary mb-4">
                The GarClient struct handles IPC communication with gar via Unix socket.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Socket Path</h4>
              <p class="text-gar-text-secondary mb-4">
                $XDG_RUNTIME_DIR/gar.sock (fallback: /tmp/gar.sock)
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">IPC Methods</h4>
              <div class="overflow-x-auto mb-4">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-gar-text-muted/20">
                      <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Method</th>
                      <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Request</th>
                      <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Response</th>
                    </tr>
                  </thead>
                  <tbody class="text-gar-text-secondary">
                    <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono">get_windows</td><td class="py-2 px-3">{`{"command": "get_windows"}`}</td><td class="py-2 px-3">Array of WindowInfo</td></tr>
                    <tr><td class="py-2 px-3 font-mono">focus_window</td><td class="py-2 px-3">{`{"command": "focus_window", "args": {"id": 123}}`}</td><td class="py-2 px-3">Success/error</td></tr>
                  </tbody>
                </table>
