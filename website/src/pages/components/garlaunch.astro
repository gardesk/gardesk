            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">garlaunch window doesn't appear</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check display and X11 connection:</p>
              <MultiTerminal
                commands={[
                  { command: 'echo $DISPLAY', comment: 'Should show :0 or similar' },
