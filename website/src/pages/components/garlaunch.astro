              <h4 class="font-semibold text-gar-text-primary mb-2">Window mode shows no windows</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check gar connection:</p>
              <MultiTerminal
                commands={[
                  { command: 'ls -l $XDG_RUNTIME_DIR/gar.sock', comment: 'Verify gar socket exists' },
                  { command: 'pgrep gar', comment: 'Check if gar is running' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Window mode requires gar window manager to be running.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Script mode fails</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Debug script issues:</p>
              <MultiTerminal
                commands={[
                  { command: 'chmod +x ./myscript.sh', comment: 'Ensure script is executable' },
                  { command: './myscript.sh', comment: 'Test script directly' },
                  { command: 'echo "{}" | ./myscript.sh', comment: 'Test with selection input' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Script must output valid JSON on first line.
              </p>
