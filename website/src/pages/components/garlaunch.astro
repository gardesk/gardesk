            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">No desktop applications found (drun mode)</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify .desktop file locations:</p>
              <MultiTerminal
                commands={[
                  { command: 'ls /usr/share/applications', comment: 'System applications' },
