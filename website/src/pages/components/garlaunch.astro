              <p class="text-gar-text-secondary text-sm mb-3">Check daemon status:</p>
              <MultiTerminal
                commands={[
                  { command: 'pgrep -x garlaunch', comment: 'Check if daemon running' },
                  { command: 'ls -l $XDG_RUNTIME_DIR/garlaunch.sock', comment: 'Check socket exists' },
                  { command: 'garlaunch --daemon &', comment: 'Start daemon' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                garlaunchctl falls back to direct launch if daemon isn't running.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
