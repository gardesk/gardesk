  "selected": {
    "id": "item1",
    "name": "First Item",
    "description": "Optional description",
    "icon": "optional-icon-name",
    "data": {"custom": "data"}
  }
}`}</code></pre>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Action Response</h4>
