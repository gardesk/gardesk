  "items": [
    {
      "id": "item1",
      "name": "First Item",
      "description": "Optional description",
      "icon": "optional-icon-name",
      "data": {"custom": "data"}
    },
    {
      "id": "item2",
      "name": "Second Item"
    }
  ]
}`}</code></pre>
