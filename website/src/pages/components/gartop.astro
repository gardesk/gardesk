          </DocsSidebar>
        </div>

        <!-- Tab 3: IPC/API -->
        <div slot="tab-3">
          <h2 class="text-2xl font-bold text-gar-text-primary mb-6">IPC Protocol</h2>

          <p class="text-gar-text-secondary mb-6">
            gartop exposes an IPC interface via Unix socket. The <code class="bg-gar-bg-secondary px-1 rounded">gartopctl</code> CLI provides easy access to daemon functionality.
          </p>

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Socket Location</h3>
          <MultiTerminal
            title="socket"
            commands={[
              { command: "$XDG_RUNTIME_DIR/gartop.sock", comment: "Default location" },
              { command: "/run/user/1000/gartop.sock", comment: "Typical path" },
            ]}
            class="mb-6"
          />

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">gartopctl Commands</h3>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: "gartopctl status", comment: "Daemon version, uptime, intervals" },
              { command: "gartopctl cpu", comment: "Current CPU stats" },
              { command: "gartopctl memory", comment: "Current memory stats" },
              { command: "gartopctl cpu-history --count 20", comment: "Last 20 CPU samples" },
              { command: "gartopctl memory-history --count 20", comment: "Last 20 memory samples" },
              { command: "gartopctl processes --sort cpu --limit 10", comment: "Top 10 by CPU" },
              { command: "gartopctl processes --sort memory --limit 5", comment: "Top 5 by memory" },
              { command: "gartopctl kill 1234", comment: "Kill PID 1234 (SIGTERM)" },
              { command: "gartopctl kill 1234 --signal 9", comment: "Kill PID 1234 (SIGKILL)" },
              { command: "gartopctl reload", comment: "Reload configuration" },
              { command: "gartopctl quit", comment: "Shutdown daemon" },
            ]}
            class="mb-6"
          />

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">JSON Protocol</h3>
          <p class="text-gar-text-secondary mb-4">
            Commands are sent as JSON lines over the Unix socket:
          </p>

          <div class="space-y-4 mb-6">
            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h4 class="font-semibold text-gar-accent-green mb-2">Request Examples</h4>
              <MultiTerminal
                title="json"
                commands={[
                  { command: '{"command": "status"}', comment: "" },
                  { command: '{"command": "get_cpu"}', comment: "" },
                  { command: '{"command": "get_memory"}', comment: "" },
                  { command: '{"command": "get_cpu_history", "count": 10}', comment: "" },
                  { command: '{"command": "get_processes", "sort_by": "cpu", "limit": 20}', comment: "" },
                  { command: '{"command": "kill_process", "pid": 1234, "signal": 15}', comment: "" },
                ]}
              />
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h4 class="font-semibold text-gar-accent-green mb-2">Response Format</h4>
              <MultiTerminal
                title="json"
                commands={[
                  { command: '{"success": true, "data": {...}}', comment: "Success" },
                  { command: '{"success": false, "error": "message"}', comment: "Error" },
                ]}
              />
            </div>
          </div>

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Event Subscriptions</h3>
          <p class="text-gar-text-secondary mb-4">
            Subscribe to real-time updates:
          </p>
          <ul class="space-y-1 text-gar-text-secondary text-sm">
            <li>• <code class="bg-gar-bg-secondary px-1 rounded">cpu_update</code> - CPU stats changed</li>
            <li>• <code class="bg-gar-bg-secondary px-1 rounded">memory_update</code> - Memory stats changed</li>
            <li>• <code class="bg-gar-bg-secondary px-1 rounded">process_update</code> - Process list changed</li>
            <li>• <code class="bg-gar-bg-secondary px-1 rounded">network_update</code> - Network stats changed</li>
            <li>• <code class="bg-gar-bg-secondary px-1 rounded">disk_update</code> - Disk stats changed</li>
            <li>• <code class="bg-gar-bg-secondary px-1 rounded">temp_update</code> - Temperature changed</li>
            <li>• <code class="bg-gar-bg-secondary px-1 rounded">gpu_update</code> - GPU stats changed</li>
          </ul>
        </div>

        <!-- Tab 4: Troubleshooting -->
        <div slot="tab-4">
          <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Troubleshooting</h2>

          <div class="space-y-6">
            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-green mb-2">gartopctl: connection refused</h3>
              <p class="text-gar-text-secondary mb-3">
                The daemon is not running or socket doesn't exist.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Start daemon: <code class="bg-gar-bg-secondary px-1 rounded">gartop daemon</code></li>
                <li>• Check socket: <code class="bg-gar-bg-secondary px-1 rounded">ls $XDG_RUNTIME_DIR/gartop.sock</code></li>
                <li>• Check systemd: <code class="bg-gar-bg-secondary px-1 rounded">systemctl --user status gartop</code></li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-green mb-2">Missing temperature sensors</h3>
              <p class="text-gar-text-secondary mb-3">
                Temperature readings require hwmon kernel modules.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Check sensors: <code class="bg-gar-bg-secondary px-1 rounded">ls /sys/class/hwmon/</code></li>
                <li>• Load modules: <code class="bg-gar-bg-secondary px-1 rounded">modprobe coretemp</code> or <code class="bg-gar-bg-secondary px-1 rounded">modprobe k10temp</code></li>
                <li>• Install lm-sensors: <code class="bg-gar-bg-secondary px-1 rounded">sensors-detect</code></li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-green mb-2">No GPU metrics</h3>
              <p class="text-gar-text-secondary mb-3">
                GPU metrics require DRM sysfs files (AMD/Intel).
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Check DRM: <code class="bg-gar-bg-secondary px-1 rounded">ls /sys/class/drm/card*/device/</code></li>
                <li>• NVIDIA GPUs require separate tooling (nvidia-smi)</li>
                <li>• Some integrated GPUs may not expose utilization metrics</li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-green mb-2">High CPU usage from gartop itself</h3>
              <p class="text-gar-text-secondary mb-3">
                Reduce collection frequency or GUI refresh rate.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Increase <code class="bg-gar-bg-secondary px-1 rounded">sample_interval_ms</code> (e.g., 2000)</li>
                <li>• Reduce <code class="bg-gar-bg-secondary px-1 rounded">refresh_rate</code> (e.g., 15)</li>
                <li>• Reduce <code class="bg-gar-bg-secondary px-1 rounded">max_processes</code> (e.g., 50)</li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-green mb-2">Debug logging</h3>
              <p class="text-gar-text-secondary mb-3">
                Enable debug output to diagnose issues:
              </p>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: "RUST_LOG=debug gartop daemon --foreground", comment: "Full debug" },
                  { command: "RUST_LOG=gartop=debug gartop", comment: "gartop only" },
                ]}
              />
            </div>
          </div>
        </div>

      </TabbedCard>
    </div>
  </main>

