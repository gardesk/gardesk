        <!-- Tab 3: IPC/API -->
        <div slot="tab-3">
          <h2 class="text-2xl font-bold text-gar-text-primary mb-6">IPC Protocol</h2>

          <p class="text-gar-text-secondary mb-6">
            gargears exposes an IPC interface when running in daemon mode. The CLI tool <code class="bg-gar-bg-secondary px-1 rounded">gargearsctl</code> communicates with the daemon via Unix socket.
          </p>

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Socket Location</h3>
          <MultiTerminal
            title="socket"
            commands={[
              { command: "$XDG_RUNTIME_DIR/gargears.sock", comment: "Default location" },
              { command: "/run/user/1000/gargears.sock", comment: "Typical path" },
            ]}
            class="mb-6"
          />

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">gargearsctl Commands</h3>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: "gargearsctl show", comment: "Show gargears window" },
              { command: "gargearsctl hide", comment: "Hide gargears window" },
              { command: "gargearsctl toggle", comment: "Toggle window visibility" },
              { command: "gargearsctl status", comment: "Get daemon status (JSON)" },
              { command: "gargearsctl quit", comment: "Stop the daemon" },
            ]}
            class="mb-6"
          />

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">JSON Protocol</h3>
          <p class="text-gar-text-secondary mb-4">
            Commands are sent as JSON objects over the Unix socket:
          </p>

          <div class="space-y-4 mb-6">
            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h4 class="font-semibold text-gar-accent-purple mb-2">Request Format</h4>
              <MultiTerminal
                title="json"
                commands={[
                  { command: '{ "command": "show" }', comment: "" },
                  { command: '{ "command": "hide" }', comment: "" },
                  { command: '{ "command": "toggle" }', comment: "" },
                  { command: '{ "command": "status" }', comment: "" },
                  { command: '{ "command": "quit" }', comment: "" },
                ]}
              />
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h4 class="font-semibold text-gar-accent-purple mb-2">Response Format</h4>
              <MultiTerminal
                title="json"
                commands={[
                  { command: '{ "success": true }', comment: "Success response" },
                  { command: '{ "success": false, "error": "message" }', comment: "Error response" },
                  { command: '{ "success": true, "data": { "visible": true, "running": true } }', comment: "Status response" },
                ]}
              />
            </div>
          </div>

          <h3 class="text-lg font-semibold text-gar-text-primary mb-3">Keybinding Integration</h3>
          <p class="text-gar-text-secondary mb-4">
            Bind gargearsctl to a key in your gar configuration for quick access:
          </p>
          <MultiTerminal
            title="~/.config/gar/init.lua"
            commands={[
              { command: '-- Toggle gargears with Super+G', comment: "" },
              { command: 'gar.bind("Super", "g", function()', comment: "" },
              { command: '  gar.spawn("gargearsctl toggle")', comment: "" },
              { command: 'end)', comment: "" },
            ]}
            class="mb-4"
          />
        </div>

        <!-- Tab 4: Troubleshooting -->
        <div slot="tab-4">
          <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Troubleshooting</h2>

          <div class="space-y-6">
            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-purple mb-2">Daemon not connecting to components</h3>
              <p class="text-gar-text-secondary mb-3">
                gargears shows red status indicators for components it can't connect to.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Verify the component is running: <code class="bg-gar-bg-secondary px-1 rounded">pidof gar</code></li>
                <li>• Check socket exists: <code class="bg-gar-bg-secondary px-1 rounded">ls $XDG_RUNTIME_DIR/*.sock</code></li>
                <li>• gargears retries connections every 5 seconds automatically</li>
                <li>• Check component logs for IPC errors</li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-purple mb-2">Changes not persisting after restart</h3>
              <p class="text-gar-text-secondary mb-3">
                Apply sends changes to the running daemon but doesn't save to disk.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Use the <strong>Save</strong> button to write to config files</li>
                <li>• Verify config file permissions: <code class="bg-gar-bg-secondary px-1 rounded">ls -la ~/.config/gar/</code></li>
                <li>• Check that the config directory exists</li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-purple mb-2">gargearsctl: connection refused</h3>
              <p class="text-gar-text-secondary mb-3">
                The daemon is not running or socket doesn't exist.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Start daemon: <code class="bg-gar-bg-secondary px-1 rounded">gargears --daemon</code></li>
                <li>• Check socket: <code class="bg-gar-bg-secondary px-1 rounded">ls $XDG_RUNTIME_DIR/gargears.sock</code></li>
                <li>• Verify XDG_RUNTIME_DIR is set: <code class="bg-gar-bg-secondary px-1 rounded">echo $XDG_RUNTIME_DIR</code></li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-purple mb-2">Window doesn't appear</h3>
              <p class="text-gar-text-secondary mb-3">
                In daemon mode, the window starts hidden.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Run <code class="bg-gar-bg-secondary px-1 rounded">gargearsctl show</code> to display the window</li>
                <li>• For immediate display, run without <code class="bg-gar-bg-secondary px-1 rounded">--daemon</code> flag</li>
                <li>• Check if another gargears instance is running</li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-purple mb-2">Instant apply not working</h3>
              <p class="text-gar-text-secondary mb-3">
                Changes aren't being applied in real-time.
              </p>
              <ul class="space-y-2 text-gar-text-secondary text-sm">
                <li>• Press <code class="bg-gar-bg-secondary px-1 rounded">I</code> to enable instant apply mode</li>
                <li>• Check status indicator shows instant apply is active</li>
                <li>• Verify the component daemon is connected (green indicator)</li>
              </ul>
            </div>

            <div class="bg-gar-bg-secondary/30 rounded-lg p-4 border border-gar-text-muted/10">
              <h3 class="text-lg font-semibold text-gar-accent-purple mb-2">Debug logging</h3>
              <p class="text-gar-text-secondary mb-3">
                Enable debug output to diagnose issues:
              </p>
              <MultiTerminal
                title="terminal"
                commands={[
                  { command: "RUST_LOG=debug gargears", comment: "Full debug output" },
                  { command: "RUST_LOG=gargears=debug gargears", comment: "gargears only" },
                  { command: "RUST_LOG=info gargears --daemon --no-fork", comment: "Daemon with logs" },
                ]}
              />
            </div>
          </div>
        </div>

      </TabbedCard>
    </div>
  </main>

  <Footer />
</BaseLayout>
