                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`gar.terminal.sessions = {
    webdev = {
        tabs = {
            { title = "Frontend", cwd = "~/app/frontend", cmd = "npm run dev" },
            { title = "Backend", cwd = "~/app/backend", cmd = "cargo watch -x run" },
