                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`gar.terminal.keybinds = {
    ["alt+e"] = function()
        gar.terminal.split({ direction = "vertical" })
        gar.terminal.send_text(nil, "nvim .\\n")
    end,
}`}</code></pre>
