---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ImageCarousel from '../../components/ui/ImageCarousel.astro';
import TabbedCard from '../../components/ui/TabbedCard.astro';
import MultiTerminal from '../../components/ui/MultiTerminal.astro';
import DocsSidebar from '../../components/ui/DocsSidebar.astro';

const gartermImages = [
  { src: '/images/thumbs/garterm1.png', alt: 'garterm terminal - default view' },
  { src: '/images/thumbs/garterm2.png', alt: 'garterm terminal - split panes' },
  { src: '/images/thumbs/garterm3.png', alt: 'garterm terminal - tabs' },
  { src: '/images/thumbs/garterm4.png', alt: 'garterm terminal - color themes' },
  { src: '/images/thumbs/garterm5.png', alt: 'garterm terminal - configuration' },
];

const tabs = [
  { id: 'getting-started', label: 'Getting Started' },
  { id: 'config', label: 'Config' },
  { id: 'docs', label: 'Docs' },
  { id: 'keybinds', label: 'Keybinds' },
  { id: 'ipc', label: 'IPC/API' },
  { id: 'troubleshooting', label: 'Troubleshooting' },
];

const docsItems = [
  {
    id: 'overview',
    label: 'Overview',
  },
  {
    id: 'architecture',
    label: 'Architecture',
    children: [
      { id: 'workspace', label: 'Workspace Structure' },
      { id: 'rendering', label: 'GPU Rendering' },
    ]
  },
  {
    id: 'terminal',
    label: 'Terminal Emulation',
    children: [
      { id: 'escape-sequences', label: 'Escape Sequences' },
      { id: 'mouse-support', label: 'Mouse Support' },
      { id: 'clipboard', label: 'Clipboard' },
    ]
  },
  {
    id: 'ui-features',
    label: 'UI Features',
    children: [
      { id: 'tabs', label: 'Tab Management' },
      { id: 'splits', label: 'Pane Splits' },
      { id: 'selection', label: 'Text Selection' },
      { id: 'search', label: 'Search' },
      { id: 'scrollback', label: 'Scrollback' },
    ]
  },
  {
    id: 'color-themes',
    label: 'Color Themes',
  },
  {
    id: 'gar-integration',
    label: 'gar Integration',
  },
  {
    id: 'sessions',
    label: 'Sessions',
  },
];
---

<BaseLayout title="garterm - gardesk" description="GPU-accelerated terminal emulator with tabs, splits, and deep gar integration. VT100-compatible with 8 color themes.">
  <Header />

  <main class="pt-24 pb-20 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Hero -->
      <div class="mb-12">
        <Badge status="beta" class="mb-4" />
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <span class="text-gar-accent-cyan">garterm</span>
        </h1>
        <p class="text-xl text-gar-text-secondary mb-6">GPU-Accelerated Terminal Emulator</p>
        <p class="text-gar-text-secondary leading-relaxed mb-8">
          A fast terminal emulator with GPU-accelerated rendering via wgpu. Features tabbed interface with split panes,
          VT100-compatible terminal emulation, 8 built-in color themes, and deep integration with gar's Lua configuration.
          Control running instances via gartermctl for scripting and automation.
        </p>

        <div class="flex flex-wrap gap-4">
          <Button href="https://github.com/gardesk/garterm" variant="primary">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </Button>
          <Button href="/#install" variant="secondary">
            Install
          </Button>
        </div>
      </div>

      <!-- Screenshots -->
      <div class="mb-12">
        <ImageCarousel images={gartermImages} />
      </div>

      <!-- Features Grid -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            'GPU-accelerated rendering with wgpu',
            'Tabbed interface with horizontal/vertical splits',
            'VT100/xterm-compatible terminal emulation',
            '8 built-in color themes (Tokyo Night, Catppuccin, etc.)',
            'Lua + TOML configuration',
            'Deep integration with gar window manager',
            'IPC control via gartermctl',
            'Declarative session management',
            'Text selection (normal, line, block modes)',
            'Incremental search with highlighting',
            '10,000 line scrollback buffer',
            'Mouse support (X10, SGR, urxvt encodings)',
            'OSC 52 clipboard operations',
            'Shell integration (OSC 133)',
            'Font fallbacks with Nerd Font support',
            'Configurable tab bar with path shortening',
          ].map(function(feature) {
            return (
              <li class="flex items-start gap-3 p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/10">
                <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-gar-accent-cyan" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gar-text-primary">{feature}</span>
              </li>
            )
          })}
        </ul>
      </section>

      <!-- Tabbed Documentation Card -->
      <TabbedCard tabs={tabs} defaultTab="getting-started" class="mb-12">

        <!-- Getting Started Tab -->
        <div slot="tab-0">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Quick Start Guide</h3>

          <p class="text-gar-text-secondary mb-6">
            Get garterm running standalone or integrated with the gar window manager.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">1. Installation</h4>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'curl -fsSL https://gar.musicsian.com/install.sh | bash -s -- --component=garterm', comment: 'Install via script' },
              { command: 'cd ~/.local/src/gardesk/garterm && cargo build --release', comment: 'Or build from source' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">2. Running garterm</h4>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'garterm', comment: 'Start with default config' },
              { command: 'garterm --shell /bin/zsh', comment: 'Start with specific shell' },
              { command: 'garterm --font-size 14', comment: 'Custom font size' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">3. Configuration</h4>
          <p class="text-gar-text-secondary mb-4">
            Create a configuration file or integrate with gar:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'mkdir -p ~/.config/garterm', comment: 'Create config directory' },
              { command: '$EDITOR ~/.config/garterm/config.toml', comment: 'Edit TOML config (standalone)' },
              { command: '$EDITOR ~/.config/gar/init.lua', comment: 'Or configure via gar.terminal table' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">4. Control with gartermctl</h4>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'gartermctl new-tab', comment: 'Open new tab' },
              { command: 'gartermctl split --horizontal', comment: 'Split pane horizontally' },
              { command: 'gartermctl next-tab', comment: 'Switch to next tab' },
              { command: 'gartermctl send "ls -la\\n"', comment: 'Send text to terminal' },
              { command: 'gartermctl load-session webdev', comment: 'Load named session' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">5. Basic Navigation</h4>
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary">Action</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary">Keybind</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3">New tab</td>
                  <td class="py-2 px-3 font-mono text-gar-accent-cyan">Ctrl+Shift+T</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3">Close tab</td>
                  <td class="py-2 px-3 font-mono text-gar-accent-cyan">Ctrl+Shift+W</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3">Next/prev tab</td>
                  <td class="py-2 px-3 font-mono text-gar-accent-cyan">Alt+] / Alt+[</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3">Split vertical</td>
                  <td class="py-2 px-3 font-mono text-gar-accent-cyan">Ctrl+Shift+Enter</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3">Split horizontal</td>
                  <td class="py-2 px-3 font-mono text-gar-accent-cyan">Ctrl+Shift+\</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3">Focus direction</td>
                  <td class="py-2 px-3 font-mono text-gar-accent-cyan">Alt+Arrow</td>
                </tr>
                <tr class="border-b border-gar-text-muted/10">
                  <td class="py-2 px-3">Search</td>
                  <td class="py-2 px-3 font-mono text-gar-accent-cyan">Ctrl+Shift+F</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Config Tab -->
        <div slot="tab-1">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Configuration Reference</h3>

          <p class="text-gar-text-secondary mb-6">
            garterm can be configured via TOML at <code class="text-gar-accent-cyan">~/.config/garterm/config.toml</code>
            or via Lua in gar's <code class="text-gar-accent-cyan">~/.config/gar/init.lua</code>.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Full Configuration Example</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/garterm/config.toml</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`[general]
shell = "/bin/zsh"
shell_args = ["-l"]
working_directory = "~"
vsync = true
log_level = "info"

[font]
family = "JetBrains Mono"
size = 14.0
bold_family = "JetBrains Mono Bold"
italic_family = "JetBrains Mono Italic"
bold_is_bright = false
letter_spacing = 0
line_spacing = 0

[window]
title = "garterm"
class = "garterm"
padding = [8, 8]
columns = 120
rows = 36
opacity = 1.0

[terminal]
scrollback_lines = 10000
scroll_lines = 3
bracketed_paste = true
clipboard_write = true
clipboard_read = false    # Security: disabled by default
close_on_exit = true
term = "xterm-256color"

[colors]
preset = "tokyo_night"
# Override individual colors:
# foreground = "#c0caf5"
# background = "#1a1b26"
# cursor = "#c0caf5"

[mouse]
copy_on_select = true
middle_click_paste = true
right_click = "paste"
word_chars = "-_"

[bell]
visual = true
visual_duration_ms = 100
audio = false

[tab_bar]
height = 24
position = "top"
show_single_tab = false
max_tab_width = 200
shorten_paths = true`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Lua Configuration (with gar)</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/gar/init.lua</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`gar.terminal = {
    shell = "/bin/zsh",
    font = {
        family = "JetBrains Mono",
        size = 14.0,
    },
    colors = {
        preset = "catppuccin",
    },
    tab_bar = {
        height = 28,
        position = "top",
        show_single_tab = false,
        shorten_paths = true,
    },
    -- Named sessions for quick workspace setup
    sessions = {
        webdev = {
            tabs = {
                { title = "Frontend", cwd = "~/app", cmd = "npm run dev" },
                { title = "Backend", cmd = "python manage.py runserver" },
                { title = "Shell" },
            }
        },
    },
}`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Configuration Priority</h4>
          <ol class="list-decimal list-inside text-gar-text-secondary mb-4 space-y-1">
            <li>CLI arguments (highest priority)</li>
            <li>Lua config (<code class="text-gar-accent-cyan">gar.terminal</code> table)</li>
            <li>TOML config (<code class="text-gar-accent-cyan">~/.config/garterm/config.toml</code>)</li>
            <li>Built-in defaults (lowest priority)</li>
          </ol>
        </div>

        <!-- Docs Tab -->
        <div slot="tab-2">
          <DocsSidebar items={docsItems} defaultItem="overview">

            <!-- doc-0: Overview -->
            <div slot="doc-0">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Overview</h3>
              <p class="text-gar-text-secondary mb-4">
                garterm is a GPU-accelerated terminal emulator designed for the gardesk X11 desktop environment.
                It features modern rendering with wgpu, a tabbed interface with split panes, and deep integration
                with gar's Lua configuration system.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Key Components</h4>
              <div class="overflow-x-auto mb-4">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-gar-text-muted/20">
                      <th class="text-left py-2 px-3 text-gar-text-primary">Binary</th>
                      <th class="text-left py-2 px-3 text-gar-text-primary">Purpose</th>
                    </tr>
                  </thead>
                  <tbody class="text-gar-text-secondary">
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2 px-3 font-mono text-gar-accent-cyan">garterm</td>
                      <td class="py-2 px-3">Main terminal emulator daemon</td>
                    </tr>
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2 px-3 font-mono text-gar-accent-cyan">gartermctl</td>
                      <td class="py-2 px-3">Control client for IPC commands</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Dependencies</h4>
              <ul class="list-disc list-inside text-gar-text-secondary mb-4 space-y-1">
                <li><strong>wgpu</strong> - GPU-accelerated rendering</li>
                <li><strong>fontdue</strong> - Font rasterization</li>
                <li><strong>vte</strong> - VT100 terminal parsing</li>
                <li><strong>gartk</strong> - X11 window integration</li>
                <li><strong>mlua</strong> - Lua configuration support</li>
              </ul>
            </div>

            <!-- doc-1: Architecture (parent) -->
            <div slot="doc-1">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Architecture</h3>
              <p class="text-gar-text-secondary mb-4">
                garterm is built as a Rust workspace with three crates. Select a topic from the sidebar to learn more.
              </p>
            </div>

            <!-- doc-2: Workspace Structure -->
            <div slot="doc-2">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Workspace Structure</h3>
              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-4">
                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`garterm/
├── garterm/           # Main terminal emulator
│   └── src/
│       ├── app.rs         # Application logic, event loop
│       ├── config/        # Config loading (TOML + Lua)
│       ├── terminal/      # VTE parsing, grid, cursor
│       ├── render/        # GPU rendering pipeline
│       ├── ui/            # Tabs, panes, splits
│       ├── input/         # Keyboard, mouse, clipboard
│       ├── pty/           # PTY management
│       └── ipc.rs         # IPC server
├── garterm-ipc/       # Shared IPC protocol types
└── gartermctl/        # Control CLI client`}</code></pre>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Event Loop</h4>
              <p class="text-gar-text-secondary mb-4">
                The main loop runs at ~60fps (16ms intervals):
              </p>
              <ol class="list-decimal list-inside text-gar-text-secondary mb-4 space-y-1">
                <li>Poll signals and X11 file descriptors</li>
                <li>Handle signals (SIGHUP for config reload)</li>
                <li>Process X11 events (keyboard, mouse, resize)</li>
                <li>Read PTY data from all panes (non-blocking)</li>
                <li>Render dirty panes to GPU</li>
              </ol>
            </div>

            <!-- doc-3: GPU Rendering -->
            <div slot="doc-3">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">GPU Rendering</h3>
              <p class="text-gar-text-secondary mb-4">
                garterm uses wgpu for GPU-accelerated rendering, providing smooth scrolling and efficient text display.
              </p>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Rendering Pipeline</h4>
              <ol class="list-decimal list-inside text-gar-text-secondary mb-4 space-y-1">
                <li><strong>Vertex Generation</strong> - Emit quads for each visible cell</li>
                <li><strong>Glyph Atlas</strong> - Cache rasterized glyphs in GPU texture</li>
                <li><strong>Shader Rendering</strong> - Sample atlas for glyphs, solid colors for backgrounds</li>
                <li><strong>Compositing</strong> - Alpha blending for selection overlay</li>
              </ol>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Font Handling</h4>
              <p class="text-gar-text-secondary mb-4">
                Fonts are loaded with automatic fallbacks:
              </p>
              <ol class="list-decimal list-inside text-gar-text-secondary mb-4 space-y-1">
                <li>JetBrains Mono (with Nerd Font variants)</li>
                <li>DejaVu Sans Mono</li>
                <li>Noto Sans Mono</li>
                <li>System monospace fallback</li>
              </ol>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">VSync Mode</h4>
              <p class="text-gar-text-secondary mb-4">
                Configure via <code class="text-gar-accent-cyan">vsync</code> option:
              </p>
              <ul class="list-disc list-inside text-gar-text-secondary mb-4 space-y-1">
                <li><strong>true</strong> - Only render when dirty (lower CPU)</li>
                <li><strong>false</strong> - Continuous 60fps (required on some systems)</li>
              </ul>
            </div>

            <!-- doc-4: Terminal Emulation (parent) -->
            <div slot="doc-4">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Terminal Emulation</h3>
              <p class="text-gar-text-secondary mb-4">
                garterm provides VT100/xterm-compatible terminal emulation using the vte crate.
                Select a topic from the sidebar for details.
              </p>
            </div>

            <!-- doc-5: Escape Sequences -->
            <div slot="doc-5">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Escape Sequences</h3>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Supported Terminal Modes</h4>
              <div class="overflow-x-auto mb-4">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-gar-text-muted/20">
                      <th class="text-left py-2 px-3 text-gar-text-primary">Mode</th>
                      <th class="text-left py-2 px-3 text-gar-text-primary">Code</th>
                      <th class="text-left py-2 px-3 text-gar-text-primary">Description</th>
                    </tr>
                  </thead>
                  <tbody class="text-gar-text-secondary">
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2 px-3 font-mono">DECCKM</td>
                      <td class="py-2 px-3 font-mono">1</td>
                      <td class="py-2 px-3">Application cursor keys</td>
                    </tr>
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2 px-3 font-mono">DECAWM</td>
                      <td class="py-2 px-3 font-mono">7</td>
                      <td class="py-2 px-3">Auto-wrap mode</td>
                    </tr>
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2 px-3 font-mono">DECTCEM</td>
                      <td class="py-2 px-3 font-mono">25</td>
                      <td class="py-2 px-3">Cursor visibility</td>
                    </tr>
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2 px-3 font-mono">Alt Screen</td>
                      <td class="py-2 px-3 font-mono">1049</td>
                      <td class="py-2 px-3">Alternate screen buffer</td>
                    </tr>
                    <tr class="border-b border-gar-text-muted/10">
                      <td class="py-2 px-3 font-mono">Bracketed Paste</td>
                      <td class="py-2 px-3 font-mono">2004</td>
                      <td class="py-2 px-3">Wrap pasted text in escape sequences</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">OSC Sequences</h4>
              <div class="overflow-x-auto mb-4">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-gar-text-muted/20">
                      <th class="text-left py-2 px-3 text-gar-text-primary">OSC</th>
                      <th class="text-left py-2 px-3 text-gar-text-primary">Purpose</th>
                    </tr>
