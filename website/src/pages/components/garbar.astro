        <!-- Workflows Tab -->
        <div slot="tab-3">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Common Workflows</h3>

          <p class="text-gar-text-secondary mb-6">
            Practical examples of using garbar with gar and other tools.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Auto-Start with gar</h4>
          <p class="text-gar-text-secondary mb-4">
            The simplest way to use garbar is via gar integration:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/gar/init.lua</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`-- garbar auto-starts when gar.bar is defined
gar.bar = {
    height = 32,
    position = "top",
    background = "#1a1a1a",
    modules_left = {"workspaces", "window_title"},
    modules_right = {"cpu", "memory", "battery", "tray", "datetime"},
}`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Media Player Widget</h4>
          <p class="text-gar-text-secondary mb-4">
            Create an interactive media player widget with playerctl:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`[modules.script.media]
exec = '''
if playerctl status 2>/dev/null | grep -q Playing; then
    echo " $(playerctl metadata --format '{{artist}} - {{title}}' | cut -c1-40)"
elif playerctl status 2>/dev/null | grep -q Paused; then
    echo " $(playerctl metadata --format '{{artist}} - {{title}}' | cut -c1-40)"
else
    echo ""
fi
'''
interval = 1
click_left = "playerctl play-pause"
click_right = "playerctl next"
scroll_up = "playerctl volume 0.05+"
scroll_down = "playerctl volume 0.05-"`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">System Monitor Scripts</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`# Disk usage warning
[modules.script.disk]
exec = "df -h / | awk 'NR==2 {print $5}'"
interval = 60
format = " {output}"

# Network status
[modules.script.network]
exec = "nmcli -t -f DEVICE,STATE device | grep -m1 connected | cut -d: -f1"
interval = 10
format = "󰤨 {output}"

# VPN indicator
[modules.script.vpn]
exec = "nmcli -t -f TYPE,STATE connection show --active | grep -q vpn && echo '󰖂' || echo '󰖃'"
interval = 10

# Unread mail count
[modules.script.mail]
exec = "notmuch count tag:unread"
interval = 60
format = " {output}"`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Toggle Bar Visibility</h4>
          <p class="text-gar-text-secondary mb-4">
            Bind a key in gar to toggle the bar:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">~/.config/gar/init.lua</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`gar.bind("mod+b", function()
    gar.exec("garbarctl toggle")
end)`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Hot Reload</h4>
          <p class="text-gar-text-secondary mb-4">
            Reload configuration without restarting:
          </p>
          <MultiTerminal
            title="terminal"
            commands={[
              { command: 'garbarctl reload', comment: 'Reload config from disk' },
              { command: 'kill -SIGHUP $(pgrep garbar)', comment: 'Or send SIGHUP signal' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Floating Bar Style</h4>
          <p class="text-gar-text-secondary mb-4">
            Create a floating bar with margins and rounded corners:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20">
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`height = 28
opacity = 0.9

[margin]
top = 8.0
right = 8.0
left = 8.0

[border]
radius = 8.0

[shadow]
enabled = true
blur = 12.0
color = "#00000060"
offset = { x = 0.0, y = 4.0 }`}</code></pre>
          </div>
        </div>

        <!-- IPC Tab -->
        <div slot="tab-4">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">IPC Protocol</h3>

          <p class="text-gar-text-secondary mb-6">
            garbar exposes a Unix domain socket for control and status queries.
          </p>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Socket Location</h4>
          <MultiTerminal
            commands={[
              { command: 'echo $XDG_RUNTIME_DIR/garbar.sock', comment: 'Primary socket path' },
              { command: 'ls /tmp/garbar.sock', comment: 'Fallback location' },
            ]}
            class="mb-6"
          />

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">garbarctl Commands</h4>
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gar-text-muted/20">
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Command</th>
                  <th class="text-left py-2 px-3 text-gar-text-primary font-medium">Description</th>
                </tr>
              </thead>
              <tbody class="text-gar-text-secondary">
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">show</td><td class="py-2 px-3">Make bar visible</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">hide</td><td class="py-2 px-3">Hide bar</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">toggle</td><td class="py-2 px-3">Toggle visibility</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">reload</td><td class="py-2 px-3">Reload configuration from disk</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-blue">status</td><td class="py-2 px-3">Query bar status (returns JSON)</td></tr>
                <tr class="border-b border-gar-text-muted/10"><td class="py-2 px-3 font-mono text-gar-accent-green">update &lt;module&gt;</td><td class="py-2 px-3">Force update a specific module</td></tr>
                <tr><td class="py-2 px-3 font-mono text-gar-accent-green">quit</td><td class="py-2 px-3">Gracefully shut down daemon</td></tr>
              </tbody>
            </table>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">JSON Protocol</h4>
          <p class="text-gar-text-secondary mb-4">
            Send JSON objects over the socket for scripting:
          </p>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">Request format</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`{"command": "show"}
{"command": "toggle"}
{"command": "update_module", "module": "cpu"}
{"command": "status"}`}</code></pre>
          </div>

          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">Response format</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`// Success
{"success": true, "error": null}

// Status response
{
  "success": true,
  "data": {
    "visible": true,
    "width": 1920,
    "height": 32,
    "modules_left": ["workspaces", "window_title"],
    "modules_center": [],
    "modules_right": ["cpu", "memory", "datetime"]
  }
}

// Error
{"success": false, "error": "Connection refused"}`}</code></pre>
          </div>

          <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Scripting Example</h4>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">toggle-bar.sh</span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`#!/bin/bash
# Toggle garbar visibility
SOCK="\${XDG_RUNTIME_DIR:-/tmp}/garbar.sock"
echo '{"command": "toggle"}' | nc -U "$SOCK"`}</code></pre>
          </div>
        </div>

        <!-- Troubleshooting Tab -->
        <div slot="tab-5">
          <h3 class="text-xl font-bold text-gar-text-primary mb-4">Troubleshooting</h3>

          <div class="space-y-6">
            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">garbar won't start</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check for errors with debug logging:</p>
              <MultiTerminal
                commands={[
                  { command: 'RUST_LOG=debug garbar', comment: 'Run with debug logging' },
                  { command: 'RUST_LOG=garbar=trace garbar', comment: 'Trace-level logging' },
                ]}
              />
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Workspaces not showing</h4>
              <p class="text-gar-text-secondary text-sm mb-3">The module needs an i3-compatible IPC socket:</p>
              <MultiTerminal
                commands={[
                  { command: 'echo $I3SOCK $SWAYSOCK', comment: 'Check socket env vars' },
                  { command: 'ls -la $XDG_RUNTIME_DIR/*.sock', comment: 'List available sockets' },
                  { command: 'ls -la /tmp/gar*.sock', comment: 'Check gar sockets' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Ensure gar is running and exposes <code class="text-gar-accent-blue">/tmp/gar-i3.sock</code> or set <code class="text-gar-accent-blue">I3SOCK</code>.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Icons not displaying</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Ensure a Nerd Font is installed and configured:</p>
              <MultiTerminal
                commands={[
                  { command: 'fc-list | grep -i nerd', comment: 'Check for Nerd Fonts' },
                  { command: 'fc-list | grep -i "JetBrains"', comment: 'Check for JetBrainsMono' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Install with: <code class="text-gar-accent-blue">sudo pacman -S ttf-jetbrains-mono-nerd</code> (Arch) or download from <a href="https://www.nerdfonts.com" class="text-gar-accent-blue hover:underline">nerdfonts.com</a>.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Config not loading</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify config file syntax:</p>
              <MultiTerminal
                commands={[
                  { command: 'cat ~/.config/garbar/config.toml | tomlq .', comment: 'Validate TOML (requires tomlq)' },
                  { command: 'garbarctl reload', comment: 'Reload after fixing' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Check for missing quotes, unbalanced brackets, or invalid values.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Battery module not showing</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Check power supply detection:</p>
              <MultiTerminal
                commands={[
                  { command: 'ls /sys/class/power_supply/', comment: 'List power devices' },
                  { command: 'cat /sys/class/power_supply/BAT0/type', comment: 'Check device type' },
                  { command: 'cat /sys/class/power_supply/BAT0/capacity', comment: 'Check battery level' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Set <code class="text-gar-accent-blue">device = "BAT0"</code> explicitly if auto-detection fails. Module hides if no battery found.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">System tray icons missing</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Only one app can own the system tray:</p>
              <MultiTerminal
                commands={[
                  { command: 'xprop -root | grep SYSTEM_TRAY', comment: 'Check tray ownership' },
                  { command: 'pgrep -a polybar', comment: 'Check for other bars' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Kill other status bars (polybar, i3bar, waybar) that may own the tray.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">garbarctl: connection refused</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Verify garbar is running:</p>
              <MultiTerminal
                commands={[
                  { command: 'pgrep -x garbar', comment: 'Check if running' },
                  { command: 'ls -la ${XDG_RUNTIME_DIR:-/tmp}/garbar.sock', comment: 'Check socket exists' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Start garbar first: <code class="text-gar-accent-blue">garbar &</code>
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
              <h4 class="font-semibold text-gar-text-primary mb-2">Script module not updating</h4>
              <p class="text-gar-text-secondary text-sm mb-3">Test the script manually:</p>
              <MultiTerminal
                commands={[
                  { command: "sh -c 'your-script-here'", comment: 'Test script execution' },
                  { command: 'garbarctl update script:weather', comment: 'Force refresh' },
                ]}
              />
              <p class="text-gar-text-secondary text-sm mt-3">
                Scripts must exit 0 and output to stdout. Empty output on non-zero exit.
              </p>
            </div>

            <div class="p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/20">
