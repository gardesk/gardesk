            <!-- Animations -->
            <div slot="doc-16">
              <h3 class="text-xl font-bold text-gar-text-primary mb-4">Animations</h3>
              <p class="text-gar-text-secondary mb-4">
                Configure transition animations for bar state changes.
              </p>

              <div class="rounded-lg overflow-hidden border border-gar-text-muted/20 mb-6">
                <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{`[animations]
enabled = true
duration = 150        # Duration in milliseconds
easing = "ease-out-cubic"`}</code></pre>
              </div>

              <h4 class="text-lg font-semibold text-gar-text-primary mb-3">Easing Functions</h4>
              <ul class="list-disc list-inside text-gar-text-secondary space-y-1 text-sm">
                <li><code class="text-gar-accent-blue">linear</code> — Constant speed</li>
                <li><code class="text-gar-accent-blue">ease-in</code> — Start slow, end fast</li>
                <li><code class="text-gar-accent-blue">ease-out</code> — Start fast, end slow</li>
                <li><code class="text-gar-accent-blue">ease-in-out</code> — Slow start and end</li>
                <li><code class="text-gar-accent-blue">ease-out-cubic</code> — Smooth deceleration (default)</li>
              </ul>
            </div>
          </DocsSidebar>
