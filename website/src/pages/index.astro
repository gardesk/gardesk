---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import FeaturesSection from '../components/sections/FeaturesSection.astro';
import ComponentSection from '../components/sections/ComponentSection.astro';
import InstallSection from '../components/sections/InstallSection.astro';

const components = [
  {
    id: 'gar',
    name: 'gar',
    tagline: 'Tiling Window Manager',
    description: 'An event-driven X11 tiling window manager with a binary tree layout engine. Configure everything with Lua, from keybindings to window rules.',
    features: [
      'Binary tree layout with smart splits',
      'Full Lua 5.4 configuration',
      'Multi-monitor workspace support',
      'EWMH compliant for compatibility',
      'Unix socket IPC with garctl'
    ],
    status: 'stable' as const,
    imagePosition: 'left' as const,
    imageAlt: 'gar window manager screenshot',
    accentColor: 'blue',
    images: [
      { src: '/images/thumbs/gar1.png', alt: 'gar window manager with tiled terminals' },
      { src: '/images/thumbs/gar2.png', alt: 'gar window manager desktop view' },
      { src: '/images/thumbs/gar3.png', alt: 'gar window manager screenshot' }
    ]
  },
  {
    id: 'garfield',
    name: 'garfield',
    tagline: 'File Manager',
    description: 'A multi-paned graphical file manager with tabbed navigation, multiple view modes, and full file operations. Features undo/redo, Freedesktop trash support, and IPC control.',
    features: [
      'List, grid, and column view modes',
      'Multi-tab, split-pane layouts',
      'Copy, move, trash with undo/redo',
      'Bookmarks and XDG places sidebar',
      'Inline rename and conflict resolution'
    ],
    status: 'beta' as const,
    imagePosition: 'right' as const,
    imageAlt: 'garfield file manager screenshot',
    accentColor: 'orange',
    images: [
      { src: '/images/thumbs/garfield1.png', alt: 'garfield file manager - list view' },
      { src: '/images/thumbs/garfield2.png', alt: 'garfield file manager - grid view' },
      { src: '/images/thumbs/garfield3.png', alt: 'garfield file manager - column view' },
      { src: '/images/thumbs/garfield4.png', alt: 'garfield file manager - split panes' },
      { src: '/images/thumbs/garfield5.png', alt: 'garfield file manager - conflict dialog' },
      { src: '/images/thumbs/garfield6.png', alt: 'garfield file manager - bookmarks' }
    ]
  },
  {
    id: 'garbar',
    name: 'garbar',
    tagline: 'Async Status Bar',
    description: 'A Tokio-powered status bar with modular widgets and Cairo/Pango rendering. Displays system info, workspaces, and more.',
    features: [
      'Async module architecture',
      'Cairo/Pango vector rendering',
      'Battery, CPU, memory widgets',
      'Workspace and window title display',
      'System tray support'
    ],
    status: 'stable' as const,
    imagePosition: 'right' as const,
    imageAlt: 'garbar status bar screenshot',
    accentColor: 'green',
    images: [
      { src: '/images/thumbs/garbar1.png', alt: 'garbar status bar screenshot - default theme' },
      { src: '/images/thumbs/garbar2.png', alt: 'garbar status bar screenshot - modules view' },
      { src: '/images/thumbs/garbar3.png', alt: 'garbar status bar screenshot - custom config' }
    ]
  },
  {
    id: 'gartray',
    name: 'gartray',
    tagline: 'System Tray',
    description: 'A system tray with quick settings panel. Supports XEMBED and StatusNotifierItem protocols, with controls for volume, brightness, network, bluetooth, and power.',
    features: [
      'XEMBED and StatusNotifierItem support',
      'Quick settings panel (volume, brightness)',
      'Network and bluetooth controls',
      'Battery status and power options',
      'D-Bus integration via zbus'
    ],
    status: 'beta' as const,
    imagePosition: 'left' as const,
    imageAlt: 'gartray system tray screenshot',
    accentColor: 'green',
    images: [
      { src: '/images/thumbs/gartray1.png', alt: 'gartray system tray - icon view' },
      { src: '/images/thumbs/gartray2.png', alt: 'gartray quick settings panel' },
      { src: '/images/thumbs/gartray3.png', alt: 'gartray volume controls' },
      { src: '/images/thumbs/gartray4.png', alt: 'gartray network settings' }
    ]
  },
  {
    id: 'garbg',
    name: 'garbg',
    tagline: 'Wallpaper Daemon',
    description: 'A multi-source wallpaper daemon with caching and animation support. Load backgrounds from local files, HTTP, or S3.',
    features: [
      'Local, HTTP, and S3 sources',
      'LRU cache with blake3 hashing',
      'Animated GIF/WebP support',
      'Optional video playback (ffmpeg)',
      'Systemd user service integration'
    ],
    status: 'stable' as const,
    imagePosition: 'left' as const,
    imageAlt: 'garbg wallpaper daemon screenshot',
    accentColor: 'magenta'
  },
  {
    id: 'garlock',
    name: 'garlock',
    tagline: 'Screen Locker',
    description: 'A PAM-authenticated screen locker with secure input handling. Features background blur and status indicators.',
    features: [
      'PAM authentication',
      'Secure password handling (zeroize)',
      'Configurable background blur',
      'Caps lock and time indicators',
      'Grace period support'
    ],
    status: 'stable' as const,
    imagePosition: 'right' as const,
    imageAlt: 'garlock screen locker screenshot',
    accentColor: 'orange'
  },
  {
    id: 'gardm',
    name: 'gardm',
    tagline: 'Display Manager',
    description: 'A system-level display manager with a graphical greeter. Manages login sessions and user switching.',
    features: [
      'Graphical greeter UI',
      'PAM-based authentication',
      'Session management',
      'Multi-user support',
      'Systemd service integration'
    ],
    status: 'beta' as const,
    imagePosition: 'left' as const,
    imageAlt: 'gardm display manager screenshot',
    accentColor: 'cyan'
  },
  {
    id: 'garlaunch',
    name: 'garlaunch',
    tagline: 'Application Launcher',
    description: 'A rofi-like application launcher with fuzzy search. Browse .desktop entries, run commands, switch windows, or execute custom scripts.',
    features: [
      'Fuzzy search with nucleo',
      'Desktop entry mode (drun)',
      'Command execution mode (run)',
      'Window switcher mode',
      'Custom script mode with JSON protocol'
    ],
    status: 'beta' as const,
    imagePosition: 'right' as const,
    imageAlt: 'garlaunch application launcher screenshot',
    accentColor: 'magenta',
    images: [
      { src: '/images/thumbs/garlaunch1.png', alt: 'garlaunch application launcher - main view' },
      { src: '/images/thumbs/garlaunch2.png', alt: 'garlaunch launcher - search results' },
      { src: '/images/thumbs/garlaunch3.png', alt: 'garlaunch launcher - window switcher mode' },
      { src: '/images/thumbs/garlaunch4.png', alt: 'garlaunch launcher - drun mode' }
    ]
  },
  {
    id: 'gartk',
    name: 'gartk',
    tagline: 'UI Toolkit',
    description: 'A shared UI toolkit library used by gardesk components. Provides X11 window management, Cairo/Pango rendering, and theming.',
    features: [
      'X11 connection and window management',
      'Cairo/Pango text and shape rendering',
      'Built-in dark, light, and high-contrast themes',
      'Monitor detection with RandR',
      'Keyboard and pointer grabbing'
    ],
    status: 'beta' as const,
    imagePosition: 'left' as const,
    imageAlt: 'gartk toolkit diagram',
    accentColor: 'cyan'
  },
  {
    id: 'garclip',
    name: 'garclip',
    tagline: 'Clipboard Manager',
    description: 'An X11 clipboard manager with persistent history. Monitors CLIPBOARD and PRIMARY selections, supports text and images, with XFixes event-driven detection.',
    features: [
      'Text and image history with persistence',
      'XFixes event-driven clipboard monitoring',
      'Regex and window class filtering',
      'garclip-picker UI with fuzzy search',
      'Systemd user service integration'
    ],
    status: 'beta' as const,
    imagePosition: 'right' as const,
    imageAlt: 'garclip clipboard manager screenshot',
    accentColor: 'yellow'
  },
  {
    id: 'garshot',
    name: 'garshot',
    tagline: 'Screenshot Utility',
    description: 'A fast X11 screenshot tool with interactive region selection, built-in annotation editor, and multiple output formats.',
    features: [
      'MIT-SHM for fast captures (~50ms)',
      'Built-in annotation editor with 8 tools',
      'Interactive region selection with blur',
      'Color picker with HSV, RGB, and eyedropper',
      'PNG, JPEG, WebP output formats'
    ],
    status: 'stable' as const,
    imagePosition: 'left' as const,
    imageAlt: 'garshot screenshot utility',
    accentColor: 'yellow',
    images: [
      { src: '/images/thumbs/garshot1.png', alt: 'garshot screenshot with annotation editor' },
      { src: '/images/thumbs/garshot2.png', alt: 'garshot region selection with blur' },
      { src: '/images/thumbs/garshot3.png', alt: 'garshot annotation tools' },
      { src: '/images/thumbs/garshot4.png', alt: 'garshot color picker' }
    ]
  }
];
---

<BaseLayout>
  <Header />

  <main>
    <HeroSection />
    <FeaturesSection />

    {components.map(function(component) {
      return (<ComponentSection {...component} />)
    })}

    <InstallSection />
  </main>

  <Footer />
</BaseLayout>
