---
interface Props {
  title: string;
  description: string;
  icon: string;
  accentColor?: string;
}

const { title, description, icon, accentColor = 'blue' } = Astro.props;

const colorClasses: Record<string, string> = {
  blue: 'text-gar-accent-blue border-gar-accent-blue/20 hover:border-gar-accent-blue/40',
  green: 'text-gar-accent-green border-gar-accent-green/20 hover:border-gar-accent-green/40',
  magenta: 'text-gar-accent-magenta border-gar-accent-magenta/20 hover:border-gar-accent-magenta/40',
  orange: 'text-gar-accent-orange border-gar-accent-orange/20 hover:border-gar-accent-orange/40',
};
---

<div class:list={[
  'feature-card p-6 rounded-xl bg-gar-bg-secondary/50 border transition-all duration-300 hover:bg-gar-bg-secondary',
  colorClasses[accentColor]
]}>
  <div class="mb-4" set:html={icon} />
  <h3 class="text-lg font-semibold text-gar-text-primary mb-2">{title}</h3>
  <p class="text-sm text-gar-text-secondary leading-relaxed">{description}</p>
</div>
