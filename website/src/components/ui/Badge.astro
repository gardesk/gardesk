---
interface Props {
  status: 'stable' | 'beta' | 'coming-soon';
  class?: string;
}

const { status, class: className = '' } = Astro.props;

const statusConfig = {
  'stable': {
    label: 'Stable',
    class: 'bg-gar-accent-green/10 text-gar-accent-green border-gar-accent-green/30'
  },
  'beta': {
    label: 'Beta',
    class: 'bg-gar-accent-yellow/10 text-gar-accent-yellow border-gar-accent-yellow/30'
  },
  'coming-soon': {
    label: 'Coming Soon',
    class: 'bg-gar-accent-magenta/10 text-gar-accent-magenta border-gar-accent-magenta/30'
  }
};

const config = statusConfig[status];
---

<span class:list={['inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border', config.class, className]}>
  {config.label}
</span>
