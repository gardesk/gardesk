---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { href, variant = 'primary', size = 'md', class: className = '' } = Astro.props;

const baseClasses = 'inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gar-bg-deep';

const variantClasses = {
  primary: 'bg-gar-accent-blue text-gar-bg-deep hover:bg-gar-accent-blue/90 focus:ring-gar-accent-blue',
  secondary: 'border border-gar-text-muted/30 text-gar-text-primary hover:bg-gar-bg-tertiary hover:border-gar-text-muted/50 focus:ring-gar-text-muted',
  ghost: 'text-gar-text-secondary hover:text-gar-text-primary hover:bg-gar-bg-secondary focus:ring-gar-text-muted'
};

const sizeClasses = {
  sm: 'px-3 py-1.5 text-sm gap-1.5',
  md: 'px-5 py-2.5 text-base gap-2',
  lg: 'px-7 py-3 text-lg gap-2.5'
};

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], className];

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={classes}>
  <slot />
</Tag>
