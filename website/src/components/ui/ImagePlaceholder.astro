---
interface Props {
  width?: number;
  height?: number;
  alt: string;
  class?: string;
}

const { width = 800, height = 500, alt, class: className = '' } = Astro.props;
const aspectRatio = `${width} / ${height}`;
---

<div
  class:list={[
    'image-placeholder relative rounded-lg overflow-hidden border border-gar-text-muted/20 bg-gar-bg-secondary',
    className
  ]}
  style={`aspect-ratio: ${aspectRatio};`}
>
  <!-- Grid pattern background -->
  <div class="absolute inset-0 opacity-10">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5" class="text-gar-text-muted" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>
  </div>

  <!-- Center content -->
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-gar-text-secondary">
    <svg class="w-12 h-12 opacity-50" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
    </svg>
    <span class="text-sm font-mono">{alt}</span>
    <span class="text-xs opacity-60">{width} × {height}</span>
  </div>

  <!-- Corner accents -->
  <div class="absolute top-0 left-0 w-6 h-6 border-t-2 border-l-2 border-gar-accent-blue/30 rounded-tl"></div>
  <div class="absolute top-0 right-0 w-6 h-6 border-t-2 border-r-2 border-gar-accent-blue/30 rounded-tr"></div>
  <div class="absolute bottom-0 left-0 w-6 h-6 border-b-2 border-l-2 border-gar-accent-blue/30 rounded-bl"></div>
  <div class="absolute bottom-0 right-0 w-6 h-6 border-b-2 border-r-2 border-gar-accent-blue/30 rounded-br"></div>
</div>
