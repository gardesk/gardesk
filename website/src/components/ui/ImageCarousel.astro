---
interface Props {
  images: { src: string; alt: string }[];
  class?: string;
}

const { images, class: className } = Astro.props;
const carouselId = `carousel-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={['relative group', className]} data-carousel={carouselId}>
  <!-- Images container -->
  <div class="relative overflow-hidden rounded-lg border border-gar-text-muted/20 bg-gar-bg-secondary">
    <div class="carousel-track flex transition-transform duration-500 ease-out">
      {images.map((image, index) => (
        <div class="carousel-slide w-full flex-shrink-0">
          <img
            src={image.src}
            alt={image.alt}
            class="w-full h-auto"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Navigation arrows -->
  {images.length > 1 && (
    <>
      <button
        type="button"
        class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 p-2 rounded-full bg-gar-bg-primary/80 border border-gar-text-muted/20 text-gar-text-secondary hover:text-gar-text-primary hover:bg-gar-bg-secondary transition-all opacity-0 group-hover:opacity-100"
        aria-label="Previous image"
      >
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        type="button"
        class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 p-2 rounded-full bg-gar-bg-primary/80 border border-gar-text-muted/20 text-gar-text-secondary hover:text-gar-text-primary hover:bg-gar-bg-secondary transition-all opacity-0 group-hover:opacity-100"
        aria-label="Next image"
      >
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </>
  )}

  <!-- Dots indicator -->
  {images.length > 1 && (
    <div class="carousel-dots flex justify-center gap-2 mt-4">
      {images.map((_, index) => (
        <button
          type="button"
          class:list={[
            'carousel-dot w-2 h-2 rounded-full transition-all',
            index === 0 ? 'bg-gar-accent-blue w-6' : 'bg-gar-text-muted/40 hover:bg-gar-text-muted'
          ]}
          data-index={index}
          aria-label={`Go to image ${index + 1}`}
        />
      ))}
    </div>
  )}
</div>

<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector('.carousel-track') as HTMLElement;
    const slides = carousel.querySelectorAll('.carousel-slide');
    const prevBtn = carousel.querySelector('.carousel-prev');
    const nextBtn = carousel.querySelector('.carousel-next');
    const dots = carousel.querySelectorAll('.carousel-dot');

    let currentIndex = 0;
    const totalSlides = slides.length;

    function goToSlide(index: number) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;

      currentIndex = index;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.add('bg-gar-accent-blue', 'w-6');
          dot.classList.remove('bg-gar-text-muted/40');
        } else {
          dot.classList.remove('bg-gar-accent-blue', 'w-6');
          dot.classList.add('bg-gar-text-muted/40');
        }
      });
    }

    prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt((dot as HTMLElement).dataset.index || '0', 10);
        goToSlide(index);
      });
    });

    // Keyboard navigation
    carousel.addEventListener('keydown', (e: Event) => {
      const event = e as KeyboardEvent;
      if (event.key === 'ArrowLeft') goToSlide(currentIndex - 1);
      if (event.key === 'ArrowRight') goToSlide(currentIndex + 1);
    });
  });
</script>
