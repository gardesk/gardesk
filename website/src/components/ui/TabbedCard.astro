---
interface Tab {
  id: string;
  label: string;
  icon?: string;
}

interface Props {
  tabs: Tab[];
  defaultTab?: string;
  class?: string;
}

const { tabs, defaultTab, class: className } = Astro.props;
const activeTab = defaultTab || tabs[0]?.id;
---

<div class:list={["tabbed-card rounded-xl border border-gar-text-muted/20 bg-gar-bg-secondary/30 overflow-hidden", className]} data-active-tab={activeTab}>
  <!-- Tab Header -->
  <div class="tab-header flex border-b border-gar-text-muted/20 bg-gar-bg-secondary/50 overflow-x-auto">
    {tabs.map(function(tab) {
      return (
        <button
          class:list={[
            "tab-button px-6 py-3 text-sm font-medium transition-all duration-200 whitespace-nowrap",
            "hover:bg-gar-bg-primary/50 hover:text-gar-text-primary",
            "border-b-2 -mb-[2px]",
            tab.id === activeTab
              ? "text-gar-accent-blue border-gar-accent-blue bg-gar-bg-primary/30"
              : "text-gar-text-secondary border-transparent"
          ]}
          data-tab={tab.id}
          aria-selected={tab.id === activeTab}
          role="tab"
        >
          {tab.icon && <span class="mr-2">{tab.icon}</span>}
          {tab.label}
        </button>
      )
    })}
  </div>

  <!-- Tab Content - Use named slots -->
  <div class="tab-content">
    <div class:list={["tab-panel p-6", tabs[0]?.id === activeTab ? "block" : "hidden"]} data-tab-panel={tabs[0]?.id} role="tabpanel">
      <slot name="tab-0" />
    </div>
    {tabs[1] && (
      <div class:list={["tab-panel p-6", tabs[1].id === activeTab ? "block" : "hidden"]} data-tab-panel={tabs[1].id} role="tabpanel">
        <slot name="tab-1" />
      </div>
    )}
    {tabs[2] && (
      <div class:list={["tab-panel p-6", tabs[2].id === activeTab ? "block" : "hidden"]} data-tab-panel={tabs[2].id} role="tabpanel">
        <slot name="tab-2" />
      </div>
    )}
    {tabs[3] && (
      <div class:list={["tab-panel p-6", tabs[3].id === activeTab ? "block" : "hidden"]} data-tab-panel={tabs[3].id} role="tabpanel">
        <slot name="tab-3" />
      </div>
    )}
    {tabs[4] && (
      <div class:list={["tab-panel p-6", tabs[4].id === activeTab ? "block" : "hidden"]} data-tab-panel={tabs[4].id} role="tabpanel">
        <slot name="tab-4" />
      </div>
    )}
    {tabs[5] && (
      <div class:list={["tab-panel p-6", tabs[5].id === activeTab ? "block" : "hidden"]} data-tab-panel={tabs[5].id} role="tabpanel">
        <slot name="tab-5" />
      </div>
    )}
    {tabs[6] && (
      <div class:list={["tab-panel p-6", tabs[6].id === activeTab ? "block" : "hidden"]} data-tab-panel={tabs[6].id} role="tabpanel">
        <slot name="tab-6" />
      </div>
    )}
    {tabs[7] && (
      <div class:list={["tab-panel p-6", tabs[7].id === activeTab ? "block" : "hidden"]} data-tab-panel={tabs[7].id} role="tabpanel">
        <slot name="tab-7" />
      </div>
    )}
  </div>
</div>

<script>
  function initTabbedCards() {
    document.querySelectorAll('.tabbed-card').forEach((card) => {
      const buttons = card.querySelectorAll('.tab-button');
      const panels = card.querySelectorAll('.tab-panel');

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const tabId = button.getAttribute('data-tab');

          // Update buttons
          buttons.forEach((btn) => {
            const isActive = btn.getAttribute('data-tab') === tabId;
            btn.setAttribute('aria-selected', String(isActive));
            btn.classList.toggle('text-gar-accent-blue', isActive);
            btn.classList.toggle('border-gar-accent-blue', isActive);
            btn.classList.toggle('bg-gar-bg-primary/30', isActive);
            btn.classList.toggle('text-gar-text-secondary', !isActive);
            btn.classList.toggle('border-transparent', !isActive);
          });

          // Update panels
          panels.forEach((panel) => {
            const isActive = panel.getAttribute('data-tab-panel') === tabId;
            panel.classList.toggle('hidden', !isActive);
            panel.classList.toggle('block', isActive);
            panel.setAttribute('aria-hidden', String(!isActive));
          });

          // Update card data attribute
          card.setAttribute('data-active-tab', tabId || '');
        });
      });
    });
  }

  // Initialize on page load
  initTabbedCards();

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initTabbedCards);
</script>
