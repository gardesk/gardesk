---

<section id="features" class="snap-section relative flex items-center justify-center py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gar-text-primary mb-4">
        Built for power users
      </h2>
      <p class="text-lg text-gar-text-secondary max-w-2xl mx-auto">
        A lightweight desktop environment with sensible defaults and full configurability.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map(function(feature) {
        return (<FeatureCard {...feature} />)
      })}
    </div>
  </div>
</section>
