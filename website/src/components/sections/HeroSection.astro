---
import Terminal from '../ui/Terminal.astro';
import Button from '../ui/Button.astro';
---

<section id="hero" class="snap-section relative flex items-center justify-center overflow-hidden">
  <!-- Background image with overlay -->
  <div class="absolute inset-0">
    <img
      src="/images/gar1.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-gar-bg-deep/80 via-gar-bg-primary/70 to-gar-bg-deep/90"></div>
  </div>

  <!-- Atmospheric overlay (parallax layer) -->
  <div class="parallax-bg absolute inset-0 opacity-20" data-parallax="bg">
    <div class="absolute inset-0 bg-gradient-to-br from-gar-atmosphere-dark/40 via-transparent to-gar-accent-blue/10"></div>
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-gar-accent-blue/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-gar-accent-magenta/5 rounded-full blur-3xl"></div>
  </div>

  <!-- Grid pattern -->
  <div class="absolute inset-0 opacity-5">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="0.5" class="text-gar-text-muted" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)" />
    </svg>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
    <!-- Logo / Title -->
    <div class="mb-8">
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-4">
        <span class="text-gar-text-primary">gar</span><span class="text-gar-accent-blue">desk</span>
      </h1>
      <p class="text-xl md:text-2xl text-gar-text-secondary font-light">
        A modular X11 desktop environment suite
      </p>
    </div>

    <!-- Tagline -->
    <p class="text-lg text-gar-text-secondary mb-10 max-w-2xl mx-auto">
      New on the scene and in active development. Written in Rust. Configured in Lua. Built for power users.
    </p>

    <!-- Install command -->
    <div class="max-w-2xl mx-auto mb-10">
      <Terminal
        command="curl -fsSL https://gar.dev/install.sh | bash"
        class="glow-blue"
      />
    </div>

    <!-- CTA buttons -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <Button href="#install" variant="primary" size="lg">
        Get Started
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </Button>
      <Button href="https://github.com/gardesk/gardesk" variant="secondary" size="lg">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        View on GitHub
      </Button>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <a href="#features" class="flex flex-col items-center gap-2 text-gar-text-secondary hover:text-gar-text-primary transition-colors" aria-label="Scroll to features">
      <span class="text-xs uppercase tracking-widest">Scroll</span>
      <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
