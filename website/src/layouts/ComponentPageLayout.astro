---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Terminal from '../components/ui/Terminal.astro';
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';

interface Props {
  name: string;
  tagline: string;
  description: string;
  status: 'stable' | 'beta' | 'coming-soon';
  accentColor: string;
  features: string[];
  installCommand?: string;
  configExample?: string;
  configLanguage?: string;
  githubUrl: string;
}

const {
  name,
  tagline,
  description,
  status,
  accentColor,
  features,
  installCommand,
  configExample,
  configLanguage = 'lua',
  githubUrl
} = Astro.props;

const accentClasses: Record<string, string> = {
  blue: 'text-gar-accent-blue',
  green: 'text-gar-accent-green',
  magenta: 'text-gar-accent-magenta',
  orange: 'text-gar-accent-orange',
  cyan: 'text-gar-accent-cyan',
  yellow: 'text-gar-accent-yellow',
};
---

<BaseLayout title={`${name} - gardesk`} description={`${tagline}. ${description}`}>
  <Header />

  <main class="pt-24 pb-20 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Hero -->
      <div class="mb-12">
        <Badge status={status} class="mb-4" />
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <span class={accentClasses[accentColor]}>{name}</span>
        </h1>
        <p class="text-xl text-gar-text-secondary mb-6">{tagline}</p>
        <p class="text-gar-text-secondary leading-relaxed mb-8">{description}</p>

        <div class="flex flex-wrap gap-4">
          <Button href={githubUrl} variant="primary">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </Button>
          <Button href="/#install" variant="secondary">
            Install
          </Button>
        </div>
      </div>

      <!-- Screenshot placeholder -->
      <div class="mb-12">
        <ImagePlaceholder
          alt={`${name} screenshot`}
          width={1200}
          height={700}
          class="w-full"
        />
      </div>

      <!-- Features -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {features.map(feature => (
            <li class="flex items-start gap-3 p-4 rounded-lg bg-gar-bg-secondary/50 border border-gar-text-muted/10">
              <svg class:list={['w-5 h-5 mt-0.5 flex-shrink-0', accentClasses[accentColor]]} xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gar-text-primary">{feature}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Installation -->
      {installCommand && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Installation</h2>
          <Terminal command={installCommand} />
          <p class="mt-4 text-sm text-gar-text-secondary">
            Or use the <a href="/#install" class="text-gar-accent-blue hover:underline">universal installer</a> to install all components.
          </p>
        </section>
      )}

      <!-- Configuration example -->
      {configExample && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-gar-text-primary mb-6">Configuration</h2>
          <div class="rounded-lg overflow-hidden border border-gar-text-muted/20">
            <div class="px-4 py-2 bg-gar-bg-secondary border-b border-gar-text-muted/20">
              <span class="text-sm text-gar-text-secondary font-mono">
                {configLanguage === 'lua' ? 'init.lua' : 'config.toml'}
              </span>
            </div>
            <pre class="bg-gar-bg-primary p-4 overflow-x-auto"><code class="text-sm text-gar-text-primary font-mono">{configExample}</code></pre>
          </div>
        </section>
      )}

      <!-- Additional content slot -->
      <slot />

      <!-- Back link -->
      <div class="mt-12 pt-8 border-t border-gar-text-muted/10">
        <Button href="/" variant="ghost">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to home
        </Button>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
